          onUnlockAdmin={handleUnlockAdmin}
          onSwitchMode={handleSwitchMode}
          onSignOut={async () => {
            await supabase.auth.signOut();
            setProfile(null);
            setSessionUserId(null);
            setRoleMode('member');
          }}
          onOpenNewClaim={() => setIsClaimModalOpen(true)}
          onOpenQrScanner={() => setIsQrScannerOpen(true)}
          onOpenNewActivity={
