          profile,
          'Finance',
          entryType === 'IN' ? 'Added Money In' : 'Recorded Expense Out',
          `${profile.full_name} (${profile.matric_no}) recorded ${entryType === 'IN' ? 'Money In' : 'Expense Out'} "${title.trim()}" of RM ${num.toFixed(2)} (${finalEventName})`
