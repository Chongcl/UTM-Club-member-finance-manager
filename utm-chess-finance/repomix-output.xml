                    onChange={(e) => setPhoneNumber(e.target.value)}
                    placeholder="Phone *"
                    className="rounded-xl border border-slate-200 bg-slate-50/60 focus:bg-white px-3 py-2 font-mono"
                    required
                  />
                </div>
              </>
            )}
            <input
