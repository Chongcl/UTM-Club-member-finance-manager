              onClick={() => setAuthMode('signup')}
              className={`py-2 text-xs font-bold rounded-xl transition cursor-pointer ${authMode === 'signup' ? 'bg-emerald-600 text-white shadow-xs' : 'text-slate-600 hover:text-emerald-800'}`}
            >
              Register
