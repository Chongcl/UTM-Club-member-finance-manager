<file path="src/components/ClaimFormModal.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import {
  supabase,
  Budget,
  UserProfile,
  DEFAULT_DEPARTMENTS,
  MAX_FILE_SIZE_BYTES,
} from '@/lib/supabase';
import ReceiptDropzone, { ScannedReceiptData } from './ReceiptDropzone';
import { X, CheckCircle2, AlertCircle, Loader2, Sparkles, Landmark, Eye, EyeOff } from 'lucide-react';

interface ClaimFormModalProps {
  isOpen: boolean;
  onClose: () => void;
  budgets: Budget[];
  departments?: string[];
  profile: UserProfile;
  onSuccess: (message: string) => void;
}

export default function ClaimFormModal({
  isOpen,
  onClose,
  budgets,
  departments = DEFAULT_DEPARTMENTS,
  profile,
  onSuccess,
}: ClaimFormModalProps) {
  const [selectedEventOption, setSelectedEventOption] = useState<string>(
    budgets[0]?.id || 'OTHER'
  );
  const [customEventName, setCustomEventName] = useState('');
  const [title, setTitle] = useState('');
  const [category, setCategory] = useState<string>(departments[0] || 'Member');
  const [amount, setAmount] = useState('');
  const [expenseDate, setExpenseDate] = useState(
    new Date().toISOString().split('T')[0]
  );
  const [merchantName, setMerchantName] = useState('');
  const [description, setDescription] = useState('');
  const [includePaymentDetails, setIncludePaymentDetails] = useState(true);
  const [bankName, setBankName] = useState('');
  const [bankAccountNo, setBankAccountNo] = useState('');
  const [bankAccountHolder, setBankAccountHolder] = useState('');
  const [claimantQrUrl, setClaimantQrUrl] = useState('');
  const [claimantQrFile, setClaimantQrFile] = useState<File | null>(null);
  const [file, setFile] = useState<File | null>(null);
  const [scannedData, setScannedData] = useState<ScannedReceiptData | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  useEffect(() => {
    if (!isOpen) return;
    let savedBank = {
      bank_name: profile.bank_name || '',
      bank_account_no: profile.bank_account_no || '',
      bank_account_holder: profile.bank_account_holder || profile.full_name || '',
      bank_qr_url: profile.bank_qr_url || '',
    };
    if (typeof window !== 'undefined') {
      const raw = localStorage.getItem(`clubsync_bank_${profile.id}`);
      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          savedBank = {
            bank_name: profile.bank_name || parsed.bank_name || '',
            bank_account_no: profile.bank_account_no || parsed.bank_account_no || '',
            bank_account_holder:
              profile.bank_account_holder || parsed.bank_account_holder || profile.full_name || '',
            bank_qr_url: profile.bank_qr_url || parsed.bank_qr_url || '',
          };
        } catch {
          /* ignore */
        }
      }
    }
    setBankName(savedBank.bank_name);
    setBankAccountNo(savedBank.bank_account_no);
    setBankAccountHolder(savedBank.bank_account_holder);
    setClaimantQrUrl(savedBank.bank_qr_url);
    setClaimantQrFile(null);
  }, [isOpen, profile]);

  if (!isOpen) return null;

  const handleScanComplete = (data: ScannedReceiptData) => {
    setScannedData(data);
    setAmount(data.amount.toFixed(2));
    setMerchantName(data.merchant);
    setExpenseDate(data.date);
    setCategory(data.suggestedCategory);
    if (!title) setTitle(`${data.merchant} Purchase`);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMsg(null);
    if (!file) {
      setErrorMsg('Please attach your receipt or PDF invoice.');
      return;
    }
    if (file.size > MAX_FILE_SIZE_BYTES) {
      setErrorMsg('File size must be under 50 MB.');
      return;
    }

    const numericAmount = parseFloat(amount);
    if (isNaN(numericAmount) || numericAmount <= 0) {
      setErrorMsg('Please enter a valid amount.');
      return;
    }

    setSubmitting(true);
    try {
      let finalClaimantQr = includePaymentDetails ? claimantQrUrl.trim() : '';
      if (includePaymentDetails && claimantQrFile && claimantQrFile.size <= MAX_FILE_SIZE_BYTES) {
        const qrExt = claimantQrFile.name.split('.').pop() || 'png';
        const qrPath = `member-qr/${profile.id}-${Date.now()}.${qrExt}`;
        const { error: qrErr } = await supabase.storage.from('receipts').upload(qrPath, claimantQrFile);
        if (!qrErr) {
          finalClaimantQr = supabase.storage.from('receipts').getPublicUrl(qrPath).data.publicUrl;
        }
      }

      const paymentSummary =
        includePaymentDetails && bankAccountNo.trim()
          ? `${bankName.trim() || 'Bank/DuitNow'} • ${bankAccountNo.trim()} (${bankAccountHolder.trim() || profile.full_name})`
          : '';

      if (typeof window !== 'undefined' && includePaymentDetails) {
        localStorage.setItem(
          `clubsync_bank_${profile.id}`,
          JSON.stringify({
            bank_name: bankName.trim(),
            bank_account_no: bankAccountNo.trim(),
            bank_account_holder: bankAccountHolder.trim() || profile.full_name,
            bank_qr_url: finalClaimantQr,
          })
        );
      }

      const fileExt = file.name.split('.').pop() || 'pdf';
      const safePath = `claims/${profile.id}/${Date.now()}.${fileExt}`;

      const { error: uploadErr } = await supabase.storage
        .from('receipts')
        .upload(safePath, file, { upsert: false });
      if (uploadErr) throw uploadErr;

      const { data: urlData } = supabase.storage
        .from('receipts')
        .getPublicUrl(safePath);

      const isOther = selectedEventOption === 'OTHER';
      const chosenBudget = budgets.find((b) => b.id === selectedEventOption);
      const eventLabel = isOther
        ? customEventName.trim() || 'General Club Expense'
        : chosenBudget?.event_name || '';

      const baseDescription = `[Event: ${eventLabel}] ${description.trim()}${
        paymentSummary ? ` | Reimburse To: ${paymentSummary}` : ''
      }`;

      const corePayload = {
        user_id: profile.id,
        claimant_name: profile.full_name,
        matric_no: profile.matric_no,
        phone_number: profile.phone_number,
        budget_id: isOther ? null : selectedEventOption,
        title: title.trim(),
        category,
        amount: numericAmount,
        expense_date: expenseDate,
        merchant_name: merchantName.trim(),
        description: baseDescription,
        receipt_url: urlData.publicUrl,
        receipt_file_name: file.name,
        ai_extracted_amount: scannedData?.amount ?? null,
        ai_extracted_merchant: scannedData?.merchant ?? null,
        ai_extracted_date: scannedData?.date ?? null,
        ai_confidence: scannedData?.confidence ?? null,
        status: 'Pending',
      };

      const { data: inserted, error: insertErr } = await supabase
        .from('claims')
        .insert({
          ...corePayload,
          payment_info: paymentSummary,
          claimant_qr_url: finalClaimantQr,
        })
        .select('id')
        .maybeSingle();

      if (insertErr) {
        const { data: fbInserted, error: fallbackErr } = await supabase
          .from('claims')
          .insert(corePayload)
          .select('id')
          .maybeSingle();
        if (fallbackErr) throw fallbackErr;
        if (fbInserted?.id && finalClaimantQr && typeof window !== 'undefined') {
          localStorage.setItem(`clubsync_claimant_qr_${fbInserted.id}`, finalClaimantQr);
        }
      } else if (inserted?.id && finalClaimantQr && typeof window !== 'undefined') {
        localStorage.setItem(`clubsync_claimant_qr_${inserted.id}`, finalClaimantQr);
      }

      onSuccess('Claim submitted!');
      onClose();
    } catch (err: unknown) {
      setErrorMsg(err instanceof Error ? err.message : 'Submission failed.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white rounded-3xl shadow-2xl border border-emerald-200 max-w-2xl w-full overflow-hidden my-8">
        <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
          <div>
            <h2 className="text-base font-bold">Submit Reimbursement Claim</h2>
            <p className="text-xs text-emerald-200">
              {profile.full_name} ({profile.matric_no}) • Max 50MB
            </p>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-emerald-200 hover:text-white cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <form
          onSubmit={handleSubmit}
          className="p-6 space-y-4 max-h-[82vh] overflow-y-auto"
        >
          <ReceiptDropzone
            selectedFile={file}
            onFileSelect={(f) => {
              setFile(f);
              if (!f) setScannedData(null);
            }}
            onScanComplete={handleScanComplete}
          />

          {scannedData && (
            <div className="bg-emerald-50 border border-emerald-200 rounded-xl p-2.5 flex items-center justify-between text-xs text-emerald-900">
              <span className="font-semibold flex items-center gap-1.5">
                <Sparkles className="w-4 h-4 text-emerald-700" />
                Auto-filled from receipt ({scannedData.confidence}% match)
              </span>
            </div>
          )}

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div className="sm:col-span-2">
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Activity / Event *
              </label>
              <select
                value={selectedEventOption}
                onChange={(e) => setSelectedEventOption(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm text-slate-900"
              >
                {budgets.map((b) => (
                  <option key={b.id} value={b.id}>
                    {b.event_name} ({b.event_date})
                  </option>
                ))}
                <option value="OTHER">Other (Type Custom Event Below)</option>
              </select>
            </div>

            {selectedEventOption === 'OTHER' && (
              <div className="sm:col-span-2">
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Custom Event / Purpose Name *
                </label>
                <input
                  type="text"
                  value={customEventName}
                  onChange={(e) => setCustomEventName(e.target.value)}
                  placeholder="e.g., Committee Meeting Refreshments / Equipment Repair"
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              </div>
            )}

            <div className="sm:col-span-2">
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Expense Title *
              </label>
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="e.g., Mineral Water & Bread"
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                required
              />
            </div>

            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Department / Unit *
              </label>
              <select
                value={category}
                onChange={(e) => setCategory(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm"
              >
                {departments.map((c) => (
                  <option key={c} value={c}>
                    {c}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Amount (RM) *
              </label>
              <input
                type="number"
                step="0.01"
                value={amount}
                onChange={(e) => setAmount(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-bold"
                required
              />
            </div>

            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Shop / Merchant *
              </label>
              <input
                type="text"
                value={merchantName}
                onChange={(e) => setMerchantName(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                required
              />
            </div>

            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Receipt Date *
              </label>
              <input
                type="date"
                value={expenseDate}
                onChange={(e) => setExpenseDate(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                required
              />
            </div>

            <div className="sm:col-span-2 p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-200 space-y-2.5">
              <div className="flex items-center justify-between">
                <span className="text-xs font-extrabold text-emerald-950 flex items-center gap-1.5">
                  <Landmark className="w-4 h-4 text-emerald-700" />
                  <span>My Reimbursement Bank / DuitNow QR (Displayed to Admin)</span>
                </span>
                <button
                  type="button"
                  onClick={() => setIncludePaymentDetails(!includePaymentDetails)}
                  className={`px-2.5 py-1 rounded-lg text-[11px] font-bold flex items-center gap-1 cursor-pointer ${
                    includePaymentDetails ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-700'
                  }`}
                >
                  {includePaymentDetails ? <Eye className="w-3 h-3" /> : <EyeOff className="w-3 h-3" />}
                  <span>{includePaymentDetails ? 'Shown to Admin' : 'Hidden / Skip'}</span>
                </button>
              </div>
              {includePaymentDetails && (
                <>
                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
                    <input
                      type="text"
                      value={bankName}
                      onChange={(e) => setBankName(e.target.value)}
                      placeholder="Bank / eWallet (e.g., Maybank, TNG)"
                      className="rounded-xl border border-emerald-300 bg-white px-3 py-2 font-semibold"
                    />
                    <input
                      type="text"
                      value={bankAccountNo}
                      onChange={(e) => setBankAccountNo(e.target.value)}
                      placeholder="Account No / DuitNow Phone"
                      className="rounded-xl border border-emerald-300 bg-white px-3 py-2 font-mono font-bold"
                    />
                    <input
                      type="text"
                      value={bankAccountHolder}
                      onChange={(e) => setBankAccountHolder(e.target.value)}
                      placeholder="Account Holder Name"
                      className="rounded-xl border border-emerald-300 bg-white px-3 py-2 font-semibold"
                    />
                  </div>
                  <div className="pt-1 text-xs space-y-1.5">
                    <label className="block font-bold text-emerald-900">
                      Or Upload My Personal DuitNow / TNG QR (JPG, PNG, PDF — Optional)
                    </label>
                    <input
                      type="file"
                      accept="image/*,application/pdf"
                      onChange={(e) => setClaimantQrFile(e.target.files?.[0] || null)}
                      className="w-full text-xs file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-600 file:text-white cursor-pointer"
                    />
                    {claimantQrUrl && !claimantQrFile && (
                      <div className="flex items-center justify-between bg-white px-3 py-1.5 rounded-xl border text-[11px]">
                        <span className="text-emerald-800 font-bold">✓ Personal Payment QR attached from Profile</span>
                        <button type="button" onClick={() => setClaimantQrUrl('')} className="text-rose-600 font-bold cursor-pointer">
                          Remove
                        </button>
                      </div>
                    )}
                  </div>
                </>
              )}
            </div>

            <div className="sm:col-span-2">
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Notes
              </label>
              <textarea
                rows={2}
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
              />
            </div>
          </div>

          {errorMsg && (
            <div className="flex items-center gap-2 text-xs bg-red-50 text-red-700 px-3.5 py-2.5 rounded-xl border border-red-200">
              <AlertCircle className="w-4 h-4 shrink-0" />
              <span>{errorMsg}</span>
            </div>
          )}

          <div className="flex items-center justify-end gap-2.5 pt-2 border-t border-emerald-100">
            <button
              type="button"
              onClick={onClose}
              className="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={submitting}
              className="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer"
            >
              {submitting ? (
                <Loader2 className="w-4 h-4 animate-spin" />
              ) : (
                <CheckCircle2 className="w-4 h-4" />
              )}
              <span>{submitting ? 'Uploading...' : 'Submit'}</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/EquipmentSection.tsx">
'use client';

import React, { useState } from 'react';
import { supabase, EquipmentItem, EquipmentLoan, UserProfile } from '@/lib/supabase';
import { Package, PlusCircle, CheckCircle2, Clock, Trash2, X, Loader2, ArrowUpRight, RotateCcw, AlertTriangle, MessageCircle } from 'lucide-react';

interface EquipmentSectionProps {
  items: EquipmentItem[];
  loans: EquipmentLoan[];
  profile: UserProfile;
  isAdmin: boolean;
  onRefresh: (msg: string) => void;
}

function formatWhatsAppPhone(raw: string): string {
  const digits = (raw || '').replace(/\D/g, '');
  if (!digits) return '';
  if (digits.startsWith('0')) return `60${digits.slice(1)}`;
  if (digits.startsWith('60')) return digits;
  return `60${digits}`;
}

export default function EquipmentSection({ items, loans, profile, isAdmin, onRefresh }: EquipmentSectionProps) {
  const [showAddModal, setShowAddModal] = useState(false);
  const [itemName, setItemName] = useState('');
  const [category, setCategory] = useState('Sports / Chess Sets');
  const [totalQty, setTotalQty] = useState('10');
  const [location, setLocation] = useState('Club Storage Room');
  const [notes, setNotes] = useState('');
  const [savingItem, setSavingItem] = useState(false);

  const [borrowTarget, setBorrowTarget] = useState<EquipmentItem | null>(null);
  const [borrowQty, setBorrowQty] = useState('1');
  const [purpose, setPurpose] = useState('');
  const [returnDate, setReturnDate] = useState(
    new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0]
  );
  const [borrowing, setBorrowing] = useState(false);

  const todayStr = new Date().toISOString().split('T')[0];

  const isLoanOverdue = (loan: EquipmentLoan) => {
    if (loan.status === 'Returned') return false;
    if (loan.status === 'Overdue') return true;
    return Boolean(loan.return_date && loan.return_date < todayStr);
  };

  const overdueCount = loans.filter(isLoanOverdue).length;

  const buildWhatsAppReminderUrl = (loan: EquipmentLoan, overdue: boolean) => {
    const phone = formatWhatsAppPhone(loan.phone_number);
    const msg = overdue
      ? `Hi ${loan.borrower_name} (${loan.matric_no}), friendly reminder from ClubSync that the club equipment you borrowed (${loan.quantity}x ${loan.item_name}) was due for return on ${loan.return_date}. Please return it to the club storage room as soon as possible. Thank you!`
      : `Hi ${loan.borrower_name} (${loan.matric_no}), reminder from ClubSync regarding the club equipment you borrowed (${loan.quantity}x ${loan.item_name}, due date: ${loan.return_date}). Please let us know once returned. Thank you!`;
    return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
  };

  const handleAddItem = async (e: React.FormEvent) => {
    e.preventDefault();
    const qty = Math.max(1, parseInt(totalQty) || 1);
    setSavingItem(true);
    try {
      const { error } = await supabase.from('equipment_items').insert({
        item_name: itemName.trim(),
        category: category.trim(),
        total_quantity: qty,
        available_quantity: qty,
        location: location.trim(),
        notes: notes.trim(),
      });
      if (!error) {
        setItemName('');
        setNotes('');
        setShowAddModal(false);
        onRefresh(`Added "${itemName.trim()}" to inventory!`);
      }
    } finally {
      setSavingItem(false);
    }
  };

  const handleDeleteItem = async (item: EquipmentItem) => {
    await supabase.from('equipment_items').delete().eq('id', item.id);
    onRefresh(`Removed "${item.item_name}".`);
  };

  const handleBorrowSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!borrowTarget) return;
    const qty = Math.min(borrowTarget.available_quantity, Math.max(1, parseInt(borrowQty) || 1));
    setBorrowing(true);
    try {
      await supabase.from('equipment_loans').insert({
        item_id: borrowTarget.id,
        item_name: borrowTarget.item_name,
        user_id: profile.id,
        borrower_name: profile.full_name,
        matric_no: profile.matric_no,
        phone_number: profile.phone_number,
        quantity: qty,
        purpose: purpose.trim() || 'Club Activity',
        borrow_date: new Date().toISOString().split('T')[0],
        return_date: returnDate,
        status: 'Borrowed',
      });
      await supabase
        .from('equipment_items')
        .update({ available_quantity: Math.max(0, borrowTarget.available_quantity - qty) })
        .eq('id', borrowTarget.id);

      setBorrowTarget(null);
      setPurpose('');
      onRefresh(`Borrowed ${qty}x ${borrowTarget.item_name}!`);
    } finally {
      setBorrowing(false);
    }
  };

  const handleReturnLoan = async (loan: EquipmentLoan) => {
    await supabase
      .from('equipment_loans')
      .update({ status: 'Returned', returned_at: new Date().toISOString() })
      .eq('id', loan.id);

    const item = items.find((i) => i.id === loan.item_id);
    if (item) {
      await supabase
        .from('equipment_items')
        .update({
          available_quantity: Math.min(item.total_quantity, item.available_quantity + loan.quantity),
        })
        .eq('id', item.id);
    }
    onRefresh(`Returned ${loan.quantity}x ${loan.item_name}!`);
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-center justify-between gap-3 bg-white p-5 rounded-3xl border border-emerald-200 shadow-xs">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-2xl bg-emerald-700 text-white flex items-center justify-center">
            <Package className="w-5 h-5" />
          </div>
          <div>
            <h2 className="text-base font-extrabold text-emerald-950">Club Equipment &amp; Borrowing</h2>
            <p className="text-xs text-slate-500">Borrow club assets and track who holds each item</p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          {overdueCount > 0 && (
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-extrabold bg-rose-100 text-rose-800 border border-rose-300">
              <AlertTriangle className="w-4 h-4 text-rose-600" />
              <span>{overdueCount} Overdue Return{overdueCount > 1 ? 's' : ''}</span>
            </span>
          )}
          {isAdmin && (
            <button
              type="button"
              onClick={() => setShowAddModal(true)}
              className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer"
            >
              <PlusCircle className="w-4 h-4" />
              <span>+ Add Equipment</span>
            </button>
          )}
        </div>
      </div>

      {/* Equipment Cards */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        {items.length === 0 ? (
          <div className="md:col-span-3 bg-white rounded-3xl p-8 text-center border border-emerald-200 text-sm text-slate-400">
            No equipment registered yet.
          </div>
        ) : (
          items.map((item) => (
            <div key={item.id} className="bg-white rounded-3xl p-5 border border-emerald-200 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div className="flex items-start justify-between gap-2">
                  <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                    {item.category}
                  </span>
                  {isAdmin && (
                    <button
                      type="button"
                      onClick={() => handleDeleteItem(item)}
                      className="text-slate-400 hover:text-rose-600 cursor-pointer"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  )}
                </div>
                <h3 className="text-base font-extrabold text-slate-900 mt-2">{item.item_name}</h3>
                <p className="text-xs text-slate-500 mt-0.5">Location: {item.location}</p>
                {item.notes && <p className="text-xs text-slate-400 mt-1">{item.notes}</p>}
              </div>

              <div className="pt-3 border-t border-emerald-100 flex items-center justify-between">
                <div>
                  <span className="text-[11px] text-slate-400 block">Available</span>
                  <span className="text-lg font-extrabold text-emerald-700">
                    {item.available_quantity} <span className="text-xs text-slate-400">/ {item.total_quantity}</span>
                  </span>
                </div>
                <button
                  type="button"
                  disabled={item.available_quantity <= 0}
                  onClick={() => {
                    setBorrowTarget(item);
                    setBorrowQty('1');
                  }}
                  className="inline-flex items-center gap-1 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-200 text-white cursor-pointer"
                >
                  <ArrowUpRight className="w-3.5 h-3.5" />
                  <span>{item.available_quantity > 0 ? 'Borrow' : 'Out of Stock'}</span>
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      {/* Borrowing Log */}
      <div className="bg-white rounded-3xl border border-emerald-200 shadow-xs overflow-hidden">
        <div className="p-5 border-b border-emerald-100 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 className="text-sm font-extrabold text-emerald-950">Equipment Borrowing Log ({loans.length})</h3>
            <p className="text-xs text-slate-500">Overdue items are highlighted in red with 1-Click WhatsApp Reminder</p>
          </div>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="bg-emerald-50/70 text-[11px] font-bold uppercase text-emerald-900 border-b border-emerald-100">
                <th className="py-3 px-4">Item &amp; Qty</th>
                <th className="py-3 px-4">Borrower</th>
                <th className="py-3 px-4">Purpose</th>
                <th className="py-3 px-4">Dates</th>
                <th className="py-3 px-4">Status</th>
                <th className="py-3 px-4 text-right">Action / Reminder</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-emerald-100">
              {loans.map((loan) => {
                const overdue = isLoanOverdue(loan);
                return (
                  <tr
                    key={loan.id}
                    className={
                      overdue
                        ? 'bg-rose-50/90 hover:bg-rose-100/70 transition'
                        : 'hover:bg-emerald-50/30 transition'
                    }
                  >
                    <td className="py-3 px-4 font-bold text-slate-900">
                      {loan.item_name} <span className="text-emerald-700">x{loan.quantity}</span>
                    </td>
                    <td className="py-3 px-4">
                      <div className="font-semibold text-slate-800">{loan.borrower_name}</div>
                      <div className="text-[11px] text-slate-500 font-mono">
                        {loan.matric_no} • {loan.phone_number}
                      </div>
                    </td>
                    <td className="py-3 px-4 text-slate-600">{loan.purpose}</td>
                    <td className="py-3 px-4 font-mono text-[11px]">
                      <div>Out: {loan.borrow_date}</div>
                      <div className={overdue ? 'text-rose-700 font-extrabold' : 'text-slate-500'}>
                        Due: {loan.return_date}
                      </div>
                    </td>
                    <td className="py-3 px-4">
                      {loan.status === 'Returned' ? (
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">
                          <CheckCircle2 className="w-3 h-3" /> Returned
                        </span>
                      ) : overdue ? (
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-rose-600 text-white font-extrabold animate-pulse">
                          <AlertTriangle className="w-3 h-3" /> OVERDUE
                        </span>
                      ) : (
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 font-bold">
                          <Clock className="w-3 h-3" /> Borrowed
                        </span>
                      )}
                    </td>
                    <td className="py-3 px-4 text-right">
                      <div className="inline-flex flex-wrap items-center justify-end gap-1.5">
                        {loan.status !== 'Returned' && isAdmin && loan.phone_number && (
                          <a
                            href={buildWhatsAppReminderUrl(loan, overdue)}
                            target="_blank"
                            rel="noopener noreferrer"
                            className={`inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl font-bold text-[11px] shadow-2xs cursor-pointer ${
                              overdue
                                ? 'bg-rose-600 hover:bg-rose-500 text-white'
                                : 'bg-emerald-600 hover:bg-emerald-500 text-white'
                            }`}
                            title="Send 1-Click WhatsApp Return Reminder"
                          >
                            <MessageCircle className="w-3.5 h-3.5" />
                            <span>{overdue ? 'WhatsApp Overdue' : 'WhatsApp Ping'}</span>
                          </a>
                        )}
                        {loan.status !== 'Returned' && (isAdmin || loan.user_id === profile.id) && (
                          <button
                            type="button"
                            onClick={() => handleReturnLoan(loan)}
                            className="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold cursor-pointer"
                          >
                            <RotateCcw className="w-3 h-3" /> Mark Returned
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* Borrow Modal */}
      {borrowTarget && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4">
          <div className="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-emerald-200">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-sm font-bold">Borrow — {borrowTarget.item_name}</h3>
              <button type="button" onClick={() => setBorrowTarget(null)} className="cursor-pointer">
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleBorrowSubmit} className="p-6 space-y-3 text-xs">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">
                  Quantity (Max {borrowTarget.available_quantity}) *
                </label>
                <input
                  type="number"
                  min="1"
                  max={borrowTarget.available_quantity}
                  value={borrowQty}
                  onChange={(e) => setBorrowQty(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-bold"
                  required
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Expected Return Date *</label>
                <input
                  type="date"
                  value={returnDate}
                  onChange={(e) => setReturnDate(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Purpose / Event *</label>
                <input
                  type="text"
                  value={purpose}
                  onChange={(e) => setPurpose(e.target.value)}
                  placeholder="e.g., Weekly Training / Booth Setup"
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setBorrowTarget(null)} className="px-4 py-2 rounded-xl font-semibold text-slate-600">
                  Cancel
                </button>
                <button type="submit" disabled={borrowing} className="px-5 py-2 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer">
                  {borrowing ? 'Saving...' : 'Confirm Borrow'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Add Item Modal */}
      {showAddModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4">
          <div className="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-emerald-200">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-sm font-bold">Add Club Equipment</h3>
              <button type="button" onClick={() => setShowAddModal(false)} className="cursor-pointer">
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleAddItem} className="p-6 space-y-3 text-xs">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Equipment Name *</label>
                <input
                  type="text"
                  value={itemName}
                  onChange={(e) => setItemName(e.target.value)}
                  placeholder="e.g., DGT Chess Clocks / Walkie-Talkie"
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-emerald-900 mb-1">Category</label>
                  <input
                    type="text"
                    value={category}
                    onChange={(e) => setCategory(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  />
                </div>
                <div>
                  <label className="block font-bold text-emerald-900 mb-1">Total Quantity *</label>
                  <input
                    type="number"
                    min="1"
                    value={totalQty}
                    onChange={(e) => setTotalQty(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-bold"
                    required
                  />
                </div>
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Storage Location</label>
                <input
                  type="text"
                  value={location}
                  onChange={(e) => setLocation(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                />
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setShowAddModal(false)} className="px-4 py-2 rounded-xl font-semibold text-slate-600">
                  Cancel
                </button>
                <button type="submit" disabled={savingItem} className="px-5 py-2 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer">
                  {savingItem ? <Loader2 className="w-4 h-4 animate-spin" /> : 'Save Item'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/EventOperationsModal.tsx">
'use client';

import React, { useState, useEffect, useRef } from 'react';
import { supabase, Budget, UserProfile, EventRsvp, ActivityFeePayment, Claim, AdminPermissions, PassApprovalRule, isEntryPassMode, MAX_FILE_SIZE_BYTES, exportMultiSheetExcel, downloadFileFromUrl } from '@/lib/supabase';
import { X, CheckCircle2, ExternalLink, Download, Copy, RefreshCw, Ticket, ShieldCheck, Lock, Camera, QrCode, UploadCloud, FileText, AlertCircle, Loader2, Car, UserCheck, FileSpreadsheet, Eye, EyeOff, Settings } from 'lucide-react';

interface EventOperationsModalProps {
  event: Budget | null; initialTab: 'fee' | 'transport' | 'qr' | 'pass'; profile: UserProfile;
  isAdmin: boolean; permissions: AdminPermissions; rsvps: EventRsvp[]; feePayments: ActivityFeePayment[];
  claims?: Claim[]; paymentQrUrl?: string; paymentBankInfo?: string;
  onClose: () => void; onOpenScanner?: () => void; onRefresh: (msg: string) => void;
}

type TransportSurveyChoice = 'OWN' | 'One-Way' | 'Return Trip' | 'Round Trip' | 'DRIVER';

export default function EventOperationsModal({
  event, initialTab, profile, isAdmin, permissions, rsvps, feePayments, claims = [], paymentQrUrl = '', paymentBankInfo = '', onClose, onOpenScanner, onRefresh,
}: EventOperationsModalProps) {
  const [tab, setTab] = useState<'fee' | 'transport' | 'qr' | 'pass'>(initialTab);
  const [amountPaid, setAmountPaid] = useState('0');
  const [feeFile, setFeeFile] = useState<File | null>(null);
  const [feeError, setFeeError] = useState<string | null>(null);
  const [submittingFee, setSubmittingFee] = useState(false);

  // Admin customizable Club Payment QR / Bank Info & Visibility toggle per activity or club-wide
  const [activePayQrUrl, setActivePayQrUrl] = useState(paymentQrUrl);
  const [activePayBankInfo, setActivePayBankInfo] = useState(paymentBankInfo);
  const [showQrToMembers, setShowQrToMembers] = useState(true);
  const [adminQrSetupOpen, setAdminQrSetupOpen] = useState(false);
  const [adminQrFile, setAdminQrFile] = useState<File | null>(null);
  const [savingAdminQr, setSavingAdminQr] = useState(false);

  const [surveyChoice, setSurveyChoice] = useState<TransportSurveyChoice>('OWN');
  const [dormitoryInput, setDormitoryInput] = useState('');
  const [carDetails, setCarDetails] = useState('');
  const [seatsAvailable, setSeatsAvailable] = useState('4');
  const [tripsCount, setTripsCount] = useState('1');
  const [savingTransport, setSavingTransport] = useState(false);
  const [transportSavedSuccess, setTransportSavedSuccess] = useState(false);
  const [qrToken, setQrToken] = useState('');
  const [hasEntryPass, setHasEntryPass] = useState(false);
  const [passRule, setPassRule] = useState<PassApprovalRule>('auto_after_payment');
  const [localPassOverrides, setLocalPassOverrides] = useState<Record<string, boolean>>({});

  const lastEventIdRef = useRef<string | null>(null);
  useEffect(() => {
    if (!event) {
      lastEventIdRef.current = null;
      return;
    }
    if (lastEventIdRef.current === event.id) return;
    lastEventIdRef.current = event.id;

    setLocalPassOverrides({});
    setFeeError(null);
    setTransportSavedSuccess(false);
    setAdminQrSetupOpen(false);
    const feeVal = Number(event.registration_fee || 0);
    setAmountPaid(String(feeVal));
    setQrToken(event.qr_code_token || event.id.slice(0, 6).toUpperCase());

    const evQr = typeof window !== 'undefined' ? localStorage.getItem(`clubsync_ev_payqr_${event.id}`) : null;
    const evBank = typeof window !== 'undefined' ? localStorage.getItem(`clubsync_ev_paybank_${event.id}`) : null;
    const evShow = typeof window !== 'undefined' ? localStorage.getItem(`clubsync_ev_showqr_${event.id}`) : null;

    setActivePayQrUrl(evQr !== null ? evQr : paymentQrUrl);
    setActivePayBankInfo(evBank !== null ? evBank : paymentBankInfo);
    setShowQrToMembers(evShow !== null ? evShow !== 'false' : true);

    const savedMode =
      (typeof window !== 'undefined' ? localStorage.getItem(`clubsync_qrmode_${event.id}`) : null) ||
      event.ticket_qr_mode ||
      (feeVal > 0 ? 'entry_pass' : 'scan_attendance');
    const entryPassActive = isEntryPassMode(savedMode);
    setHasEntryPass(entryPassActive);

    const savedRule =
      (typeof window !== 'undefined' ? (localStorage.getItem(`clubsync_passrule_${event.id}`) as PassApprovalRule | null) : null) ||
      (savedMode === 'manual_only' ? 'manual_only' : 'auto_after_payment');
    setPassRule(savedRule);

    if (initialTab === 'pass' && !entryPassActive) setTab(isAdmin ? 'qr' : 'transport');
    else if (initialTab === 'fee' && feeVal <= 0 && !isAdmin) setTab('transport');
    else setTab(initialTab);

    const cur = rsvps.find((r) => r.budget_id === event.id && r.user_id === profile.id);
    setSurveyChoice(cur?.is_driver ? 'DRIVER' : cur?.transport_type && cur.transport_type !== 'None' ? cur.transport_type : 'OWN');
    setCarDetails(cur?.car_details || '');
    setSeatsAvailable(String(cur?.seats_available ?? 4));
    setTripsCount(String(cur?.trips_count ?? 1));
    setDormitoryInput(cur?.dormitory || profile.dormitory || '');
  }, [event, initialTab, isAdmin, rsvps, profile.id, profile.dormitory, paymentQrUrl, paymentBankInfo]);

  if (!event) return null;

  const myRsvp = rsvps.find((r) => r.budget_id === event.id && r.user_id === profile.id);
  const eventRsvps = rsvps.filter((r) => r.budget_id === event.id);
  const attendingRsvps = eventRsvps.filter((r) => r.attendance === 'Attending');
  const qrCheckedInList = eventRsvps.filter((r) => r.qr_checked_in);
  const passengers = attendingRsvps.filter((r) => r.transport_type !== 'None' && !r.is_driver);
  const eventDrivers = attendingRsvps.filter((r) => r.is_driver);
  const eventPayments = feePayments.filter((f) => f.budget_id === event.id);
  const eventClaims = claims.filter((c) => c.budget_id === event.id);
  const visibleFeePayments = isAdmin ? eventPayments : eventPayments.filter((p) => p.user_id === profile.id);
  const allowancePerTrip = Number(event.driver_allowance_per_trip || 0);
  const reqFee = Number(event.registration_fee || 0);
  const requiresFee = reqFee > 0;
  const isCurrentUserDriver = Boolean(myRsvp?.is_driver) || surveyChoice === 'DRIVER';

  const isMemberEligibleForPass = (rsvp?: EventRsvp) => {
    if (!rsvp || rsvp.attendance !== 'Attending') return false;
    if (localPassOverrides[rsvp.id] !== undefined) return localPassOverrides[rsvp.id];
    if (passRule === 'manual_only') return rsvp.pass_approved === true;
    if (requiresFee) {
      const hasPaid = eventPayments.some((f) => f.user_id === rsvp.user_id && f.status === 'Verified');
      return hasPaid || rsvp.pass_approved === true;
    }
    return rsvp.pass_approved === true;
  };

  const myPassEligible = isMemberEligibleForPass(myRsvp);
