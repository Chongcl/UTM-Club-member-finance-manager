                          key={t}
                          onClick={() => setActivityTimeFilter(t)}
                          className={`px-3 py-1 rounded-lg font-bold cursor-pointer ${
                            activityTimeFilter === t ? 'bg-emerald-600 text-white' : 'opacity-70'
