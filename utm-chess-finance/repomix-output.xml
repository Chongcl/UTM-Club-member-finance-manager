                    <td className="py-3 px-4 font-semibold text-emerald-900">
                      {e.event_name || 'General (Carry-Forward)'}
                    </td>
                    <td className="py-3 px-4">
                      <div className="font-bold text-slate-900">{e.title}</div>
                      <div className="text-[11px] text-slate-500">
                        {e.category} {e.notes ? `• ${e.notes}` : ''}
                      </div>
                    </td>
                    <td
                      className={`py-3 px-4 text-right font-extrabold text-sm ${
                        e.entry_type === 'IN'
                          ? 'text-emerald-700'
                          : 'text-rose-600'
                      }`}
                    >
                      {e.entry_type === 'IN' ? '+' : '-'} RM{' '}
                      {Number(e.amount).toFixed(2)}
                    </td>
                    <td className="py-3 px-4 text-right">
                      <div className="inline-flex items-center gap-1.5">
                        {e.attachment_url && (
                          <a
                            href={e.attachment_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="p-1.5 rounded-lg bg-emerald-50 text-emerald-700"
                            title="View File"
                          >
                            <ExternalLink className="w-3.5 h-3.5" />
                          </a>
                        )}
                        <button
                          type="button"
                          onClick={() => setHistoryTarget({ table: 'ledger_entries', recordId: e.id, title: e.title })}
                          className="p-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer"
                          title="View Edit History"
                        >
                          <History className="w-3.5 h-3.5" />
                        </button>
                        {canEdit && (
                          <>
                            <button
                              type="button"
                              onClick={() => openEditModal(e)}
                              className="p-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-emerald-50 cursor-pointer"
                              title="Edit"
                            >
                              <Edit3 className="w-3.5 h-3.5" />
                            </button>
                            <button
                              type="button"
                              onClick={() => handleDeleteEntry(e)}
                              className="p-1.5 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 cursor-pointer"
                              title="Delete"
                            >
                              <Trash2 className="w-3.5 h-3.5" />
                            </button>
                          </>
                        )}
                      </div>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      {showModal && canEdit && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl shadow-2xl border border-emerald-200 max-w-md w-full overflow-hidden my-8">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-base font-bold">
                {editingEntry
                  ? 'Edit Finance Record'
                  : modalMode === 'SET_SAVINGS'
                  ? 'Set / Update Current Club Savings'
                  : 'Add Finance Record'}
              </h3>
              <button
                type="button"
                onClick={() => setShowModal(false)}
                className="text-emerald-200 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleSaveEntry} className="p-6 space-y-3.5">
              {!editingEntry && (
                <div className="grid grid-cols-3 gap-1.5 bg-emerald-50 p-1 rounded-xl border border-emerald-200">
                  <button
                    type="button"
                    onClick={() => {
                      setModalMode('SET_SAVINGS');
                      setEntryType('IN');
                      setTitle('Carry-Forward / Current Savings Balance Update');
                      setCategory('Carry-Forward / Opening Balance');
                      setAmount(currentSavingsBalance.toFixed(2));
                    }}
                    className={`py-2 rounded-lg text-[11px] font-bold cursor-pointer ${
                      modalMode === 'SET_SAVINGS'
                        ? 'bg-emerald-800 text-white'
                        : 'text-emerald-900'
                    }`}
                  >
                    Set Savings
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      setModalMode('IN');
                      setEntryType('IN');
                      setTitle('');
                      setCategory(IN_CATEGORIES[0]);
                      setAmount('');
                    }}
                    className={`py-2 rounded-lg text-[11px] font-bold cursor-pointer ${
                      modalMode === 'IN'
                        ? 'bg-emerald-600 text-white'
                        : 'text-emerald-900'
                    }`}
                  >
                    + Money In
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      setModalMode('OUT');
                      setEntryType('OUT');
                      setTitle('');
                      setCategory(OUT_CATEGORIES[0]);
                      setAmount('');
                    }}
                    className={`py-2 rounded-lg text-[11px] font-bold cursor-pointer ${
                      modalMode === 'OUT'
                        ? 'bg-rose-600 text-white'
                        : 'text-slate-700'
                    }`}
                  >
                    - Expense Out
                  </button>
                </div>
              )}

              {modalMode === 'SET_SAVINGS' && !editingEntry ? (
                <div className="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-2 text-xs">
                  <div className="flex justify-between">
                    <span className="text-slate-600 font-semibold">Current Calculated Balance:</span>
                    <span className="font-mono font-extrabold text-emerald-900">RM {currentSavingsBalance.toFixed(2)}</span>
                  </div>
                  <p className="text-[11px] text-emerald-800">
                    Enter the exact total savings your club currently holds. The system will automatically record a Carry-Forward adjustment so your balance carries forward across all batches.
                  </p>
                </div>
              ) : (
                <>
                  <div>
                    <label className="block text-xs font-bold text-emerald-900 mb-1">
                      Category
                    </label>
                    <select
                      value={category}
                      onChange={(e) => setCategory(e.target.value)}
                      className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm font-semibold"
                    >
                      {activeCategoryList.map((cat) => (
                        <option key={cat} value={cat}>
                          {cat}
                        </option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label className="block text-xs font-bold text-emerald-900 mb-1">
                      Related Event / Scope
                    </label>
                    <select
                      value={selectedEventOption}
                      onChange={(e) => setSelectedEventOption(e.target.value)}
                      className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm"
                    >
                      <option value="GENERAL">General Club Fund (Carry-Forward All Batches)</option>
                      {events.map((ev) => (
                        <option key={ev.id} value={ev.event_name}>
                          {ev.event_name}
                        </option>
                      ))}
                      <option value="OTHER">Other (Type Custom Name)</option>
                    </select>
                  </div>
                  {selectedEventOption === 'OTHER' && (
                    <input
                      type="text"
                      value={customEventName}
                      onChange={(e) => setCustomEventName(e.target.value)}
                      placeholder="Custom event name..."
                      className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                      required
                    />
                  )}
                  <div>
                    <label className="block text-xs font-bold text-emerald-900 mb-1">
                      Title / Description *
                    </label>
                    <input
                      type="text"
                      value={title}
                      onChange={(e) => setTitle(e.target.value)}
                      placeholder={entryType === 'IN' ? 'e.g., Batch Carry-Forward / Sponsorship' : 'e.g., Tournament Refreshments'}
                      className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                      required
                    />
                  </div>
                </>
              )}

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-emerald-900 mb-1">
                    {modalMode === 'SET_SAVINGS' && !editingEntry ? 'New Total Savings (RM) *' : 'Amount (RM) *'}
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    value={amount}
                    onChange={(e) => setAmount(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-bold"
                    required
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-emerald-900 mb-1">
                    Date *
                  </label>
                  <input
                    type="date"
                    value={entryDate}
                    onChange={(e) => setEntryDate(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                    required
                  />
                </div>
              </div>
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Attachment / Proof (Max 50MB)
                </label>
                <input
                  type="file"
                  accept="image/*,application/pdf"
                  onChange={(e) =>
                    setAttachmentFile(e.target.files?.[0] || null)
                  }
                  className="w-full text-xs text-slate-600 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-600 file:text-white cursor-pointer"
                />
              </div>
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Remarks
                </label>
                <input
                  type="text"
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="Optional notes..."
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                />
              </div>
              {errorMsg && (
                <div className="text-xs text-red-600 bg-red-50 p-2 rounded-lg">
                  {errorMsg}
                </div>
              )}
              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowModal(false)}
                  className="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={saving}
                  className="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer"
                >
                  {saving ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="w-4 h-4" />
                  )}
                  <span>{modalMode === 'SET_SAVINGS' && !editingEntry ? 'Update Savings' : 'Save Record'}</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
      {editingFeeItem && canEdit && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4">
          <div className="bg-white rounded-3xl max-w-sm w-full overflow-hidden shadow-2xl border border-emerald-200">
            <div className="bg-emerald-800 text-white px-5 py-3.5 flex items-center justify-between">
              <h3 className="text-sm font-bold">Edit Fee — {editingFeeItem.student_name}</h3>
              <button type="button" onClick={() => setEditingFeeItem(null)} className="cursor-pointer"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveFeeQuickEdit} className="p-5 space-y-3 text-xs">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Amount Paid (RM) *</label>
                <input type="number" step="0.01" value={editFeeAmount} onChange={(e) => setEditFeeAmount(e.target.value)} className="w-full rounded-xl border border-emerald-300 px-3 py-2 font-bold" required />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Status</label>
                <select value={editFeeStatus} onChange={(e) => setEditFeeStatus(e.target.value as 'Verified' | 'Pending' | 'Rejected')} className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-bold">
                  <option value="Verified">Verified</option>
                  <option value="Pending">Pending</option>
                  <option value="Rejected">Rejected</option>
                </select>
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setEditingFeeItem(null)} className="px-4 py-2 rounded-xl font-semibold text-slate-600 cursor-pointer">Cancel</button>
                <button type="submit" disabled={savingFeeEdit} className="px-5 py-2 rounded-xl bg-emerald-600 text-white font-bold cursor-pointer">{savingFeeEdit ? 'Saving...' : 'Save Fee'}</button>
              </div>
            </form>
          </div>
        </div>
      )}

      <RecordHistoryModal
        target={historyTarget}
        logs={logs}
        onClose={() => setHistoryTarget(null)}
      />
    </div>
  );
}
</file>

<file path="src/components/Navbar.tsx">
'use client';

import React, { useState } from 'react';
import { UserProfile } from '@/lib/supabase';
import { Menu, X, Calendar, Receipt, UserCheck, Wallet, Users, PlusCircle, Lock, Unlock, KeyRound, LogOut, Layers, Loader2, Package, QrCode, Crown, Moon, Sun, Palette, FileText, ShieldCheck } from 'lucide-react';

export type NavTab = 'activities' | 'equipment' | 'claims' | 'profile' | 'ledger' | 'members' | 'logs';

interface NavbarProps {
  profile: UserProfile; clubName: string; logoUrl?: string; activeTab: NavTab; onSelectTab: (tab: NavTab) => void;
  currentBatch?: string; roleMode: 'member' | 'admin' | 'owner'; pendingClaimsCount?: number;
  darkMode?: boolean; onToggleDarkMode?: () => void; canCustomizeTheme?: boolean; onOpenThemeStudio?: () => void;
  onUnlockAdmin: (pin: string) => Promise<boolean>;
  onSwitchMode: (target: 'member' | 'admin' | 'owner') => Promise<void>;
  onSignOut: () => Promise<void>; onOpenNewClaim: () => void; onOpenQrScanner: () => void;
  onOpenNewActivity?: () => void; onOpenNewFinance?: () => void; switchingRole?: boolean;
}

export default function Navbar({
  profile, clubName, logoUrl = '', activeTab, onSelectTab, currentBatch = '2026/2027', roleMode, pendingClaimsCount = 0,
  darkMode = false, onToggleDarkMode, canCustomizeTheme = false, onOpenThemeStudio,
  onUnlockAdmin, onSwitchMode, onSignOut, onOpenNewClaim, onOpenQrScanner,
  onOpenNewActivity, onOpenNewFinance, switchingRole = false,
}: NavbarProps) {
  const isAdminOrOwner = roleMode === 'admin' || roleMode === 'owner';
  const isOwner = roleMode === 'owner';
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [pinModalOpen, setPinModalOpen] = useState(false);
  const [pinInput, setPinInput] = useState('');
  const [pinError, setPinError] = useState<string | null>(null);

  const handleNav = (tab: NavTab) => { onSelectTab(tab); setDrawerOpen(false); };

  const handlePinSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setPinError(null);
    const ok = await onUnlockAdmin(pinInput);
    if (ok) { setPinInput(''); setPinModalOpen(false); setDrawerOpen(false); }
    else setPinError('Invalid Passcode.');
  };

  const renderLogo = () => {
    if (!logoUrl) {
      return (
        <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white shadow-md shrink-0">
          <Layers className="w-5 h-5" />
        </div>
      );
    }
    if (logoUrl.toLowerCase().endsWith('.pdf')) {
      return (
        <a href={logoUrl} target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()} className="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center shadow-md shrink-0" title="Open Official Club Logo PDF">
          <FileText className="w-5 h-5" />
        </a>
      );
    }
    return <img src={logoUrl} alt={clubName} className="w-10 h-10 rounded-xl object-cover border border-emerald-400/40 shadow-md shrink-0 bg-white" />;
  };

  return (
    <>
      <header className={`sticky top-0 z-30 backdrop-blur-xl border-b transition-colors ${darkMode ? 'bg-slate-950/80 border-white/10 text-white' : 'bg-white/80 border-slate-200/80 text-slate-900'}`}>
        <div className="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <button type="button" onClick={() => setDrawerOpen(true)} className={`p-2.5 rounded-xl border transition cursor-pointer ${darkMode ? 'bg-white/5 border-white/10 text-emerald-400 hover:bg-white/10' : 'bg-slate-100 text-slate-800 border-slate-200 hover:bg-slate-200'}`}><Menu className="w-5 h-5" /></button>
            <div onClick={() => handleNav('activities')} className="flex items-center gap-2.5 cursor-pointer">
              {renderLogo()}
              <span className="text-base font-extrabold tracking-tight">{clubName || 'ClubSync'}</span>
              <span className={`hidden sm:inline-block px-2 py-0.5 rounded-md text-[10px] font-bold border ${darkMode ? 'bg-white/5 border-white/10 text-emerald-300' : 'bg-emerald-50 text-emerald-800 border-emerald-200'}`}>{currentBatch}</span>
              {isOwner ? <span className="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-amber-400 text-slate-950"><Crown className="w-3 h-3 inline mr-0.5" />Owner</span> : isAdminOrOwner ? <span className="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase bg-emerald-600 text-white">Admin</span> : null}
            </div>
          </div>

          <div className="flex items-center gap-2">
            {canCustomizeTheme && onOpenThemeStudio && (
              <button type="button" onClick={onOpenThemeStudio} className={`inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold border transition cursor-pointer ${darkMode ? 'bg-white/10 border-white/15 text-amber-300 hover:bg-white/15' : 'bg-amber-50 border-amber-200 text-amber-900 hover:bg-amber-100'}`} title="Customize Logo & Background">
                <Palette className="w-4 h-4" /><span className="hidden md:inline">Logo &amp; Theme</span>
              </button>
            )}
            {onToggleDarkMode && (
              <button type="button" onClick={onToggleDarkMode} className={`p-2 rounded-xl border transition cursor-pointer ${darkMode ? 'bg-white/10 border-white/15 text-amber-300' : 'bg-slate-100 border-slate-200 text-slate-700'}`} title="Toggle Dark / Light Mode">{darkMode ? <Sun className="w-4 h-4" /> : <Moon className="w-4 h-4" />}</button>
            )}
            <button type="button" onClick={onOpenQrScanner} className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-950 hover:bg-slate-900 text-white border border-white/15 shadow-sm cursor-pointer"><QrCode className="w-4 h-4" /><span>Scan QR</span></button>
            <button type="button" onClick={onOpenNewClaim} className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold border bg-emerald-600 hover:bg-emerald-500 text-white border-emerald-500 cursor-pointer"><PlusCircle className="w-4 h-4 text-white" /><span className="hidden sm:inline">Submit Claim</span></button>
          </div>
        </div>
      </header>

      {drawerOpen && (
        <div className="fixed inset-0 z-50 flex">
          <div onClick={() => setDrawerOpen(false)} className="fixed inset-0 bg-slate-950/60 backdrop-blur-xs" />
          <aside className={`relative z-10 w-72 h-full shadow-2xl flex flex-col justify-between p-5 overflow-y-auto ${darkMode ? 'bg-slate-900 text-white border-r border-white/10' : 'bg-white text-slate-900'}`}>
            <div className="space-y-5">
              <div className="flex justify-between items-center pb-3 border-b border-slate-200/20">
                <div className="flex items-center gap-2">{renderLogo()}<span className="font-extrabold text-sm">{clubName}</span></div>
                <button type="button" onClick={() => setDrawerOpen(false)}><X className="w-5 h-5" /></button>
              </div>
              <div className={`p-3 rounded-2xl border text-xs ${darkMode ? 'bg-white/5 border-white/10' : 'bg-emerald-50 border-emerald-200'}`}>
                <div className="font-extrabold">{profile.full_name} ({isOwner ? 'Owner' : isAdminOrOwner ? 'Admin' : 'Member'})</div>
                <div className="font-mono opacity-75">{profile.matric_no} • {profile.phone_number}</div>
              </div>
              <nav className="space-y-1 text-xs font-bold">
                <button type="button" onClick={() => handleNav('activities')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'activities' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><Calendar className="w-4 h-4" /><span>Home &amp; Activities</span></button>
                <button type="button" onClick={() => { setDrawerOpen(false); onOpenQrScanner(); }} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-950 text-white hover:bg-slate-900 border border-white/10 cursor-pointer"><QrCode className="w-4 h-4 text-white" /><span>Scan QR Attendance</span></button>
                <button type="button" onClick={() => handleNav('equipment')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'equipment' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><Package className="w-4 h-4" /><span>Equipment Borrowing</span></button>
                <button type="button" onClick={() => handleNav('claims')} className={`w-full flex items-center justify-between px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'claims' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><span className="flex items-center gap-3"><Receipt className="w-4 h-4" /><span>Reimbursement Claims</span></span>{pendingClaimsCount > 0 && <span className="px-2 py-0.5 rounded-full bg-amber-400 text-slate-950">{pendingClaimsCount}</span>}</button>
                <button type="button" onClick={() => handleNav('profile')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'profile' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><UserCheck className="w-4 h-4" /><span>My Profile</span></button>
              </nav>
              {isAdminOrOwner && (
                <nav className="space-y-1 pt-2 border-t border-slate-200/20 text-xs font-bold">
                  <button type="button" onClick={() => handleNav('ledger')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'ledger' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><Wallet className="w-4 h-4" /><span>Club Finance &amp; Savings</span></button>
                  <button type="button" onClick={() => handleNav('members')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'members' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><Users className="w-4 h-4" /><span>Members &amp; Batch Clearance</span></button>
                  <button type="button" onClick={() => handleNav('logs')} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl cursor-pointer ${activeTab === 'logs' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-500/10'}`}><ShieldCheck className="w-4 h-4" /><span>Security &amp; Activity Log</span></button>
                  {canCustomizeTheme && onOpenThemeStudio && <button type="button" onClick={() => { setDrawerOpen(false); onOpenThemeStudio(); }} className="w-full flex items-center gap-3 px-3 py-2 rounded-xl text-amber-500 hover:bg-amber-500/10 cursor-pointer"><Palette className="w-4 h-4" /><span>Logo &amp; Background Studio</span></button>}
                  {onOpenNewActivity && <button type="button" onClick={() => { setDrawerOpen(false); onOpenNewActivity(); }} className="w-full flex items-center gap-3 px-3 py-2 rounded-xl bg-emerald-500/10 text-emerald-500 cursor-pointer">+ New Activity</button>}
                  {onOpenNewFinance && <button type="button" onClick={() => { setDrawerOpen(false); onOpenNewFinance(); }} className="w-full flex items-center gap-3 px-3 py-2 rounded-xl bg-amber-400/20 text-amber-500 cursor-pointer">+ Add Finance Record</button>}
                </nav>
              )}
            </div>

            <div className="pt-4 border-t border-slate-200/20 space-y-2 text-xs font-bold">
              {roleMode === 'member' && (
                <button type="button" onClick={() => { setDrawerOpen(false); setPinError(null); setPinModalOpen(true); }} className="w-full py-2.5 rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/30 cursor-pointer"><Lock className="w-3.5 h-3.5 inline mr-1" />Unlock Admin Mode</button>
              )}
              {roleMode === 'admin' && (
                <>
                  {profile.role === 'owner' && (
                    <button type="button" onClick={() => { setDrawerOpen(false); onSwitchMode('owner'); }} className="w-full py-2 rounded-xl bg-amber-400 text-slate-950 cursor-pointer"><Crown className="w-3.5 h-3.5 inline mr-1" />Owner Mode</button>
                  )}
                  <button type="button" onClick={() => { setDrawerOpen(false); onSwitchMode('member'); }} className="w-full py-2 rounded-xl bg-slate-500/20 cursor-pointer"><Unlock className="w-3.5 h-3.5 inline mr-1" />Exit to Member Mode</button>
                </>
              )}
              {roleMode === 'owner' && (
                <div className="grid grid-cols-2 gap-1.5">
                  <button type="button" onClick={() => { setDrawerOpen(false); onSwitchMode('admin'); }} className="py-2 rounded-xl bg-emerald-600 text-white cursor-pointer">Admin Mode</button>
                  <button type="button" onClick={() => { setDrawerOpen(false); onSwitchMode('member'); }} className="py-2 rounded-xl bg-slate-500/20 cursor-pointer">Member Mode</button>
                </div>
              )}
              <button type="button" onClick={onSignOut} className="w-full py-2 rounded-xl text-rose-500 hover:bg-rose-500/10 cursor-pointer"><LogOut className="w-3.5 h-3.5 inline mr-1" />Sign Out</button>
            </div>
          </aside>
        </div>
      )}

      {pinModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 p-4">
          <div className="bg-white text-slate-900 rounded-3xl max-w-sm w-full overflow-hidden shadow-2xl">
            <div className="bg-emerald-800 text-white px-5 py-4 flex justify-between items-center">
              <span className="text-sm font-extrabold"><KeyRound className="w-4 h-4 inline mr-1" />Unlock Admin Mode</span>
              <button type="button" onClick={() => setPinModalOpen(false)}><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handlePinSubmit} className="p-5 space-y-3 text-xs">
              <input type="password" value={pinInput} onChange={(e) => setPinInput(e.target.value)} placeholder="Enter Admin or Owner Code" className="w-full rounded-xl border px-3 py-2 text-sm font-mono" required />
              {pinError && <div className="text-rose-600">{pinError}</div>}
              <div className="flex justify-end gap-2"><button type="button" onClick={() => setPinModalOpen(false)} className="px-3 py-2">Cancel</button><button type="submit" disabled={switchingRole} className="px-4 py-2 rounded-xl bg-emerald-700 text-white font-bold">{switchingRole && <Loader2 className="w-3.5 h-3.5 animate-spin inline mr-1" />}Unlock</button></div>
            </form>
          </div>
        </div>
      )}
    </>
  );
}
