              <CinematicHub
                announcements={announcements}
                polls={polls}
                pollVotes={pollVotes}
                profile={profile}
                isAdmin={effectivePermissions.can_manage_posters_polls}
                onRefresh={(m: string) => {
                  fetchAllData();
                  showToast(m);
                }}
              />

              <section className="space-y-4">
