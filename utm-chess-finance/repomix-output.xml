<file path="src/components/RecordHistoryModal.tsx">
'use client';

import React from 'react';
import { ActivityLogEntry } from '@/lib/supabase';
import {
  TrackedTable,
  getRecordHistory,
  tableDisplayLabel,
} from '@/lib/history';
import { X, History, ArrowRight, Trash2, RotateCcw, Edit3, Clock } from 'lucide-react';

export interface HistoryModalTarget {
  table: TrackedTable;
  recordId: string;
  title: string;
}

interface RecordHistoryModalProps {
  target: HistoryModalTarget | null;
  logs: ActivityLogEntry[];
  onClose: () => void;
}

export default function RecordHistoryModal({
  target,
  logs,
  onClose,
}: RecordHistoryModalProps) {
  if (!target) return null;

  const events = getRecordHistory(target.table, target.recordId, logs);

  return (
    <div
      className="fixed inset-0 z-[60] flex items-center justify-center bg-slate-950/75 backdrop-blur-xs p-4 overflow-y-auto"
      onClick={onClose}
    >
      <div
        onClick={(e) => e.stopPropagation()}
        className="bg-white text-slate-900 rounded-3xl shadow-2xl border border-emerald-200 max-w-xl w-full overflow-hidden my-8"
      >
        <div className="bg-slate-900 text-white px-6 py-4 flex items-center justify-between gap-3">
          <div className="flex items-center gap-2.5 min-w-0">
            <History className="w-5 h-5 text-emerald-400 shrink-0" />
            <div className="min-w-0">
              <h3 className="text-sm font-extrabold truncate">
                Edit &amp; Audit History — {target.title}
              </h3>
              <p className="text-[11px] text-slate-300">
                {tableDisplayLabel(target.table)} • Record ID:{' '}
                <span className="font-mono">{target.recordId.slice(0, 8)}</span>
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-slate-300 hover:text-white cursor-pointer"
            aria-label="Close history"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="p-5 max-h-[72vh] overflow-y-auto space-y-3 text-xs">
          {events.length === 0 ? (
            <div className="py-10 text-center space-y-2 text-slate-400">
              <Clock className="w-8 h-8 mx-auto text-slate-300" />
              <p className="font-bold text-slate-600">No edit history recorded yet.</p>
              <p>
                Whenever this record is edited or removed from the web view, every Before → After change is tracked here.
              </p>
            </div>
          ) : (
            events.map((ev) => (
              <div
                key={ev.id}
                className="p-3.5 rounded-2xl border border-slate-200 bg-slate-50/70 space-y-2"
              >
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div className="flex items-center gap-1.5">
                    <span
                      className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase ${
                        ev.action === 'deleted'
                          ? 'bg-rose-100 text-rose-700'
                          : ev.action === 'restored'
                          ? 'bg-sky-100 text-sky-800'
                          : 'bg-emerald-100 text-emerald-800'
                      }`}
                    >
                      {ev.action === 'deleted' ? (
                        <Trash2 className="w-3 h-3" />
                      ) : ev.action === 'restored' ? (
                        <RotateCcw className="w-3 h-3" />
                      ) : (
                        <Edit3 className="w-3 h-3" />
                      )}
                      {ev.action}
                    </span>
                    <span className="font-extrabold text-slate-900">{ev.actorName}</span>
                    {ev.actorMatric && (
                      <span className="font-mono text-[11px] text-slate-500">
                        ({ev.actorMatric})
                      </span>
                    )}
                  </div>
                  <span className="font-mono text-[11px] text-slate-400">
                    {new Date(ev.timestamp).toLocaleString()}
                  </span>
                </div>

                {ev.changes.length > 0 ? (
                  <div className="rounded-xl bg-white border border-slate-200 divide-y divide-slate-100 overflow-hidden">
                    {ev.changes.map((chg, idx) => (
                      <div
                        key={idx}
                        className="px-3 py-2 flex flex-wrap items-center justify-between gap-2 text-[11px]"
                      >
                        <span className="font-bold text-slate-700">{chg.field}</span>
                        <div className="flex flex-wrap items-center gap-1.5 font-mono">
                          <span className="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 line-through">
                            {chg.before}
                          </span>
                          <ArrowRight className="w-3 h-3 text-slate-400 shrink-0" />
                          <span className="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 font-bold">
                            {chg.after}
                          </span>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p className="text-[11px] text-slate-600">{ev.summary}</p>
                )}
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/lib/equipment.ts">
import { supabase, EquipmentItem, EquipmentLoan, UserProfile, logActivity } from '@/lib/supabase';

/** Local (not UTC) YYYY-MM-DD, so Malaysia time doesn't roll back a day before 8 AM. */
export function localDateStr(input: Date | string = new Date()): string {
  const d = typeof input === 'string' ? new Date(input) : input;
  if (isNaN(d.getTime())) return '';
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

export function addDaysStr(dateStr: string, n: number): string {
  const d = new Date(`${dateStr}T00:00:00`);
  d.setDate(d.getDate() + n);
  return localDateStr(d);
}

export function enumerateDays(start: string, end: string, maxDays = 400): string[] {
  const out: string[] = [];
  if (!start || !end || end < start) return out;
  let cur = start;
  while (cur <= end && out.length < maxDays) {
    out.push(cur);
    cur = addDaysStr(cur, 1);
  }
  return out;
}

export type LoanApproval = 'Pending' | 'Approved' | 'Rejected' | 'Cancelled';

/** Normalize equipment_loans rows across both original (equipment_id/remarks) and modern (item_id/purpose) schemas. */
export function normalizeEquipmentLoan(raw: Record<string, unknown>): EquipmentLoan {
  const rawStatus = String(raw.status || 'Borrowed');
  const approvalStatus = raw.approval_status
    ? (String(raw.approval_status) as EquipmentLoan['approval_status'])
    : rawStatus === 'Pending'
    ? 'Pending'
    : 'Approved';

  return {
    id: String(raw.id || ''),
    item_id: String(raw.item_id || raw.equipment_id || ''),
    item_name: String(raw.item_name || raw.equipment_name || ''),
    user_id: String(raw.user_id || ''),
    borrower_name: String(raw.borrower_name || ''),
    matric_no: String(raw.matric_no || ''),
    phone_number: String(raw.phone_number || ''),
    quantity: Number(raw.quantity ?? 1),
    purpose: String(raw.purpose ?? raw.remarks ?? ''),
    borrow_date: String(raw.borrow_date || ''),
    return_date: String(raw.return_date || ''),
    status: (rawStatus as EquipmentLoan['status']) || 'Borrowed',
    returned_at: raw.returned_at ? String(raw.returned_at) : null,
    approval_status: approvalStatus,
    approved_by: raw.approved_by ? String(raw.approved_by) : null,
    approved_at: raw.approved_at ? String(raw.approved_at) : null,
    created_at: String(raw.created_at || ''),
  };
}

/** Normalize equipment_items rows across both original (remarks) and modern (notes/available_quantity) schemas. */
export function normalizeEquipmentItem(
  raw: Record<string, unknown>,
  loans?: EquipmentLoan[]
): EquipmentItem {
  const id = String(raw.id || '');
  const total = Number(raw.total_quantity ?? 1);
  let avail: number;
  if (raw.available_quantity !== undefined && raw.available_quantity !== null) {
    avail = Number(raw.available_quantity);
  } else if (loans) {
    const today = localDateStr();
    avail = Math.max(0, total - unitsInUseOnDay(loans, id, today, today));
  } else {
    avail = total;
  }

  return {
    id,
    item_name: String(raw.item_name || raw.equipment_name || ''),
    category: String(raw.category || 'Sports / Chess Sets'),
    total_quantity: total,
    available_quantity: avail,
    location: String(raw.location || 'Club Storage Room'),
    notes: String(raw.notes ?? raw.remarks ?? ''),
    requires_approval: Boolean(raw.requires_approval),
    created_at: String(raw.created_at || ''),
  };
}

/** Old rows (before the approval feature) have no approval_status → treat as Approved unless status is Pending. */
export function approvalOf(loan: EquipmentLoan): LoanApproval {
  if (loan.approval_status) return loan.approval_status as LoanApproval;
  if ((loan.status as string) === 'Pending') return 'Pending';
  return 'Approved';
}

/** Does this loan block stock on the given calendar day? */
export function loanOccupiesDay(loan: EquipmentLoan, day: string, today: string): boolean {
  const a = approvalOf(loan);
  if (a === 'Rejected' || a === 'Cancelled') return false;
  if (!loan.borrow_date || loan.borrow_date > day) return false;
  if (loan.status === 'Returned') {
    const end = loan.returned_at ? localDateStr(loan.returned_at) : loan.return_date;
    return day <= (end || loan.return_date);
  }
  // Not returned yet: occupies until due date; if overdue, the unit is still physically out.
  return day <= loan.return_date || loan.return_date < today;
}

export function unitsInUseOnDay(loans: EquipmentLoan[], itemId: string, day: string, today: string): number {
  return loans
    .filter((l) => l.item_id === itemId && loanOccupiesDay(l, day, today))
    .reduce((s, l) => s + Number(l.quantity || 0), 0);
}

export function maxUnitsInUseInRange(
  loans: EquipmentLoan[],
  itemId: string,
  start: string,
  end: string,
  today: string
): number {
  let max = 0;
  for (const day of enumerateDays(start, end)) {
    max = Math.max(max, unitsInUseOnDay(loans, itemId, day, today));
  }
  return max;
}

export function availableForRange(
  item: EquipmentItem,
  loans: EquipmentLoan[],
  start: string,
  end: string,
  today: string
): number {
  return Math.max(0, Number(item.total_quantity) - maxUnitsInUseInRange(loans, item.id, start, end, today));
}

/** Equipment QR payload printed on stickers. */
export function equipmentQrPayload(itemId: string, unitNo?: number): string {
  return `CLUBSYNC_EQ::v1::${itemId}${unitNo ? `::${unitNo}` : ''}`;
}

export function qrImageUrl(data: string, size = 220): string {
  return `https://api.qrserver.com/v1/create-qr-code/?size=${size}x${size}&margin=8&data=${encodeURIComponent(data)}`;
}

export const MIGRATION_HINT =
  'The database needs the latest update first. Ask the owner to run the new SQL migration in Supabase.';

interface SubmitLoanArgs {
  item: EquipmentItem;
  loans: EquipmentLoan[];
  profile: UserProfile;
  quantity: number;
  startDate: string;
  endDate: string;
  purpose: string;
}

export interface SubmitLoanResult {
  ok: boolean;
  error?: string;
  quantity: number;
  approval: 'Pending' | 'Approved';
  isFuture: boolean;
}

/** Shared by the Equipment page and the on-the-spot QR scanner. */
export async function submitLoanRequest({
  item,
  loans,
  profile,
  quantity,
  startDate,
  endDate,
  purpose,
}: SubmitLoanArgs): Promise<SubmitLoanResult> {
  const today = localDateStr();
  const approval: 'Pending' | 'Approved' = item.requires_approval ? 'Pending' : 'Approved';
  const isFuture = startDate > today;
  const base: SubmitLoanResult = { ok: false, quantity, approval, isFuture };

  if (!startDate || !endDate || endDate < startDate) {
    return { ...base, error: 'Return date must be on or after the start date.' };
  }
  const avail = availableForRange(item, loans, startDate, endDate, today);
  if (avail <= 0) {
    return { ...base, error: 'No stock is free for those dates. Try different dates.' };
  }
  if (quantity > avail) {
    return { ...base, error: `Only ${avail} unit(s) are free for the whole period ${startDate} → ${endDate}.` };
  }

  const cleanPurpose = purpose.trim() || 'Club Activity';
  const statusForLegacy = approval === 'Pending' ? 'Pending' : 'Borrowed';

  const modernCore = {
    item_id: item.id,
    item_name: item.item_name,
    user_id: profile.id,
    borrower_name: profile.full_name,
    matric_no: profile.matric_no,
    phone_number: profile.phone_number || '',
    quantity,
    purpose: cleanPurpose,
    borrow_date: startDate,
    return_date: endDate,
    status: 'Borrowed',
  };

  const candidates: Record<string, unknown>[] = [
    // 1. Modern full schema
    { ...modernCore, approval_status: approval },
    // 2. Modern core schema without approval_status
    { ...modernCore, status: statusForLegacy },
    // 3. Original Supabase schema (equipment_id, equipment_name, application_date, remarks)
    {
      equipment_id: item.id,
      equipment_name: item.item_name,
      user_id: profile.id,
      borrower_name: profile.full_name,
      matric_no: profile.matric_no,
      phone_number: profile.phone_number || '',
      quantity,
      application_date: today,
      borrow_date: startDate,
      return_date: endDate,
      status: statusForLegacy,
      remarks: cleanPurpose,
    },
    // 4. Minimal original schema fallback
    {
      equipment_id: item.id,
      equipment_name: item.item_name,
      user_id: profile.id,
      borrower_name: profile.full_name,
      matric_no: profile.matric_no,
      phone_number: profile.phone_number || '',
      quantity,
      borrow_date: startDate,
      return_date: endDate,
      status: 'Borrowed',
    },
  ];

  let lastError: string | null = null;
  let inserted = false;
  for (const payload of candidates) {
    const { error } = await supabase.from('equipment_loans').insert(payload);
    if (!error) {
      inserted = true;
      break;
    }
    lastError = error.message;
  }

  if (!inserted) {
    return { ...base, error: lastError || 'Could not save borrow record.' };
  }

  if (!isFuture && approval === 'Approved') {
    const inUse = unitsInUseOnDay(loans, item.id, today, today) + quantity;
    await supabase
      .from('equipment_items')
      .update({ available_quantity: Math.max(0, item.total_quantity - inUse) })
      .eq('id', item.id);
  }

  void logActivity(
    profile,
    'Equipment',
    approval === 'Pending' ? 'Equipment request' : isFuture ? 'Equipment reserved' : 'Equipment borrowed',
    `${profile.full_name} (${profile.matric_no}) ${
      approval === 'Pending' ? 'requested' : isFuture ? 'reserved' : 'borrowed'
    } ${quantity}x ${item.item_name} for ${startDate} → ${endDate}` +
      (purpose.trim() ? ` — ${purpose.trim()}` : '')
  );

  return { ok: true, quantity, approval, isFuture };
}

/** Re-sync equipment_items.available_quantity with "units free today". */
export async function syncAvailabilityToday(item: EquipmentItem, loansAfter: EquipmentLoan[]) {
  const today = localDateStr();
  const inUse = unitsInUseOnDay(loansAfter, item.id, today, today);
  await supabase
    .from('equipment_items')
    .update({ available_quantity: Math.max(0, item.total_quantity - inUse) })
    .eq('id', item.id);
}
