          r.dormitory || '-',
          r.assigned_driver_name || '-',
        ]),
      },
    ]);
    onRefresh(`Generated Multi-Sheet Excel Report for ${selectedBudget ? selectedBudget.event_name : 'All Activities'}!`);
  };

  const activeCategoryList = entryType === 'IN' ? IN_CATEGORIES : OUT_CATEGORIES;

  return (
