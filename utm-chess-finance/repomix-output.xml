                                      className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-600 text-white font-bold text-[10px]"
                                      title="Broadcast pickup details to WhatsApp"
                                    >
                                      <Megaphone className="w-2.5 h-2.5" /> Broadcast
                                    </a>
                                  )}
                                </div>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    )}
