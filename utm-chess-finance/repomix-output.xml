<file path="src/components/ClaimFormModal.tsx">
'use client';

import React, { useState } from 'react';
import { supabase, Budget, UserProfile, DEFAULT_DEPARTMENTS } from '@/lib/supabase';
import ReceiptDropzone, { ExtractedReceiptData } from './ReceiptDropzone';
import { X, Receipt, Loader2, CheckCircle2, Phone } from 'lucide-react';

interface ClaimFormModalProps {
  isOpen: boolean;
  onClose: () => void;
  budgets: Budget[];
  profile: UserProfile;
  departments?: string[];
  onSuccess: (message: string) => void;
}

export default function ClaimFormModal({
  isOpen,
  onClose,
  budgets,
  profile,
  departments = DEFAULT_DEPARTMENTS,
  onSuccess,
}: ClaimFormModalProps) {
  const [selectedEventOption, setSelectedEventOption] = useState<string>(budgets[0]?.id || 'OTHER');
  const [customEventName, setCustomEventName] = useState('');
  const [title, setTitle] = useState('');
  const [merchantName, setMerchantName] = useState('');
  const [amount, setAmount] = useState('');
  const [expenseDate, setExpenseDate] = useState(new Date().toISOString().split('T')[0]);
  const [category, setCategory] = useState<string>(departments[0] || 'Member');
  const [phoneNumber, setPhoneNumber] = useState(profile.phone_number || '012-3456789');
  const [description, setDescription] = useState('');
  const [receiptFile, setReceiptFile] = useState<File | null>(null);
  const [aiOcrSummary, setAiOcrSummary] = useState('');
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);

  if (!isOpen) return null;

  const isOtherEvent = selectedEventOption === 'OTHER';
  const numericAmount = parseFloat(amount) || 0;

  const handleAiExtracted = (data: ExtractedReceiptData) => {
    if (data.amount) setAmount(data.amount);
    if (data.merchantName) setMerchantName(data.merchantName);
    if (data.date) setExpenseDate(data.date);
    if (data.suggestedTitle && !title) setTitle(data.suggestedTitle);
    setAiOcrSummary(data.rawSummary);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    if (isOtherEvent && !customEventName.trim()) {
      setError('Please type the name of the event or purpose.');
      return;
    }
    if (!title.trim() || numericAmount <= 0 || !receiptFile) {
      setError('Please fill in all required fields and upload a receipt.');
      return;
    }

    setSubmitting(true);
    try {
      const fileExt = receiptFile.name.split('.').pop() || 'jpg';
      const safeFileName = `${profile.id}/${Date.now()}.${fileExt}`;
      const { error: uploadError } = await supabase.storage.from('receipts').upload(safeFileName, receiptFile);
      if (uploadError) throw new Error(uploadError.message);

      const { data: publicUrlData } = supabase.storage.from('receipts').getPublicUrl(safeFileName);
      const targetBudgetId = isOtherEvent ? budgets[0]?.id || null : selectedEventOption;
      const finalDescription = isOtherEvent ? `[Other Event: ${customEventName.trim()}] ${description.trim()}` : description.trim();

      const payload: Record<string, unknown> = {
        budget_id: isOtherEvent ? null : targetBudgetId,
        custom_event_name: isOtherEvent ? customEventName.trim() : '',
        user_id: profile.id,
        claimant_name: profile.full_name,
        matric_no: profile.matric_no,
        phone_number: phoneNumber.trim(),
        title: title.trim(),
        merchant_name: merchantName.trim() || 'Vendor',
        expense_date: expenseDate,
        amount: numericAmount,
        category,
        description: finalDescription,
        receipt_url: publicUrlData.publicUrl,
        receipt_file_name: receiptFile.name,
        ai_ocr_summary: aiOcrSummary || `Receipt attached (${receiptFile.name})`,
        status: 'Pending',
      };

      const { error: insertError } = await supabase.from('claims').insert(payload);
      if (insertError) throw new Error(insertError.message);

      setTitle('');
      setCustomEventName('');
      setMerchantName('');
      setAmount('');
      setDescription('');
      setReceiptFile(null);
      onSuccess(`Claim "${title.trim()}" (RM ${numericAmount.toFixed(2)}) submitted!`);
      onClose();
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to submit claim.');
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white rounded-3xl shadow-2xl border border-emerald-100 max-w-xl w-full overflow-hidden my-8">
        <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <Receipt className="w-5 h-5 text-emerald-200" />
            <h2 className="text-base font-bold">Submit Claim</h2>
          </div>
          <button type="button" onClick={onClose} className="text-emerald-200 hover:text-white cursor-pointer"><X className="w-5 h-5" /></button>
        </div>

        <form onSubmit={handleSubmit} className="p-6 space-y-4 max-h-[82vh] overflow-y-auto">
          <ReceiptDropzone selectedFile={receiptFile} onFileSelect={setReceiptFile} onAiExtracted={handleAiExtracted} />

          <div>
            <label className="block text-xs font-bold text-slate-700 mb-1">Event / Activity *</label>
            <select value={selectedEventOption} onChange={(e) => setSelectedEventOption(e.target.value)} className="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm" required>
              {budgets.map((b) => (
                <option key={b.id} value={b.id}>{b.event_name} ({b.event_date})</option>
              ))}
              <option value="OTHER">Other (Not in activity list)</option>
            </select>
          </div>

          {isOtherEvent && (
            <div className="p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-200">
              <label className="block text-xs font-bold text-emerald-900 mb-1">Type of Event / Purpose *</label>
              <input type="text" value={customEventName} onChange={(e) => setCustomEventName(e.target.value)} placeholder="e.g., Equipment Repair, Club Meeting" className="w-full rounded-xl border border-emerald-300 bg-white px-3.5 py-2 text-sm" required />
            </div>
          )}

          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div className="sm:col-span-2">
              <label className="block text-xs font-bold text-slate-700 mb-1">Item / Claim Title *</label>
              <input type="text" value={title} onChange={(e) => setTitle(e.target.value)} placeholder="e.g., Mineral Water & Printing" className="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm" required />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Amount (RM) *</label>
              <input type="number" step="0.01" min="0.10" value={amount} onChange={(e) => setAmount(e.target.value)} placeholder="0.00" className="w-full rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold" required />
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Shop / Vendor</label>
              <input type="text" value={merchantName} onChange={(e) => setMerchantName(e.target.value)} placeholder="Optional" className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Date *</label>
              <input type="date" value={expenseDate} onChange={(e) => setExpenseDate(e.target.value)} className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" required />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Department / Unit</label>
              <select value={category} onChange={(e) => setCategory(e.target.value)} className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm">
                {departments.map((cat) => (
                  <option key={cat} value={cat}>{cat}</option>
                ))}
              </select>
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1"><Phone className="w-3.5 h-3.5 inline mr-1" />Phone Number *</label>
              <input type="tel" value={phoneNumber} onChange={(e) => setPhoneNumber(e.target.value)} className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-mono" required />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Remark</label>
              <input type="text" value={description} onChange={(e) => setDescription(e.target.value)} placeholder="Short note..." className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
            </div>
          </div>

          {error && <div className="bg-red-50 text-red-700 px-3 py-2 rounded-xl text-xs">{error}</div>}

          <div className="flex justify-end gap-2 pt-2">
            <button type="button" onClick={onClose} className="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 cursor-pointer">Cancel</button>
            <button type="submit" disabled={submitting} className="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-700 text-white cursor-pointer disabled:opacity-50">
              {submitting ? <Loader2 className="w-4 h-4 animate-spin" /> : <CheckCircle2 className="w-4 h-4" />}
              <span>Submit</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/EquipmentSection.tsx">
'use client';

import React, { useState } from 'react';
import {
  supabase,
  EquipmentItem,
  EquipmentLoan,
  UserProfile,
} from '@/lib/supabase';
import {
  Package,
  PlusCircle,
  Edit3,
  Trash2,
  CheckCircle2,
  Download,
  Phone,
  X,
  Loader2,
  ClipboardList,
} from 'lucide-react';

interface EquipmentSectionProps {
  items: EquipmentItem[];
  loans: EquipmentLoan[];
  profile: UserProfile;
  isAdmin: boolean;
  onRefresh: (msg: string) => void;
}

export default function EquipmentSection({
  items,
  loans,
  profile,
  isAdmin,
  onRefresh,
}: EquipmentSectionProps) {
  // Admin Add/Edit Equipment Inventory Modal
  const [showItemModal, setShowItemModal] = useState(false);
  const [editingItem, setEditingItem] = useState<EquipmentItem | null>(null);
  const [itemName, setItemName] = useState('');
  const [totalQty, setTotalQty] = useState('1');
  const [itemRemarks, setItemRemarks] = useState('');
  const [savingItem, setSavingItem] = useState(false);

  // Member Borrow / Admin Edit Loan Modal
  const [showLoanModal, setShowLoanModal] = useState(false);
  const [editingLoan, setEditingLoan] = useState<EquipmentLoan | null>(null);
  const [selectedEqId, setSelectedEqId] = useState(items[0]?.id || '');
  const [borrowerName, setBorrowerName] = useState(profile.full_name);
  const [matricNo, setMatricNo] = useState(profile.matric_no);
  const [phoneNumber, setPhoneNumber] = useState(profile.phone_number);
  const [loanQty, setLoanQty] = useState('1');
  const [applicationDate, setApplicationDate] = useState(
    new Date().toISOString().split('T')[0]
  );
  const [borrowDate, setBorrowDate] = useState(
    new Date().toISOString().split('T')[0]
  );
  const [returnDate, setReturnDate] = useState(
    new Date().toISOString().split('T')[0]
  );
  const [loanStatus, setLoanStatus] = useState<
    'Pending' | 'Borrowed' | 'Returned' | 'Overdue'
  >('Borrowed');
  const [loanRemarks, setLoanRemarks] = useState('');
  const [savingLoan, setSavingLoan] = useState(false);

  const openAddItem = () => {
    setEditingItem(null);
    setItemName('');
    setTotalQty('5');
    setItemRemarks('');
    setShowItemModal(true);
  };

  const openEditItem = (item: EquipmentItem) => {
    setEditingItem(item);
    setItemName(item.item_name);
    setTotalQty(String(item.total_quantity));
    setItemRemarks(item.remarks || '');
    setShowItemModal(true);
  };

  const handleSaveItem = async (e: React.FormEvent) => {
    e.preventDefault();
    setSavingItem(true);
    try {
      const payload = {
        item_name: itemName.trim(),
        total_quantity: Math.max(0, parseInt(totalQty) || 0),
        remarks: itemRemarks.trim(),
      };
      if (editingItem) {
        await supabase
          .from('equipment_items')
          .update(payload)
          .eq('id', editingItem.id);
        onRefresh('Equipment item updated!');
      } else {
        await supabase.from('equipment_items').insert(payload);
        onRefresh('New equipment added to inventory!');
      }
      setShowItemModal(false);
    } finally {
      setSavingItem(false);
    }
  };

  const handleDeleteItem = async (id: string) => {
    await supabase.from('equipment_items').delete().eq('id', id);
    onRefresh('Equipment item removed.');
  };

  const openNewBorrowApplication = (preselectId?: string) => {
    setEditingLoan(null);
    setSelectedEqId(preselectId || items[0]?.id || '');
    setBorrowerName(profile.full_name);
    setMatricNo(profile.matric_no);
    setPhoneNumber(profile.phone_number);
    setLoanQty('1');
    const today = new Date().toISOString().split('T')[0];
    setApplicationDate(today);
    setBorrowDate(today);
    setReturnDate(today);
    setLoanStatus('Borrowed');
    setLoanRemarks('');
    setShowLoanModal(true);
  };

  const openEditLoan = (loan: EquipmentLoan) => {
    setEditingLoan(loan);
    setSelectedEqId(loan.equipment_id);
    setBorrowerName(loan.borrower_name);
    setMatricNo(loan.matric_no);
    setPhoneNumber(loan.phone_number);
    setLoanQty(String(loan.quantity));
    setApplicationDate(loan.application_date);
    setBorrowDate(loan.borrow_date);
    setReturnDate(loan.return_date);
    setLoanStatus(loan.status);
    setLoanRemarks(loan.remarks || '');
    setShowLoanModal(true);
  };

  const handleSaveLoan = async (e: React.FormEvent) => {
    e.preventDefault();
    const eqObj = items.find((i) => i.id === selectedEqId);
    if (!eqObj) return;

    setSavingLoan(true);
    try {
      const payload = {
        equipment_id: eqObj.id,
        equipment_name: eqObj.item_name,
        user_id: editingLoan ? editingLoan.user_id : profile.id,
        borrower_name: borrowerName.trim(),
        matric_no: matricNo.trim().toUpperCase(),
        phone_number: phoneNumber.trim(),
        quantity: Math.max(1, parseInt(loanQty) || 1),
        application_date: applicationDate,
        borrow_date: borrowDate,
        return_date: returnDate,
        status: loanStatus,
        remarks: loanRemarks.trim(),
      };

      if (editingLoan) {
        await supabase
          .from('equipment_loans')
          .update(payload)
          .eq('id', editingLoan.id);
        onRefresh('Borrow record updated!');
      } else {
        await supabase.from('equipment_loans').insert(payload);
        onRefresh(`Borrowed ${payload.quantity}x ${eqObj.item_name}!`);
      }
      setShowLoanModal(false);
    } finally {
      setSavingLoan(false);
    }
  };

  const handleQuickMarkReturned = async (loanId: string) => {
    await supabase
      .from('equipment_loans')
      .update({ status: 'Returned' })
      .eq('id', loanId);
    onRefresh('Marked as Returned!');
  };

  const handleDeleteLoan = async (loanId: string) => {
    await supabase.from('equipment_loans').delete().eq('id', loanId);
    onRefresh('Borrow record removed.');
  };

  const exportEquipmentCsv = () => {
    const headers = [
      'Equipment Name',
      'Quantity',
      'Borrower Name',
      'Matric No',
      'Phone Number',
      'Application Date',
      'Borrow Date',
      'Return Date',
      'Status',
      'Remarks',
    ];
    const rows = loans.map((l) =>
      [
        l.equipment_name,
        l.quantity,
        l.borrower_name,
        l.matric_no,
        l.phone_number,
        l.application_date,
        l.borrow_date,
        l.return_date,
        l.status,
        l.remarks,
      ]
        .map((v) => `"${String(v || '').replace(/"/g, '""')}"`)
        .join(',')
    );
    const blob = new Blob([[headers.join(','), ...rows].join('\n')], {
      type: 'text/csv;charset=utf-8;',
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `Equipment_Borrowing_Log_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
  };

  return (
    <div className="space-y-6">
      {/* 1. EQUIPMENT INVENTORY CATALOG */}
      <div className="bg-white rounded-3xl border border-emerald-100 p-6 shadow-2xs space-y-4">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2.5">
            <div className="p-2.5 rounded-2xl bg-emerald-100 text-emerald-800">
              <Package className="w-5 h-5" />
            </div>
            <div>
              <h2 className="text-lg font-extrabold text-slate-900">
                Club Equipment Inventory &amp; Borrowing Hub
              </h2>
              <p className="text-xs text-slate-500">
                View available club equipment, condition remarks, and submit borrow requests.
              </p>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onClick={() => openNewBorrowApplication()}
              className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-700 hover:bg-emerald-800 text-white cursor-pointer"
            >
              <PlusCircle className="w-4 h-4" />
              <span>Borrow Equipment</span>
            </button>
            {isAdmin && (
              <button
                type="button"
                onClick={openAddItem}
                className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-400 hover:bg-amber-300 text-emerald-950 cursor-pointer"
              >
                <PlusCircle className="w-4 h-4" />
                <span>+ Add Inventory Item</span>
              </button>
            )}
          </div>
        </div>

        {items.length === 0 ? (
          <p className="text-xs text-slate-400 py-8 text-center">
            No equipment items listed yet.
          </p>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {items.map((item) => {
              const currentlyBorrowed = loans
                .filter(
                  (l) =>
                    l.equipment_id === item.id &&
                    (l.status === 'Borrowed' || l.status === 'Overdue')
                )
                .reduce((sum, l) => sum + Number(l.quantity), 0);
              const available = Math.max(0, item.total_quantity - currentlyBorrowed);

              return (
                <div
                  key={item.id}
                  className="p-4 rounded-2xl border border-emerald-100 bg-emerald-50/30 flex flex-col justify-between space-y-3"
                >
                  <div className="space-y-1.5">
                    <div className="flex items-start justify-between gap-2">
                      <h3 className="text-sm font-extrabold text-slate-900">
                        {item.item_name}
                      </h3>
                      {isAdmin && (
                        <div className="flex items-center gap-1 shrink-0">
                          <button
                            type="button"
                            onClick={() => openEditItem(item)}
                            className="p-1 rounded bg-white text-slate-600 hover:text-emerald-700 cursor-pointer"
                          >
                            <Edit3 className="w-3.5 h-3.5" />
                          </button>
                          <button
                            type="button"
                            onClick={() => handleDeleteItem(item.id)}
                            className="p-1 rounded bg-white text-slate-400 hover:text-rose-600 cursor-pointer"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      )}
                    </div>

                    <div className="flex items-center gap-2 text-xs">
                      <span
                        className={`px-2 py-0.5 rounded-md font-extrabold ${
                          available > 0
                            ? 'bg-emerald-100 text-emerald-800'
                            : 'bg-rose-100 text-rose-700'
                        }`}
                      >
                        Available: {available} / {item.total_quantity}
                      </span>
                    </div>

                    {item.remarks && (
                      <p className="text-xs text-slate-600 pt-1">
                        <strong>Remark:</strong> {item.remarks}
                      </p>
                    )}
                  </div>

                  <button
                    type="button"
                    disabled={available <= 0}
                    onClick={() => openNewBorrowApplication(item.id)}
                    className="w-full py-2 rounded-xl text-xs font-bold bg-white hover:bg-emerald-700 hover:text-white text-emerald-900 border border-emerald-200 transition cursor-pointer disabled:opacity-40"
                  >
                    {available > 0 ? 'Borrow This Item' : 'All Units Borrowed Out'}
                  </button>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* 2. BORROWING LOG & APPLICATION TRACKER */}
      <div className="bg-white rounded-3xl border border-emerald-100 overflow-hidden shadow-2xs">
        <div className="p-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <ClipboardList className="w-5 h-5 text-emerald-700" />
            <div>
              <h3 className="text-base font-extrabold text-slate-900">
                Equipment Borrowing Applications &amp; Return Log ({loans.length})
              </h3>
              <p className="text-xs text-slate-500">
                Tracks Application Date, Borrow Date, Return Date, Borrower Name, Phone &amp; Remarks.
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={exportEquipmentCsv}
            className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 cursor-pointer"
          >
            <Download className="w-4 h-4" />
            <span>Export Loans CSV</span>
          </button>
        </div>

        {loans.length === 0 ? (
          <div className="p-10 text-center text-xs text-slate-400">
            No equipment borrow records yet.
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse text-xs">
              <thead>
                <tr className="bg-slate-50 text-[11px] font-bold uppercase text-slate-600 border-b border-slate-100">
                  <th className="py-3 px-4">Equipment &amp; Qty</th>
                  <th className="py-3 px-4">Borrower &amp; Phone</th>
                  <th className="py-3 px-4">Applied Date</th>
                  <th className="py-3 px-4">Borrow $\rightarrow$ Return Date</th>
                  <th className="py-3 px-4">Remark</th>
                  <th className="py-3 px-4">Status</th>
                  <th className="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {loans.map((loan) => {
                  const canManage = isAdmin || loan.user_id === profile.id;
                  const cleanDigits = (loan.phone_number || '').replace(/[^0-9]/g, '');
                  const waUrl = `https://wa.me/${
                    cleanDigits.startsWith('0') ? '6' + cleanDigits : cleanDigits
                  }`;

                  return (
                    <tr key={loan.id} className="hover:bg-emerald-50/30">
                      <td className="py-3.5 px-4">
                        <div className="font-bold text-slate-900">
                          {loan.equipment_name}
                        </div>
                        <span className="text-[11px] font-extrabold text-emerald-700">
                          Qty: {loan.quantity} unit(s)
                        </span>
                      </td>
                      <td className="py-3.5 px-4">
                        <div className="font-bold text-slate-800">
                          {loan.borrower_name}{' '}
                          <span className="font-mono text-slate-400">
                            ({loan.matric_no})
                          </span>
                        </div>
                        <a
                          href={waUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="inline-flex items-center gap-1 font-mono text-[11px] text-emerald-700 hover:underline"
                        >
                          <Phone className="w-3 h-3" />
                          <span>{loan.phone_number}</span>
                        </a>
                      </td>
                      <td className="py-3.5 px-4 font-mono text-slate-600">
                        {loan.application_date}
                      </td>
                      <td className="py-3.5 px-4 font-mono">
                        <span className="font-bold text-slate-800">
                          {loan.borrow_date}
                        </span>{' '}
                        $\rightarrow${' '}
                        <span className="font-bold text-emerald-800">
                          {loan.return_date}
                        </span>
                      </td>
                      <td className="py-3.5 px-4 text-slate-600 max-w-xs">
                        {loan.remarks || '-'}
                      </td>
                      <td className="py-3.5 px-4">
                        <span
                          className={`px-2.5 py-0.5 rounded-full text-[11px] font-bold ${
                            loan.status === 'Returned'
                              ? 'bg-emerald-100 text-emerald-800'
                              : loan.status === 'Overdue'
                              ? 'bg-rose-100 text-rose-700'
                              : 'bg-amber-100 text-amber-900'
                          }`}
                        >
                          {loan.status}
                        </span>
                      </td>
                      <td className="py-3.5 px-4 text-right">
                        {canManage && (
                          <div className="inline-flex items-center gap-1">
                            {loan.status !== 'Returned' && (
                              <button
                                type="button"
                                onClick={() => handleQuickMarkReturned(loan.id)}
                                className="px-2.5 py-1 rounded-lg bg-emerald-700 text-white font-bold cursor-pointer"
                              >
                                Return
                              </button>
                            )}
                            <button
                              type="button"
                              onClick={() => openEditLoan(loan)}
                              className="p-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-emerald-50 cursor-pointer"
                              title="Edit Record"
                            >
                              <Edit3 className="w-3.5 h-3.5" />
                            </button>
                            {isAdmin && (
                              <button
                                type="button"
                                onClick={() => handleDeleteLoan(loan.id)}
                                className="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 cursor-pointer"
                                title="Delete Record"
                              >
                                <Trash2 className="w-3.5 h-3.5" />
                              </button>
                            )}
                          </div>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* MODAL 1: ADMIN ADD / EDIT INVENTORY ITEM */}
      {showItemModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4">
          <div className="bg-white rounded-3xl shadow-2xl border border-emerald-100 max-w-md w-full overflow-hidden">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-sm font-bold">
                {editingItem ? 'Edit Equipment Item' : 'Add Equipment to Inventory'}
              </h3>
              <button
                type="button"
                onClick={() => setShowItemModal(false)}
                className="text-emerald-200 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveItem} className="p-6 space-y-4 text-xs">
              <div>
                <label className="block font-bold text-slate-700 mb-1">
                  Equipment Name / Type *
                </label>
                <input
                  type="text"
                  value={itemName}
                  onChange={(e) => setItemName(e.target.value)}
                  placeholder="e.g., Portable PA System / Digital Timer"
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold"
                  required
                />
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">
                  Total Quantity Owned *
                </label>
                <input
                  type="number"
                  min="0"
                  value={totalQty}
                  onChange={(e) => setTotalQty(e.target.value)}
                  className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold"
                  required
                />
              </div>

              <div>
                <label className="block font-bold text-slate-700 mb-1">
                  Equipment Remarks / Condition Comment
                </label>
                <textarea
                  rows={2}
                  value={itemRemarks}
                  onChange={(e) => setItemRemarks(e.target.value)}
                  placeholder="e.g., Stored in Cabinet A. Handle with care."
                  className="w-full rounded-xl border border-slate-300 px-3 py-2"
                />
              </div>

              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowItemModal(false)}
                  className="px-4 py-2 rounded-xl font-semibold text-slate-600 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={savingItem}
                  className="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl font-bold bg-emerald-700 text-white cursor-pointer"
                >
                  {savingItem && <Loader2 className="w-3.5 h-3.5 animate-spin" />}
                  <span>Save Item</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* MODAL 2: BORROW APPLICATION / ADMIN EDIT LOAN */}
      {showLoanModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl shadow-2xl border border-emerald-100 max-w-lg w-full overflow-hidden my-8">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-sm font-bold">
                {editingLoan
                  ? 'Edit Equipment Borrow Record'
                  : 'Equipment Borrow Application'}
              </h3>
              <button
                type="button"
                onClick={() => setShowLoanModal(false)}
                className="text-emerald-200 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSaveLoan} className="p-6 space-y-3.5 text-xs">
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div className="sm:col-span-2">
                  <label className="block font-bold text-slate-700 mb-1">
                    Select Equipment *
                  </label>
                  <select
                    value={selectedEqId}
                    onChange={(e) => setSelectedEqId(e.target.value)}
                    className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-bold"
                    required
                  >
                    {items.map((i) => (
                      <option key={i.id} value={i.id}>
                        {i.item_name} (Total: {i.total_quantity})
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block font-bold text-slate-700 mb-1">
                    Quantity *
                  </label>
                  <input
                    type="number"
                    min="1"
                    value={loanQty}
                    onChange={(e) => setLoanQty(e.target.value)}
                    className="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold"
                    required
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 mb-1">
                    Borrower Name *
                  </label>
                  <input
                    type="text"
                    value={borrowerName}
                    onChange={(e) => setBorrowerName(e.target.value)}
                    className="w-full rounded-xl border border-slate-300 px-3 py-2"
                    required
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">
                    Matric No. *
                  </label>
                  <input
                    type="text"
                    value={matricNo}
                    onChange={(e) => setMatricNo(e.target.value)}
                    className="w-full rounded-xl border border-slate-300 px-3 py-2 font-mono"
                    required
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 mb-1">
                    Phone Number *
                  </label>
                  <input
                    type="tel"
                    value={phoneNumber}
                    onChange={(e) => setPhoneNumber(e.target.value)}
                    className="w-full rounded-xl border border-slate-300 px-3 py-2 font-mono"
                    required
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3 rounded-2xl bg-emerald-50/60 border border-emerald-200">
                <div>
                  <label className="block font-bold text-emerald-950 mb-1">
                    Application Date *
                  </label>
                  <input
                    type="date"
                    value={applicationDate}
                    onChange={(e) => setApplicationDate(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 bg-white px-2.5 py-1.5"
                    required
                  />
                </div>
                <div>
                  <label className="block font-bold text-emerald-950 mb-1">
                    Borrow Date *
                  </label>
                  <input
                    type="date"
                    value={borrowDate}
                    onChange={(e) => setBorrowDate(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 bg-white px-2.5 py-1.5"
                    required
                  />
                </div>
                <div>
                  <label className="block font-bold text-emerald-950 mb-1">
                    Return Date *
                  </label>
                  <input
                    type="date"
                    value={returnDate}
                    onChange={(e) => setReturnDate(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 bg-white px-2.5 py-1.5"
                    required
                  />
                </div>
              </div>

              {isAdmin && (
                <div>
                  <label className="block font-bold text-slate-700 mb-1">
                    Loan Status
                  </label>
                  <select
                    value={loanStatus}
                    onChange={(e) =>
                      setLoanStatus(
                        e.target.value as
                          | 'Pending'
                          | 'Borrowed'
                          | 'Returned'
                          | 'Overdue'
                      )
                    }
                    className="w-full rounded-xl border border-slate-300 bg-white px-3 py-2 font-bold"
                  >
                    <option value="Pending">Pending</option>
                    <option value="Borrowed">Borrowed</option>
                    <option value="Returned">Returned</option>
                    <option value="Overdue">Overdue</option>
                  </select>
                </div>
              )}

              <div>
                <label className="block font-bold text-slate-700 mb-1">
                  Purpose / Condition Remarks
                </label>
                <input
                  type="text"
                  value={loanRemarks}
                  onChange={(e) => setLoanRemarks(e.target.value)}
                  placeholder="e.g., Borrowed for Kolej booth setup..."
                  className="w-full rounded-xl border border-slate-300 px-3 py-2"
                />
              </div>

              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowLoanModal(false)}
                  className="px-4 py-2 rounded-xl font-semibold text-slate-600 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={savingLoan}
                  className="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl font-bold bg-emerald-700 text-white cursor-pointer"
                >
                  {savingLoan ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="w-4 h-4" />
                  )}
                  <span>{editingLoan ? 'Save Changes' : 'Confirm Borrow'}</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/EventOperationsModal.tsx">
'use client';

import React, { useState, useEffect, useRef } from 'react';
import { supabase, Budget, UserProfile, EventRsvp, ActivityFeePayment, AdminPermissions, PassApprovalRule, isEntryPassMode, MAX_FILE_SIZE_BYTES } from '@/lib/supabase';
import { X, CheckCircle2, ExternalLink, Download, Copy, RefreshCw, Ticket, ShieldCheck, Lock, Camera, QrCode } from 'lucide-react';

interface EventOperationsModalProps {
  event: Budget | null; initialTab: 'fee' | 'transport' | 'qr' | 'pass'; profile: UserProfile;
  isAdmin: boolean; permissions: AdminPermissions; rsvps: EventRsvp[]; feePayments: ActivityFeePayment[];
  onClose: () => void; onOpenScanner?: () => void; onRefresh: (msg: string) => void;
}

type TransportSurveyChoice = 'OWN' | 'One-Way' | 'Return Trip' | 'Round Trip' | 'DRIVER';

export default function EventOperationsModal({
  event, initialTab, profile, isAdmin, permissions, rsvps, feePayments, onClose, onOpenScanner, onRefresh,
}: EventOperationsModalProps) {
  const [tab, setTab] = useState<'fee' | 'transport' | 'qr' | 'pass'>(initialTab);
  const [amountPaid, setAmountPaid] = useState('0');
  const [feeFile, setFeeFile] = useState<File | null>(null);
  const [submittingFee, setSubmittingFee] = useState(false);
  const [surveyChoice, setSurveyChoice] = useState<TransportSurveyChoice>('OWN');
  const [dormitoryInput, setDormitoryInput] = useState('');
  const [carDetails, setCarDetails] = useState('');
  const [seatsAvailable, setSeatsAvailable] = useState('4');
  const [tripsCount, setTripsCount] = useState('1');
  const [qrToken, setQrToken] = useState('');
  const [hasEntryPass, setHasEntryPass] = useState(false);
  const [passRule, setPassRule] = useState<PassApprovalRule>('auto_after_payment');
  const [localPassOverrides, setLocalPassOverrides] = useState<Record<string, boolean>>({});

  // Only initialize when opening a new event ID so granting a pass NEVER resets or jumps out of the tab
  const lastEventIdRef = useRef<string | null>(null);
  useEffect(() => {
    if (!event) {
      lastEventIdRef.current = null;
      return;
    }
    if (lastEventIdRef.current === event.id) return;
    lastEventIdRef.current = event.id;

    setLocalPassOverrides({});
    const feeVal = Number(event.registration_fee || 0);
    setAmountPaid(String(feeVal));
    setQrToken(event.qr_code_token || event.id.slice(0, 6).toUpperCase());

    const savedMode =
      (typeof window !== 'undefined' ? localStorage.getItem(`clubsync_qrmode_${event.id}`) : null) ||
      event.ticket_qr_mode ||
      (feeVal > 0 ? 'entry_pass' : 'scan_attendance');
    const entryPassActive = isEntryPassMode(savedMode);
    setHasEntryPass(entryPassActive);

    const savedRule =
      (typeof window !== 'undefined' ? (localStorage.getItem(`clubsync_passrule_${event.id}`) as PassApprovalRule | null) : null) ||
      (savedMode === 'manual_only' ? 'manual_only' : 'auto_after_payment');
    setPassRule(savedRule);

    if (initialTab === 'pass' && !entryPassActive) setTab(isAdmin ? 'qr' : 'transport');
    else if (initialTab === 'fee' && feeVal <= 0 && !isAdmin) setTab('transport');
    else setTab(initialTab);

    const cur = rsvps.find((r) => r.budget_id === event.id && r.user_id === profile.id);
    setSurveyChoice(cur?.is_driver ? 'DRIVER' : cur?.transport_type && cur.transport_type !== 'None' ? cur.transport_type : 'OWN');
    setCarDetails(cur?.car_details || '');
    setSeatsAvailable(String(cur?.seats_available ?? 4));
    setTripsCount(String(cur?.trips_count ?? 1));
    setDormitoryInput(cur?.dormitory || profile.dormitory || '');
  }, [event, initialTab, isAdmin, rsvps, profile.id, profile.dormitory]);

  if (!event) return null;

  const myRsvp = rsvps.find((r) => r.budget_id === event.id && r.user_id === profile.id);
  const eventRsvps = rsvps.filter((r) => r.budget_id === event.id);
  const attendingRsvps = eventRsvps.filter((r) => r.attendance === 'Attending');
  const qrCheckedInList = eventRsvps.filter((r) => r.qr_checked_in);
  const passengers = attendingRsvps.filter((r) => r.transport_type !== 'None' && !r.is_driver);
  const eventDrivers = attendingRsvps.filter((r) => r.is_driver);
  const eventPayments = feePayments.filter((f) => f.budget_id === event.id);
  const allowancePerTrip = Number(event.driver_allowance_per_trip || 0);
  const reqFee = Number(event.registration_fee || 0);
  const requiresFee = reqFee > 0;

  const isMemberEligibleForPass = (rsvp?: EventRsvp) => {
    if (!rsvp || rsvp.attendance !== 'Attending') return false;
    if (localPassOverrides[rsvp.id] !== undefined) return localPassOverrides[rsvp.id];
    if (rsvp.pass_approved === true) return true;
    if (passRule === 'auto_after_payment' && requiresFee) {
      return eventPayments.some((f) => f.user_id === rsvp.user_id && f.status === 'Verified');
    }
    return false;
  };

  const myPassEligible = isMemberEligibleForPass(myRsvp);
  const myPassPayload = `CLUBSYNC_PASS::v1::${event.id}::${profile.id}::${qrToken}`;
  const myPassQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&data=${encodeURIComponent(myPassPayload)}`;
  const venueQrPayload = `CLUBSYNC_QR::v1::${event.id}::${qrToken}`;
  const venueQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&data=${encodeURIComponent(venueQrPayload)}`;

  const handleToggleManualPass = async (rsvp: EventRsvp) => {
    const nextVal = !isMemberEligibleForPass(rsvp);
    setLocalPassOverrides((prev) => ({ ...prev, [rsvp.id]: nextVal }));
    await supabase.from('event_rsvps').update({ pass_approved: nextVal }).eq('id', rsvp.id);
    onRefresh(`${nextVal ? 'Granted' : 'Locked'} pass for ${rsvp.student_name}.`);
  };

  const handlePayFeeSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const numAmt = parseFloat(amountPaid) || 0;
    if (numAmt <= 0 || !feeFile || feeFile.size > MAX_FILE_SIZE_BYTES) return;
    setSubmittingFee(true);
    try {
      const path = `fees/${event.id}/${profile.id}-${Date.now()}.${feeFile.name.split('.').pop() || 'jpg'}`;
      const { error } = await supabase.storage.from('receipts').upload(path, feeFile);
      if (!error) {
        const receiptUrl = supabase.storage.from('receipts').getPublicUrl(path).data.publicUrl;
        await supabase.from('event_rsvps').upsert({
          budget_id: event.id, user_id: profile.id, student_name: profile.full_name,
          matric_no: profile.matric_no, phone_number: profile.phone_number,
          member_type: profile.member_type || 'Member', dormitory: profile.dormitory || '',
          attendance: 'Attending', transport_type: myRsvp?.transport_type || 'None',
        }, { onConflict: 'budget_id,user_id' });

        await supabase.from('activity_fee_payments').insert({
          budget_id: event.id, user_id: profile.id, student_name: profile.full_name,
          matric_no: profile.matric_no, phone_number: profile.phone_number, amount_paid: numAmt,
          receipt_url: receiptUrl, receipt_file_name: feeFile.name, status: 'Verified',
        });
        setFeeFile(null);
        if (hasEntryPass) setTab('pass');
        onRefresh('Fee payment submitted!');
      }
    } finally {
      setSubmittingFee(false);
    }
  };

  const handleSaveTransportForm = async (e: React.FormEvent) => {
    e.preventDefault();
    const isDriving = surveyChoice === 'DRIVER';
    const nextTransport = surveyChoice === 'OWN' || surveyChoice === 'DRIVER' ? 'None' : surveyChoice;
    await supabase.from('event_rsvps').upsert({
      budget_id: event.id, user_id: profile.id, student_name: profile.full_name,
      matric_no: profile.matric_no, phone_number: profile.phone_number, member_type: profile.member_type || 'Member',
      dormitory: dormitoryInput.trim() || profile.dormitory || '', attendance: 'Attending',
      transport_type: nextTransport, is_driver: isDriving, car_details: isDriving ? carDetails.trim() : '',
      seats_available: isDriving ? Math.max(1, parseInt(seatsAvailable) || 4) : 0,
      trips_count: isDriving ? Math.max(1, parseInt(tripsCount) || 1) : 0,
      assigned_driver_name: nextTransport === 'None' ? '' : myRsvp?.assigned_driver_name || '',
      updated_at: new Date().toISOString(),
    }, { onConflict: 'budget_id,user_id' });
    onRefresh('Carpool choice saved!');
  };

  const exportCsv = (filename: string, headers: string[], rows: (string | number)[][]) => {
    const csv = [headers.join(','), ...rows.map((r) => r.map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' })); a.download = filename; a.click();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/75 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white text-slate-900 rounded-3xl shadow-2xl border max-w-4xl w-full overflow-hidden my-8">
        <div className="bg-slate-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2.5">
            {hasEntryPass ? <Ticket className="w-5 h-5 text-emerald-400" /> : <QrCode className="w-5 h-5 text-emerald-400" />}
            <div><h2 className="text-base font-bold">{event.event_name}</h2><p className="text-xs text-slate-400">{event.event_date} • {event.location}</p></div>
          </div>
          <div className="flex items-center gap-2">
            <div className="flex flex-wrap bg-slate-800 p-1 rounded-xl text-xs">
              {hasEntryPass && (
                <button type="button" onClick={() => setTab('pass')} className={`px-3 py-1.5 rounded-lg font-bold cursor-pointer ${tab === 'pass' ? 'bg-emerald-600 text-white' : 'text-slate-300'}`}>Entry Pass</button>
              )}
              {isAdmin && (
                <button type="button" onClick={() => setTab('qr')} className={`px-3 py-1.5 rounded-lg font-bold cursor-pointer ${tab === 'qr' ? 'bg-emerald-600 text-white' : 'text-slate-300'}`}>Venue QR ({qrCheckedInList.length})</button>
              )}
              {(requiresFee || isAdmin) && (
                <button type="button" onClick={() => setTab('fee')} className={`px-3 py-1.5 rounded-lg font-bold cursor-pointer ${tab === 'fee' ? 'bg-emerald-600 text-white' : 'text-slate-300'}`}>Fee (RM {reqFee.toFixed(0)})</button>
              )}
              <button type="button" onClick={() => setTab('transport')} className={`px-3 py-1.5 rounded-lg font-bold cursor-pointer ${tab === 'transport' ? 'bg-emerald-600 text-white' : 'text-slate-300'}`}>Carpool ({passengers.length}P / {eventDrivers.length}D)</button>
            </div>
            <button type="button" onClick={onClose} className="text-slate-400 hover:text-white cursor-pointer ml-1"><X className="w-5 h-5" /></button>
          </div>
        </div>

        <div className="p-6 max-h-[75vh] overflow-y-auto space-y-6 text-xs">
          {tab === 'pass' && hasEntryPass && (
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <div className="lg:col-span-5 bg-gradient-to-b from-slate-900 to-emerald-950 text-white rounded-3xl p-6 flex flex-col items-center text-center justify-between shadow-xl border border-emerald-700/40">
                <div className="space-y-1">
                  <span className="px-3 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-600 text-white">Entry Pass</span>
                  <h3 className="text-base font-extrabold mt-1">{event.event_name}</h3>
                </div>
                {myPassEligible ? (
                  <div className="my-4 p-3.5 bg-white rounded-3xl shadow-lg border-4 border-emerald-500">
                    <img src={myPassQrUrl} alt="Entry Pass QR" className="w-48 h-48 object-contain mx-auto" />
                    <div className="mt-2 pt-2 border-t text-slate-900"><p className="font-extrabold text-xs">{profile.full_name}</p><p className="font-mono text-[11px] text-slate-500">{profile.matric_no}</p></div>
                  </div>
                ) : (
                  <div className="my-5 p-5 rounded-2xl bg-white/10 border border-white/15 space-y-3 w-full">
                    <Lock className="w-8 h-8 text-amber-300 mx-auto" />
                    <p className="text-xs font-extrabold">Entry Pass Locked</p>
                    {requiresFee && passRule === 'auto_after_payment' ? (
                      <>
                        <p className="text-[11px] text-emerald-100">Pay the RM {reqFee.toFixed(2)} activity fee to unlock your Entry Pass QR automatically:</p>
                        <button type="button" onClick={() => setTab('fee')} className="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold cursor-pointer">
                          Pay RM {reqFee.toFixed(2)} Fee $\rightarrow$
                        </button>
                      </>
                    ) : (
                      <p className="text-[11px] text-emerald-100">Your Entry Pass QR will appear here once granted by the Admin.</p>
                    )}
                  </div>
                )}
                <div className="w-full pt-3 border-t border-white/15 flex justify-between text-[11px]">
                  <span className="text-emerald-200">Status:</span>
                  <span className="font-extrabold">{myRsvp?.qr_checked_in ? '✓ ATTENDED' : myPassEligible ? '✓ PASS READY' : '✗ LOCKED'}</span>
                </div>
              </div>

              <div className="lg:col-span-7 space-y-4">
                {isAdmin && onOpenScanner && (
                  <div className="p-4 rounded-2xl bg-slate-900 text-white flex items-center justify-between gap-3">
                    <div><h4 className="font-extrabold text-emerald-400"><Camera className="w-4 h-4 inline mr-1" />Scan Entry Pass QR</h4><p className="text-[11px] text-slate-300">Automatically verifies eligibility and records attendance.</p></div>
                    <button type="button" onClick={() => { onClose(); onOpenScanner(); }} className="px-4 py-2 rounded-xl bg-emerald-600 text-white font-extrabold cursor-pointer">Scan Pass</button>
                  </div>
                )}
                <div className="border rounded-2xl overflow-hidden">
                  <table className="w-full text-left border-collapse">
                    <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Member</th>{requiresFee && <th className="py-2 px-3">Fee</th>}<th className="py-2 px-3">Pass Status</th>{isAdmin && <th className="py-2 px-3 text-right">Action</th>}</tr></thead>
                    <tbody className="divide-y">
                      {attendingRsvps.map((r) => {
                        const paid = eventPayments.find((f) => f.user_id === r.user_id && f.status === 'Verified');
                        const hasPass = isMemberEligibleForPass(r);
                        return (
                          <tr key={r.id}>
                            <td className="py-2 px-3 font-bold">{r.student_name} ({r.matric_no})</td>
                            {requiresFee && <td className="py-2 px-3">{paid ? <span className="text-emerald-700 font-bold">Paid ✓</span> : <span className="text-amber-700 font-bold">Unpaid</span>}</td>}
                            <td className="py-2 px-3">{r.qr_checked_in ? <span className="px-2 py-0.5 rounded-full bg-emerald-600 text-white font-bold text-[10px]"><ShieldCheck className="w-3 h-3 inline mr-0.5" />Attended</span> : hasPass ? <span className="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">✓ Unlocked</span> : <span className="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-bold text-[10px]">Locked</span>}</td>
                            {isAdmin && <td className="py-2 px-3 text-right"><button type="button" onClick={() => handleToggleManualPass(r)} className={`px-2.5 py-1 rounded-lg font-bold cursor-pointer ${hasPass ? 'bg-rose-50 text-rose-700' : 'bg-emerald-600 text-white'}`}>{hasPass ? 'Lock' : 'Grant Pass'}</button></td>}
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {tab === 'qr' && isAdmin && (
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <div className="lg:col-span-5 bg-slate-50 border rounded-3xl p-5 flex flex-col items-center text-center space-y-3">
                <span className="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-600 text-white">Venue Attendance QR</span>
                <div className="p-3 bg-white rounded-3xl border-2 border-emerald-600"><img src={venueQrUrl} alt="Event QR" className="w-52 h-52 object-contain" /></div>
                <p className="text-[11px] text-slate-500">Members scan this QR code to automatically record attendance.</p>
                {permissions.can_manage_activities && <button type="button" onClick={async () => { const tok = Math.random().toString(36).substring(2, 10).toUpperCase(); await supabase.from('budgets').update({ qr_code_token: tok }).eq('id', event.id); setQrToken(tok); onRefresh('Reset QR!'); }} className="px-4 py-2 rounded-xl font-bold bg-slate-200 text-slate-800 cursor-pointer"><RefreshCw className="w-3.5 h-3.5 inline mr-1" />Reset QR</button>}
              </div>
              <div className="lg:col-span-7 space-y-3">
                <div className="flex justify-between"><h3 className="text-sm font-extrabold">Recorded Attendance ({qrCheckedInList.length})</h3><button type="button" onClick={() => exportCsv(`${event.event_name}_Attendance.csv`, ['Name', 'Matric', 'Phone', 'Department', 'Time'], qrCheckedInList.map((r) => [r.student_name, r.matric_no, r.phone_number, r.member_type, r.qr_checked_in_at || 'Verified']))} className="px-3 py-1 rounded-xl bg-slate-100 text-slate-800 font-bold cursor-pointer"><Download className="w-3.5 h-3.5 inline mr-1" />Export CSV</button></div>
                <div className="border rounded-2xl overflow-hidden">
                  <table className="w-full text-left border-collapse">
                    <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Student</th><th className="py-2 px-3">Department</th><th className="py-2 px-3 text-right">Time</th></tr></thead>
                    <tbody className="divide-y">{qrCheckedInList.map((r) => (<tr key={r.id}><td className="py-2 px-3 font-bold">{r.student_name} ({r.matric_no})</td><td className="py-2 px-3">{r.member_type}</td><td className="py-2 px-3 text-right font-mono">{r.qr_checked_in_at ? new Date(r.qr_checked_in_at).toLocaleTimeString() : 'Verified'}</td></tr>))}</tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {tab === 'fee' && (requiresFee || isAdmin) && (
            <div className="grid grid-cols-1 lg:grid-cols-5 gap-6">
              <form onSubmit={handlePayFeeSubmit} className="lg:col-span-2 bg-slate-50 border rounded-2xl p-5 space-y-3 self-start">
                <h3 className="text-sm font-extrabold">Fee Payment (RM {reqFee.toFixed(2)})</h3>
                {hasEntryPass && passRule === 'auto_after_payment' && <p className="text-[11px] text-emerald-700 font-semibold">Your Entry Pass QR unlocks automatically after payment submission.</p>}
                <input type="number" step="0.01" value={amountPaid} onChange={(e) => setAmountPaid(e.target.value)} className="w-full rounded-xl border bg-white px-3 py-2 font-bold" required />
                <input type="file" accept="image/*,application/pdf" onChange={(e) => setFeeFile(e.target.files?.[0] || null)} className="w-full" required />
                <button type="submit" disabled={submittingFee} className="w-full py-2.5 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer"><CheckCircle2 className="w-4 h-4 inline mr-1" />{submittingFee ? 'Uploading...' : 'Submit Payment'}</button>
              </form>
              <div className="lg:col-span-3 space-y-3">
                <h3 className="text-sm font-extrabold">Fee Submissions ({eventPayments.length})</h3>
                <div className="border rounded-2xl overflow-hidden">
                  <table className="w-full text-left border-collapse">
                    <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Student</th><th className="py-2 px-3">Amount</th><th className="py-2 px-3">Status</th><th className="py-2 px-3 text-right">Receipt</th></tr></thead>
                    <tbody className="divide-y">{eventPayments.filter((p) => isAdmin || p.user_id === profile.id).map((p) => (<tr key={p.id}><td className="py-2 px-3 font-bold">{p.student_name}</td><td className="py-2 px-3 font-extrabold text-emerald-700">RM {Number(p.amount_paid).toFixed(2)}</td><td className="py-2 px-3">{p.status}</td><td className="py-2 px-3 text-right"><a href={p.receipt_url} target="_blank" rel="noopener noreferrer" className="text-emerald-700 font-bold"><ExternalLink className="w-3.5 h-3.5 inline" /></a></td></tr>))}</tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {tab === 'transport' && (
            <div className="space-y-5">
              <div className="flex justify-between items-center bg-slate-50 p-3.5 rounded-2xl border">
                <span className="font-bold text-slate-800">Passengers: {passengers.length} • Drivers: {eventDrivers.length}</span>
                <div className="flex gap-1.5">
                  <button type="button" onClick={() => { const lines = eventDrivers.map((d, i) => `Car ${i + 1}: ${d.student_name} (${d.car_details}) -> ` + passengers.filter((p) => p.assigned_driver_name === d.student_name).map((p) => `${p.student_name} (${p.dormitory})`).join(', ')); navigator.clipboard.writeText(lines.join('\n')); onRefresh('Copied WhatsApp list!'); }} className="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-bold cursor-pointer"><Copy className="w-3 h-3 inline mr-1" />Copy List</button>
                  <button type="button" onClick={() => exportCsv(`${event.event_name}_Carpool.csv`, ['Passenger', 'Matric', 'Phone', 'Dorm', 'Trip', 'Driver'], passengers.map((p) => [p.student_name, p.matric_no, p.phone_number, p.dormitory, p.transport_type, p.assigned_driver_name || 'Unassigned']))} className="px-3 py-1.5 rounded-xl bg-white border font-bold cursor-pointer">Export CSV</button>
                </div>
              </div>
              <form onSubmit={handleSaveTransportForm} className="p-4 rounded-2xl border border-slate-200 space-y-3">
                <div className="grid grid-cols-2 sm:grid-cols-5 gap-2">
                  {(['OWN', 'One-Way', 'Return Trip', 'Round Trip', ...(event.driver_recruitment_open || isAdmin ? (['DRIVER'] as const) : [])] as TransportSurveyChoice[]).map((opt) => (
                    <button type="button" key={opt} onClick={() => setSurveyChoice(opt)} className={`p-2 rounded-xl border font-bold cursor-pointer transition ${surveyChoice === opt ? 'bg-slate-900 text-white border-slate-900' : 'bg-slate-50 text-slate-700 hover:bg-slate-100'}`}>{opt === 'OWN' ? 'Own Transport' : opt === 'DRIVER' ? `Driver (RM ${allowancePerTrip}/trip)` : `Need: ${opt}`}</button>
                  ))}
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-4 gap-2">
                  <input type="text" value={dormitoryInput} onChange={(e) => setDormitoryInput(e.target.value)} placeholder="Pickup Dorm (e.g., KTDI M17)" className="rounded-xl border px-3 py-2 font-bold" />
                  {surveyChoice === 'DRIVER' && (
                    <>
                      <input type="text" value={carDetails} onChange={(e) => setCarDetails(e.target.value)} placeholder="Car & Plate *" className="rounded-xl border px-3 py-2" required />
                      <input type="number" min="1" value={seatsAvailable} onChange={(e) => setSeatsAvailable(e.target.value)} placeholder="Seats *" className="rounded-xl border px-3 py-2 font-bold" required />
                      <input type="number" min="1" value={tripsCount} onChange={(e) => setTripsCount(e.target.value)} placeholder="Trips *" className="rounded-xl border px-3 py-2 font-bold" required />
                    </>
                  )}
                </div>
                <div className="flex justify-end"><button type="submit" className="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold cursor-pointer">Save Carpool</button></div>
              </form>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/LedgerSection.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import {
  supabase,
  UserProfile,
  Claim,
  ActivityFeePayment,
  MAX_FILE_SIZE_BYTES,
} from '@/lib/supabase';
import {
  Wallet,
  TrendingUp,
  TrendingDown,
  PlusCircle,
  Download,
  ExternalLink,
  X,
  CheckCircle2,
  Loader2,
  Edit3,
  Trash2,
} from 'lucide-react';

export interface LedgerEntryItem {
  id: string;
  entry_type: 'IN' | 'OUT';
  title: string;
  category: string;
  event_name?: string;
  amount: number;
  entry_date: string;
  person_in_charge: string;
  notes: string;
  attachment_url?: string;
  attachment_name?: string;
  created_at: string;
}

interface LedgerSectionProps {
  entries: LedgerEntryItem[];
  events?: { id: string; event_name: string }[];
  claims: Claim[];
  feePayments?: ActivityFeePayment[];
  profile: UserProfile;
  canEdit?: boolean;
  externalOpenModal?: boolean;
  onCloseExternalModal?: () => void;
  onRefresh: (msg: string) => void;
}

export default function LedgerSection({
  entries,
  events = [],
  claims,
  feePayments = [],
  profile,
  canEdit = true,
  externalOpenModal = false,
  onCloseExternalModal,
  onRefresh,
}: LedgerSectionProps) {
  const [showModal, setShowModal] = useState(false);
  const [editingEntry, setEditingEntry] = useState<LedgerEntryItem | null>(null);
  const [entryType, setEntryType] = useState<'IN' | 'OUT'>('IN');
  const [title, setTitle] = useState('');
  const [category, setCategory] = useState('Club Savings / Opening Balance');
  const [selectedEventOption, setSelectedEventOption] = useState<string>('GENERAL');
  const [customEventName, setCustomEventName] = useState('');
  const [amount, setAmount] = useState('');
  const [entryDate, setEntryDate] = useState(
    new Date().toISOString().split('T')[0]
  );
  const [notes, setNotes] = useState('');
  const [attachmentFile, setAttachmentFile] = useState<File | null>(null);
  const [saving, setSaving] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  useEffect(() => {
    if (externalOpenModal && canEdit) {
      openAddModal();
      if (onCloseExternalModal) onCloseExternalModal();
    }
  }, [externalOpenModal, canEdit, onCloseExternalModal]);

  const openAddModal = () => {
    setEditingEntry(null);
    setEntryType('IN');
    setTitle('');
    setCategory('Club Savings / Opening Balance');
    setSelectedEventOption('GENERAL');
    setCustomEventName('');
    setAmount('');
    setEntryDate(new Date().toISOString().split('T')[0]);
    setNotes('');
    setAttachmentFile(null);
    setErrorMsg(null);
    setShowModal(true);
  };

  const openEditModal = (entry: LedgerEntryItem) => {
    setEditingEntry(entry);
    setEntryType(entry.entry_type);
    setTitle(entry.title);
    setCategory(entry.category);
    setSelectedEventOption('OTHER');
    setCustomEventName(entry.event_name || 'General Club Fund');
    setAmount(String(entry.amount));
    setEntryDate(entry.entry_date);
    setNotes(entry.notes || '');
    setAttachmentFile(null);
    setErrorMsg(null);
    setShowModal(true);
  };

  const manualIn = entries
    .filter((e) => e.entry_type === 'IN')
    .reduce((s, e) => s + Number(e.amount), 0);
  const verifiedFeesIn = feePayments
    .filter((f) => f.status !== 'Rejected')
    .reduce((s, f) => s + Number(f.amount_paid), 0);
  const totalIn = manualIn + verifiedFeesIn;

  const manualOut = entries
    .filter((e) => e.entry_type === 'OUT')
    .reduce((s, e) => s + Number(e.amount), 0);
  const approvedClaimsOut = claims
    .filter((c) => c.status === 'Approved')
    .reduce((s, c) => s + Number(c.amount), 0);
  const totalOut = manualOut + approvedClaimsOut;
  const currentSavingsBalance = totalIn - totalOut;

  const handleSaveEntry = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!canEdit) return;
    setErrorMsg(null);
    const num = parseFloat(amount);
    if (!title.trim() || isNaN(num) || num <= 0) return;

    const finalEventName =
      selectedEventOption === 'GENERAL'
        ? 'General Club Fund'
        : selectedEventOption === 'OTHER'
        ? customEventName.trim() || 'Other Event'
        : selectedEventOption;

    setSaving(true);
    try {
      let attachmentUrl = editingEntry?.attachment_url || '';
      let attachmentName = editingEntry?.attachment_name || '';

      if (attachmentFile) {
        if (attachmentFile.size > MAX_FILE_SIZE_BYTES) {
          throw new Error('File exceeds 50 MB limit.');
        }
        const ext = attachmentFile.name.split('.').pop() || 'pdf';
        const safePath = `ledger/${Date.now()}.${ext}`;
        const { error: upErr } = await supabase.storage
          .from('receipts')
          .upload(safePath, attachmentFile);
        if (upErr) throw upErr;
        attachmentUrl = supabase.storage.from('receipts').getPublicUrl(safePath)
          .data.publicUrl;
        attachmentName = attachmentFile.name;
      }

      const payload = {
        entry_type: entryType,
        title: title.trim(),
        category,
        event_name: finalEventName,
        amount: num,
        entry_date: entryDate,
        person_in_charge: `${profile.full_name} (${profile.matric_no})`,
        notes: notes.trim(),
        attachment_url: attachmentUrl,
        attachment_name: attachmentName,
      };

      if (editingEntry) {
        const { error } = await supabase
          .from('ledger_entries')
          .update(payload)
          .eq('id', editingEntry.id);
        if (error) throw error;
        onRefresh(`Updated "${title.trim()}"!`);
      } else {
        const { error } = await supabase.from('ledger_entries').insert(payload);
        if (error) throw error;
        onRefresh(`Recorded RM ${num.toFixed(2)}!`);
      }
      setShowModal(false);
    } catch (err: unknown) {
      setErrorMsg(err instanceof Error ? err.message : 'Failed to save.');
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteEntry = async (entry: LedgerEntryItem) => {
    if (!canEdit) return;
    await supabase.from('ledger_entries').delete().eq('id', entry.id);
    onRefresh(`Deleted "${entry.title}".`);
  };

  const exportFullLedgerCsv = () => {
    const headers = [
      'Date',
      'Type',
      'Event',
      'Title',
      'Category',
      'Amount (RM)',
      'Recorded By',
      'Proof URL',
    ];
    const manualRows = entries.map((e) => [
      e.entry_date,
      e.entry_type === 'IN' ? 'MONEY IN' : 'MONEY OUT',
      e.event_name || 'General',
      e.title,
      e.category,
      Number(e.amount).toFixed(2),
      e.person_in_charge,
      e.attachment_url || '-',
    ]);
    const feeRows = feePayments
      .filter((f) => f.status !== 'Rejected')
      .map((f) => [
        f.created_at.split('T')[0],
        'FEE IN',
        'Activity Fee',
        `Fee - ${f.student_name}`,
        'Registration Fee',
        Number(f.amount_paid).toFixed(2),
        f.student_name,
        f.receipt_url,
      ]);
    const claimRows = claims
      .filter((c) => c.status === 'Approved')
      .map((c) => [
        c.expense_date,
        'CLAIM OUT',
        c.custom_event_name || 'Event Claim',
        c.title,
        c.category,
        Number(c.amount).toFixed(2),
        c.claimant_name,
        c.receipt_url,
      ]);
    const allRows = [...manualRows, ...feeRows, ...claimRows].map((r) =>
      r.map((v) => `"${String(v || '').replace(/"/g, '""')}"`).join(',')
    );
    const blob = new Blob([[headers.join(','), ...allRows].join('\n')], {
      type: 'text/csv;charset=utf-8;',
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `Club_Finance_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
  };

  return (
    <div className="space-y-6">
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="bg-emerald-800 text-white rounded-3xl p-5 shadow-md">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold uppercase text-emerald-200">
              Current Club Savings
            </span>
            <Wallet className="w-5 h-5 text-emerald-300" />
          </div>
          <p className="text-2xl font-extrabold mt-2">
            RM {currentSavingsBalance.toFixed(2)}
          </p>
          <p className="text-[11px] text-emerald-200 mt-1">
            Total In minus Total Out
          </p>
        </div>

        <div className="bg-white rounded-3xl p-5 border border-emerald-200 shadow-xs">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold uppercase text-slate-500">
              Total Money In
            </span>
            <TrendingUp className="w-5 h-5 text-emerald-700" />
          </div>
          <p className="text-2xl font-extrabold text-emerald-700 mt-2">
            + RM {totalIn.toFixed(2)}
          </p>
          <p className="text-[11px] text-slate-500 mt-1">
            Includes RM {verifiedFeesIn.toFixed(2)} activity fees
          </p>
        </div>

        <div className="bg-white rounded-3xl p-5 border border-rose-200 shadow-xs">
          <div className="flex items-center justify-between">
            <span className="text-xs font-bold uppercase text-slate-500">
              Total Money Out
            </span>
            <TrendingDown className="w-5 h-5 text-rose-600" />
          </div>
          <p className="text-2xl font-extrabold text-rose-600 mt-2">
            - RM {totalOut.toFixed(2)}
          </p>
          <p className="text-[11px] text-slate-500 mt-1">
            Includes RM {approvedClaimsOut.toFixed(2)} approved claims
          </p>
        </div>
      </div>

      <div className="bg-white rounded-3xl border border-emerald-200 shadow-xs overflow-hidden">
        <div className="p-5 border-b border-emerald-100 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 className="text-base font-extrabold text-emerald-950">
              Club Financial Ledger
            </h2>
            <p className="text-xs text-slate-500">
              {canEdit
                ? 'Add, edit, or delete club funds and expense records.'
                : 'View-Only Admin Mode: Ask the Club Owner for Finance permission to add or edit records.'}
            </p>
          </div>
          <div className="flex gap-2">
            {canEdit && (
              <button
                type="button"
                onClick={openAddModal}
                className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-700 text-white cursor-pointer"
              >
                <PlusCircle className="w-4 h-4" />
                <span>+ Add / Adjust Record</span>
              </button>
            )}
            <button
              type="button"
              onClick={exportFullLedgerCsv}
              className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-900 border border-emerald-200 cursor-pointer"
            >
              <Download className="w-4 h-4" />
              <span>Export CSV</span>
            </button>
          </div>
        </div>

        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse text-xs">
            <thead>
              <tr className="bg-emerald-50/70 text-[11px] font-bold uppercase text-emerald-900 border-b border-emerald-100">
                <th className="py-3 px-4">Date</th>
                <th className="py-3 px-4">Type</th>
                <th className="py-3 px-4">Event</th>
                <th className="py-3 px-4">Title &amp; Category</th>
                <th className="py-3 px-4 text-right">Amount</th>
                <th className="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-emerald-100">
              {entries.map((e) => (
                <tr key={e.id} className="hover:bg-emerald-50/40">
                  <td className="py-3 px-4 font-mono">{e.entry_date}</td>
                  <td className="py-3 px-4">
                    <span
                      className={`px-2 py-0.5 rounded-full text-[11px] font-bold ${
                        e.entry_type === 'IN'
                          ? 'bg-emerald-100 text-emerald-800'
                          : 'bg-rose-100 text-rose-700'
                      }`}
                    >
                      {e.entry_type === 'IN' ? 'Money In' : 'Expense Out'}
                    </span>
                  </td>
                  <td className="py-3 px-4 font-semibold text-emerald-900">
                    {e.event_name || 'General'}
                  </td>
                  <td className="py-3 px-4">
                    <div className="font-bold text-slate-900">{e.title}</div>
                    <div className="text-[11px] text-slate-500">
                      {e.category} {e.notes ? `• ${e.notes}` : ''}
                    </div>
                  </td>
                  <td
                    className={`py-3 px-4 text-right font-extrabold text-sm ${
                      e.entry_type === 'IN'
                        ? 'text-emerald-700'
                        : 'text-rose-600'
                    }`}
                  >
                    {e.entry_type === 'IN' ? '+' : '-'} RM{' '}
                    {Number(e.amount).toFixed(2)}
                  </td>
                  <td className="py-3 px-4 text-right">
                    <div className="inline-flex items-center gap-1.5">
                      {e.attachment_url && (
                        <a
                          href={e.attachment_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="p-1.5 rounded-lg bg-emerald-50 text-emerald-700"
                          title="View File"
                        >
                          <ExternalLink className="w-3.5 h-3.5" />
                        </a>
                      )}
                      {canEdit && (
                        <>
                          <button
                            type="button"
                            onClick={() => openEditModal(e)}
                            className="p-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-emerald-50 cursor-pointer"
                            title="Edit"
                          >
                            <Edit3 className="w-3.5 h-3.5" />
                          </button>
                          <button
                            type="button"
                            onClick={() => handleDeleteEntry(e)}
                            className="p-1.5 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 cursor-pointer"
                            title="Delete"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {showModal && canEdit && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl shadow-2xl border border-emerald-200 max-w-md w-full overflow-hidden my-8">
            <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
              <h3 className="text-base font-bold">
                {editingEntry ? 'Edit Finance Record' : 'Add Finance Record'}
              </h3>
              <button
                type="button"
                onClick={() => setShowModal(false)}
                className="text-emerald-200 hover:text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            <form onSubmit={handleSaveEntry} className="p-6 space-y-3.5">
              <div className="grid grid-cols-2 gap-2 bg-emerald-50 p-1 rounded-xl border border-emerald-200">
                <button
                  type="button"
                  onClick={() => setEntryType('IN')}
                  className={`py-2 rounded-lg text-xs font-bold cursor-pointer ${
                    entryType === 'IN'
                      ? 'bg-emerald-700 text-white'
                      : 'text-emerald-900'
                  }`}
                >
                  + Money In / Savings
                </button>
                <button
                  type="button"
                  onClick={() => setEntryType('OUT')}
                  className={`py-2 rounded-lg text-xs font-bold cursor-pointer ${
                    entryType === 'OUT'
                      ? 'bg-rose-600 text-white'
                      : 'text-slate-700'
                  }`}
                >
                  - Expense Out
                </button>
              </div>
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Related Event
                </label>
                <select
                  value={selectedEventOption}
                  onChange={(e) => setSelectedEventOption(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm"
                >
                  <option value="GENERAL">General Club Fund / Savings</option>
                  {events.map((ev) => (
                    <option key={ev.id} value={ev.event_name}>
                      {ev.event_name}
                    </option>
                  ))}
                  <option value="OTHER">Other (Type Custom Name)</option>
                </select>
              </div>
              {selectedEventOption === 'OTHER' && (
                <input
                  type="text"
                  value={customEventName}
                  onChange={(e) => setCustomEventName(e.target.value)}
                  placeholder="Custom event name..."
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              )}
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Title *
                </label>
                <input
                  type="text"
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                  required
                />
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-emerald-900 mb-1">
                    Amount (RM) *
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    min="0.10"
                    value={amount}
                    onChange={(e) => setAmount(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-bold"
                    required
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-emerald-900 mb-1">
                    Date *
                  </label>
                  <input
                    type="date"
                    value={entryDate}
                    onChange={(e) => setEntryDate(e.target.value)}
                    className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                    required
                  />
                </div>
              </div>
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Attachment (Max 50MB)
                </label>
                <input
                  type="file"
                  accept="image/*,application/pdf"
                  onChange={(e) =>
                    setAttachmentFile(e.target.files?.[0] || null)
                  }
                  className="w-full text-xs text-slate-600 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-50 file:text-emerald-800"
                />
              </div>
              <div>
                <label className="block text-xs font-bold text-emerald-900 mb-1">
                  Remarks
                </label>
                <input
                  type="text"
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                />
              </div>
              {errorMsg && (
                <div className="text-xs text-red-600 bg-red-50 p-2 rounded-lg">
                  {errorMsg}
                </div>
              )}
              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowModal(false)}
                  className="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={saving}
                  className="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl text-xs font-bold bg-emerald-700 text-white cursor-pointer"
                >
                  {saving ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="w-4 h-4" />
                  )}
                  <span>Save</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/Navbar.tsx">
'use client';

import React, { useState } from 'react';
import { UserProfile } from '@/lib/supabase';
import { Menu, X, Calendar, Receipt, UserCheck, Wallet, Users, PlusCircle, Lock, Unlock, KeyRound, LogOut, Layers, Loader2, Package, QrCode, Crown, Moon, Sun, Palette, FileText } from 'lucide-react';

export type NavTab = 'activities' | 'equipment' | 'claims' | 'profile' | 'ledger' | 'members';

interface NavbarProps {
  profile: UserProfile; clubName: string; logoUrl?: string; activeTab: NavTab; onSelectTab: (tab: NavTab) => void;
  currentBatch?: string; roleMode: 'member' | 'admin' | 'owner'; pendingClaimsCount?: number;
  darkMode?: boolean; onToggleDarkMode?: () => void; canCustomizeTheme?: boolean; onOpenThemeStudio?: () => void;
  onUnlockAdmin: (pin: string) => Promise<boolean>; onUnlockOwner: (pin: string) => Promise<boolean>;
  onSwitchMode: (target: 'member' | 'admin' | 'owner') => Promise<void>;
  onSignOut: () => Promise<void>; onOpenNewClaim: () => void; onOpenQrScanner: () => void;
  onOpenNewActivity?: () => void; onOpenNewFinance?: () => void; switchingRole?: boolean;
}

export default function Navbar({
  profile, clubName, logoUrl = '', activeTab, onSelectTab, currentBatch = '2026/2027', roleMode, pendingClaimsCount = 0,
  darkMode = false, onToggleDarkMode, canCustomizeTheme = false, onOpenThemeStudio,
  onUnlockAdmin, onUnlockOwner, onSwitchMode, onSignOut, onOpenNewClaim, onOpenQrScanner,
  onOpenNewActivity, onOpenNewFinance, switchingRole = false,
}: NavbarProps) {
  const isAdminOrOwner = roleMode === 'admin' || roleMode === 'owner';
  const isOwner = roleMode === 'owner';
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [pinModalType, setPinModalType] = useState<'admin' | 'owner' | null>(null);
  const [pinInput, setPinInput] = useState('');
  const [pinError, setPinError] = useState<string | null>(null);

  const handleNav = (tab: NavTab) => { onSelectTab(tab); setDrawerOpen(false); };

  const handlePinSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setPinError(null);
    const ok = pinModalType === 'admin' ? await onUnlockAdmin(pinInput) : await onUnlockOwner(pinInput);
    if (ok) { setPinInput(''); setPinModalType(null); setDrawerOpen(false); }
    else setPinError('Invalid Passcode.');
  };

  const renderLogo = () => {
    if (!logoUrl) {
      return (
        <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white shadow-md shrink-0">
          <Layers className="w-5 h-5" />
        </div>
      );
    }
    if (logoUrl.toLowerCase().endsWith('.pdf')) {
      return (
        <a href={logoUrl} target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()} className="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center shadow-md shrink-0" title="Open Official Club Logo PDF">
          <FileText className="w-5 h-5" />
        </a>
      );
    }
    return <img src={logoUrl} alt={clubName} className="w-10 h-10 rounded-xl object-cover border border-emerald-400/40 shadow-md shrink-0 bg-white" />;
  };

  return (
    <>
      <header className={`sticky top-0 z-30 backdrop-blur-xl border-b transition-colors ${darkMode ? 'bg-slate-950/80 border-white/10 text-white' : 'bg-white/80 border-slate-200/80 text-slate-900'}`}>
        <div className="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <button type="button" onClick={() => setDrawerOpen(true)} className={`p-2.5 rounded-xl border transition cursor-pointer ${darkMode ? 'bg-white/5 border-white/10 text-emerald-400 hover:bg-white/10' : 'bg-slate-100 text-slate-800 border-slate-200 hover:bg-slate-200'}`}><Menu className="w-5 h-5" /></button>
            <div onClick={() => handleNav('activities')} className="flex items-center gap-2.5 cursor-pointer">
              {renderLogo()}
              <span className="text-base font-extrabold tracking-tight">{clubName || 'ClubSync'}</span>
              <span className={`hidden sm:inline-block px-2 py-0.5 rounded-md text-[10px] font-bold border ${darkMode ? 'bg-white/5 border-white/10 text-emerald-300' : 'bg-emerald-50 text-emerald-800 border-emerald-200'}`}>{currentBatch}</span>
