<file path="src/components/ProfileSection.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import {
  supabase,
  UserProfile,
  Budget,
  EventRsvp,
  ActivityFeePayment,
  DEFAULT_DEPARTMENTS,
  MAX_FILE_SIZE_BYTES,
  downloadFileFromUrl,
} from '@/lib/supabase';
import {
  UserCheck,
  Save,
  CheckCircle2,
  Loader2,
  Calendar,
  Car,
  ExternalLink,
  Landmark,
  Download,
  Trash2,
} from 'lucide-react';

interface ProfileSectionProps {
  profile: UserProfile;
  departments?: string[];
  budgets: Budget[];
  myRsvps: EventRsvp[];
  myFeePayments: ActivityFeePayment[];
  onUpdated: (updated: Partial<UserProfile>, msg: string) => void;
}

export default function ProfileSection({
  profile,
  departments = DEFAULT_DEPARTMENTS,
  budgets,
  myRsvps,
  myFeePayments,
  onUpdated,
}: ProfileSectionProps) {
  const [fullName, setFullName] = useState(profile.full_name || '');
  const [matricNo, setMatricNo] = useState(profile.matric_no || '');
  const [phoneNumber, setPhoneNumber] = useState(profile.phone_number || '');
  const [memberType, setMemberType] = useState(
    profile.member_type || departments[0] || 'Ordinary Member'
  );
  const [yearOfStudy, setYearOfStudy] = useState(profile.year_of_study || 'Year 1');
  const [course, setCourse] = useState(profile.course || '');
  const [icNo, setIcNo] = useState(profile.ic_no || '');
  const [dormitory, setDormitory] = useState(profile.dormitory || '');
  const [hometown, setHometown] = useState(profile.hometown || '');
  const [bankName, setBankName] = useState(profile.bank_name || '');
  const [bankAccountNo, setBankAccountNo] = useState(profile.bank_account_no || '');
  const [bankAccountHolder, setBankAccountHolder] = useState(profile.bank_account_holder || profile.full_name || '');
  const [bankQrUrl, setBankQrUrl] = useState(profile.bank_qr_url || '');
  const [bankQrFile, setBankQrFile] = useState<File | null>(null);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    setFullName(profile.full_name || '');
    setMatricNo(profile.matric_no || '');
    setPhoneNumber(profile.phone_number || '');
    setMemberType(profile.member_type || departments[0] || 'Ordinary Member');
    setYearOfStudy(profile.year_of_study || 'Year 1');
    setCourse(profile.course || '');
    setIcNo(profile.ic_no || '');
    setDormitory(profile.dormitory || '');
    setHometown(profile.hometown || '');

    const savedLocal =
      typeof window !== 'undefined'
        ? localStorage.getItem(`clubsync_bank_${profile.id}`)
        : null;
    if (savedLocal) {
      try {
        const parsed = JSON.parse(savedLocal);
        setBankName(profile.bank_name || parsed.bank_name || '');
        setBankAccountNo(profile.bank_account_no || parsed.bank_account_no || '');
        setBankAccountHolder(
          profile.bank_account_holder || parsed.bank_account_holder || profile.full_name || ''
        );
        setBankQrUrl(profile.bank_qr_url || parsed.bank_qr_url || '');
        return;
      } catch {
        /* ignore */
      }
    }
    setBankName(profile.bank_name || '');
    setBankAccountNo(profile.bank_account_no || '');
    setBankAccountHolder(profile.bank_account_holder || profile.full_name || '');
    setBankQrUrl(profile.bank_qr_url || '');
  }, [profile, departments]);

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    try {
      let finalQrUrl = bankQrUrl.trim();
      if (bankQrFile && bankQrFile.size <= MAX_FILE_SIZE_BYTES) {
        const ext = bankQrFile.name.split('.').pop() || 'png';
        const path = `member-qr/${profile.id}-${Date.now()}.${ext}`;
        const { error: upErr } = await supabase.storage.from('receipts').upload(path, bankQrFile);
        if (!upErr) {
          finalQrUrl = supabase.storage.from('receipts').getPublicUrl(path).data.publicUrl;
        }
      }
      setBankQrUrl(finalQrUrl);
      setBankQrFile(null);

      const bankData = {
        bank_name: bankName.trim(),
        bank_account_no: bankAccountNo.trim(),
        bank_account_holder: bankAccountHolder.trim() || fullName.trim(),
        bank_qr_url: finalQrUrl,
      };
      if (typeof window !== 'undefined') {
        localStorage.setItem(`clubsync_bank_${profile.id}`, JSON.stringify(bankData));
      }

      const coreUpdates = {
        full_name: fullName.trim(),
        matric_no: matricNo.trim().toUpperCase(),
        phone_number: phoneNumber.trim(),
        member_type: memberType,
        year_of_study: yearOfStudy,
        course: course.trim(),
        ic_no: icNo.trim(),
        dormitory: dormitory.trim(),
        hometown: hometown.trim(),
      };

      const fullUpdates = { ...coreUpdates, ...bankData };
      const { error } = await supabase.from('users').update(fullUpdates).eq('id', profile.id);
      if (error) {
        await supabase.from('users').update(coreUpdates).eq('id', profile.id);
      }
      onUpdated(fullUpdates, 'Profile, Bank & Reimbursement QR saved!');
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div className="lg:col-span-7 bg-white rounded-3xl border border-emerald-200 shadow-xs overflow-hidden">
        <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2.5">
            <UserCheck className="w-5 h-5 text-emerald-300" />
            <div>
              <h2 className="text-base font-bold">My Member Profile</h2>
              <p className="text-xs text-emerald-200">
                Auto-fills your name, matric, dorm &amp; bank/QR info across events and claims
              </p>
            </div>
          </div>
          <span className="px-3 py-1 rounded-full text-xs font-bold bg-amber-300 text-emerald-950">
            {memberType}
          </span>
        </div>

        <form onSubmit={handleSave} className="p-6 space-y-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Full Name *
              </label>
              <input
                type="text"
                value={fullName}
                onChange={(e) => setFullName(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
                required
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Matric No *
              </label>
              <input
                type="text"
                value={matricNo}
                onChange={(e) => setMatricNo(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-mono uppercase"
                required
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Phone / WhatsApp *
              </label>
              <input
                type="tel"
                value={phoneNumber}
                onChange={(e) => setPhoneNumber(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-mono"
                required
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Department / Unit *
              </label>
              <select
                value={memberType}
                onChange={(e) => setMemberType(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm font-bold text-emerald-900"
              >
                {departments.map((opt) => (
                  <option key={opt} value={opt}>
                    {opt}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Residential College / Dormitory
              </label>
              <input
                type="text"
                value={dormitory}
                onChange={(e) => setDormitory(e.target.value)}
                placeholder="e.g., KTDI / KTR / KTHO"
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Year of Study
              </label>
              <select
                value={yearOfStudy}
                onChange={(e) => setYearOfStudy(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 text-sm"
              >
                {['Year 1', 'Year 2', 'Year 3', 'Year 4', 'Postgraduate'].map((y) => (
                  <option key={y} value={y}>
                    {y}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                Faculty / Course Code
              </label>
              <input
                type="text"
                value={course}
                onChange={(e) => setCourse(e.target.value)}
                placeholder="e.g., FSKSM / SECJ"
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">
                IC / Passport No
              </label>
              <input
                type="text"
                value={icNo}
                onChange={(e) => setIcNo(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-sm font-mono"
              />
            </div>
          </div>

          <div className="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 space-y-3">
            <div className="flex items-center gap-2">
              <Landmark className="w-4 h-4 text-emerald-700" />
              <div>
                <h3 className="text-xs font-extrabold text-emerald-950">
                  My Bank / DuitNow / TNG QR (Optional — For Receiving Reimbursements)
                </h3>
                <p className="text-[11px] text-slate-600">
                  Save your bank details or upload your personal QR (JPG, PNG, PDF) so the Admin can scan directly or download it to reimburse your claims.
                </p>
              </div>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">
                  Bank / eWallet Name
                </label>
                <input
                  type="text"
                  value={bankName}
                  onChange={(e) => setBankName(e.target.value)}
                  placeholder="e.g., Maybank / CIMB / TNG eWallet"
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-semibold"
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">
                  Account No / DuitNow Phone
                </label>
                <input
                  type="text"
                  value={bankAccountNo}
                  onChange={(e) => setBankAccountNo(e.target.value)}
                  placeholder="e.g., 162106789012 / 012-3456789"
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-mono font-bold"
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">
                  Recipient Holder Name
                </label>
                <input
                  type="text"
                  value={bankAccountHolder}
                  onChange={(e) => setBankAccountHolder(e.target.value)}
                  placeholder={fullName || 'Account Holder Name'}
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-semibold"
                />
              </div>
            </div>

            <div className="pt-2 border-t border-emerald-200/70 space-y-2 text-xs">
              <label className="block font-bold text-emerald-900">
                Upload My Personal DuitNow / TNG QR (Optional — JPG, PNG, PDF)
              </label>
              <input
                type="file"
                accept="image/*,application/pdf"
                onChange={(e) => setBankQrFile(e.target.files?.[0] || null)}
                className="w-full text-xs file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-600 file:text-white cursor-pointer"
              />
              {bankQrUrl && (
                <div className="p-3 rounded-xl bg-white border border-emerald-200 flex items-center justify-between gap-3">
                  <div className="flex items-center gap-3">
                    {!bankQrUrl.toLowerCase().split('?')[0].endsWith('.pdf') && (
                      <img src={bankQrUrl} alt="My QR" className="w-14 h-14 object-contain rounded-lg border" />
                    )}
                    <span className="font-bold text-emerald-900">Saved Personal Payment QR</span>
                  </div>
                  <div className="flex items-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => downloadFileFromUrl(bankQrUrl, `${matricNo}_Payment_QR`)}
                      className="px-2.5 py-1.5 rounded-lg bg-emerald-600 text-white font-bold cursor-pointer"
                    >
                      <Download className="w-3.5 h-3.5 inline mr-1" />
                      Download
                    </button>
                    <button
                      type="button"
                      onClick={() => setBankQrUrl('')}
                      className="p-1.5 rounded-lg bg-rose-50 text-rose-700 cursor-pointer"
                      title="Remove QR"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              )}
            </div>
          </div>

          <div className="pt-2 flex justify-end">
            <button
              type="submit"
              disabled={saving}
              className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer"
            >
              {saving ? (
                <Loader2 className="w-4 h-4 animate-spin" />
              ) : (
                <Save className="w-4 h-4" />
              )}
              <span>Save Profile</span>
            </button>
          </div>
        </form>
      </div>

      <div className="lg:col-span-5 space-y-4">
        <div className="bg-white rounded-3xl border border-emerald-200 p-5 shadow-xs space-y-3">
          <div className="flex items-center gap-2">
            <Calendar className="w-4 h-4 text-emerald-700" />
            <h3 className="text-sm font-extrabold text-emerald-950">
              My Event RSVPs ({myRsvps.length})
            </h3>
          </div>
          {myRsvps.length === 0 ? (
            <p className="text-xs text-slate-400">No event responses yet.</p>
          ) : (
            <div className="space-y-2 max-h-[240px] overflow-y-auto">
              {myRsvps.map((r) => {
                const ev = budgets.find((b) => b.id === r.budget_id);
                return (
                  <div
                    key={r.id}
                    className="p-3 rounded-xl bg-emerald-50/60 border border-emerald-100 text-xs flex items-center justify-between"
                  >
                    <div>
                      <p className="font-bold text-slate-900">
                        {ev?.event_name || 'Activity'}
                      </p>
                      <p className="text-[11px] text-slate-500">
                        <Car className="w-3 h-3 inline mr-1" />
                        {r.is_driver
                          ? `Driver (${r.car_details})`
                          : `Transport: ${r.transport_type}`}
                      </p>
                    </div>
                    <span className="px-2.5 py-1 rounded-full font-bold bg-emerald-100 text-emerald-800">
                      {r.attendance}
                    </span>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        <div className="bg-white rounded-3xl border border-emerald-200 p-5 shadow-xs space-y-3">
          <div className="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-700" />
            <h3 className="text-sm font-extrabold text-emerald-950">
              My Activity Fee Receipts ({myFeePayments.length})
            </h3>
          </div>
          {myFeePayments.length === 0 ? (
            <p className="text-xs text-slate-400">No fee payments submitted yet.</p>
          ) : (
            <div className="space-y-2 max-h-[200px] overflow-y-auto">
              {myFeePayments.map((f) => {
                const ev = budgets.find((b) => b.id === f.budget_id);
                return (
                  <div
                    key={f.id}
                    className="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs flex items-center justify-between"
                  >
                    <div>
                      <p className="font-bold text-slate-900">
                        {ev?.event_name || 'Event Fee'}
                      </p>
                      <p className="text-emerald-700 font-extrabold">
                        RM {Number(f.amount_paid).toFixed(2)} • {f.status}
                      </p>
                    </div>
                    <a
                      href={f.receipt_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="text-emerald-700 font-bold hover:underline"
                    >
                      Receipt <ExternalLink className="w-3 h-3 inline" />
                    </a>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/QrScannerModal.tsx">
'use client';

import React, { useEffect, useRef, useState, useCallback } from 'react';
import { supabase, Budget, UserProfile, EventRsvp, ActivityFeePayment } from '@/lib/supabase';
import { X, Camera, CheckCircle2, AlertTriangle, Upload, QrCode, ShieldCheck, XCircle } from 'lucide-react';

interface QrScannerModalProps {
  isOpen: boolean; onClose: () => void; budgets: Budget[]; rsvps: EventRsvp[];
  feePayments?: ActivityFeePayment[]; profile: UserProfile; isAdmin?: boolean; onSuccess: (msg: string) => void;
}

interface GatePassResult {
  allowed: boolean; studentName: string; matricNo: string; department: string;
  eventName: string; feeStatus: string; reason: string;
}

declare global {
  interface Window {
    jsQR?: (data: Uint8ClampedArray, width: number, height: number) => { data: string } | null;
  }
}

export default function QrScannerModal({
  isOpen, onClose, budgets, rsvps, feePayments = [], profile, isAdmin = false, onSuccess,
}: QrScannerModalProps) {
  const videoRef = useRef<HTMLVideoElement | null>(null);
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const [cameraActive, setCameraActive] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);
  const [successMsg, setSuccessMsg] = useState<string | null>(null);
  const [gatePass, setGatePass] = useState<GatePassResult | null>(null);

  useEffect(() => {
    if (!isOpen || typeof window === 'undefined') return;
    if (!window.jsQR) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js';
      script.async = true;
      document.body.appendChild(script);
    }
  }, [isOpen]);

  const verifyAndRecordQrPayload = useCallback(async (rawText: string) => {
    setErrorMsg(null);
    const trimmed = rawText.trim();

    if (trimmed.includes('CLUBSYNC_PASS::v1::')) {
      const passPayload = trimmed.slice(trimmed.indexOf('CLUBSYNC_PASS::v1::'));
      const parts = passPayload.split('::');
      const eventId = parts[2]?.trim();
      const userId = parts[3]?.trim();
      const scannedToken = parts[4]?.trim().toUpperCase();

      const targetEvent = budgets.find((b) => b.id === eventId);
      if (!targetEvent) { setErrorMsg('Event not found.'); return; }

      const activeToken = (targetEvent.qr_code_token || targetEvent.id.slice(0, 6)).trim().toUpperCase();
      if (scannedToken !== activeToken) {
        setGatePass({
          allowed: false, studentName: 'Expired QR Pass', matricNo: '-', department: '-',
          eventName: targetEvent.event_name, feeStatus: 'Expired',
          reason: 'DENIED: This QR code has expired.',
        });
        return;
      }

      const memberRsvp = rsvps.find((r) => r.budget_id === targetEvent.id && r.user_id === userId);
      if (!memberRsvp || memberRsvp.attendance !== 'Attending') {
        setGatePass({
          allowed: false, studentName: memberRsvp?.student_name || 'Unregistered',
          matricNo: memberRsvp?.matric_no || '-', department: memberRsvp?.member_type || '-',
          eventName: targetEvent.event_name, feeStatus: 'Not Attending',
          reason: 'DENIED: Member is not registered as Attending.',
        });
        return;
      }

      const reqFee = Number(targetEvent.registration_fee || 0);
      const paidRecord = feePayments.find((f) => f.budget_id === targetEvent.id && f.user_id === userId && f.status === 'Verified');
      const isManualOnly = targetEvent.ticket_qr_mode === 'manual_only';
      const eligible = isManualOnly ? Boolean(memberRsvp.pass_approved) : Boolean(memberRsvp.pass_approved) || (reqFee > 0 && Boolean(paidRecord));

      if (!eligible) {
        setGatePass({
          allowed: false, studentName: memberRsvp.student_name, matricNo: memberRsvp.matric_no,
          department: memberRsvp.member_type, eventName: targetEvent.event_name,
          feeStatus: reqFee > 0 ? `Unpaid (RM ${reqFee.toFixed(2)})` : 'Not Granted',
          reason: 'DENIED: Fee payment or Admin grant required.',
        });
        return;
      }

      const nowIso = new Date().toISOString();
      await supabase.from('event_rsvps').update({ qr_checked_in: true, qr_checked_in_at: nowIso, updated_at: nowIso }).eq('id', memberRsvp.id);

      setGatePass({
        allowed: true, studentName: memberRsvp.student_name, matricNo: memberRsvp.matric_no,
        department: memberRsvp.member_type, eventName: targetEvent.event_name,
        feeStatus: paidRecord ? `Paid RM ${Number(paidRecord.amount_paid).toFixed(2)} ✓` : 'Admin Granted ✓',
        reason: 'ACCESS GRANTED: Attendance automatically recorded!',
      });
      onSuccess(`Admitted ${memberRsvp.student_name}!`);
      return;
    }

    const idx = trimmed.indexOf('CLUBSYNC_QR::v1::');
    const payload = idx !== -1 ? trimmed.slice(idx).trim() : trimmed;
    if (!payload.startsWith('CLUBSYNC_QR::v1::')) {
      setErrorMsg('Invalid QR! Please scan an official ClubSync QR code.');
      return;
    }
    const parts = payload.split('::');
    const eventId = parts[2]?.trim();
    const scannedToken = parts[3]?.trim().toUpperCase();
    const targetEvent = budgets.find((b) => b.id === eventId);
    if (!targetEvent) { setErrorMsg('Event not found.'); return; }

    const activeToken = (targetEvent.qr_code_token || targetEvent.id.slice(0, 6)).trim().toUpperCase();
    if (scannedToken !== activeToken) {
      setErrorMsg('Expired QR Code! Please scan the latest QR displayed by the Admin.');
      return;
    }

    const existing = rsvps.find((r) => r.budget_id === targetEvent.id && r.user_id === profile.id);
    const nowIso = new Date().toISOString();
    await supabase.from('event_rsvps').upsert({
      budget_id: targetEvent.id, user_id: profile.id, student_name: profile.full_name,
      matric_no: profile.matric_no, phone_number: profile.phone_number, member_type: profile.member_type || 'Member',
      dormitory: existing?.dormitory || profile.dormitory || '', attendance: 'Attending',
      transport_type: existing?.transport_type || 'None', is_driver: existing?.is_driver || false,
      car_details: existing?.car_details || '', seats_available: existing?.seats_available ?? 4,
      trips_count: existing?.trips_count ?? 1, assigned_driver_name: existing?.assigned_driver_name || '',
      pass_approved: existing?.pass_approved ?? false,
      qr_checked_in: true, qr_checked_in_at: nowIso, updated_at: nowIso,
    }, { onConflict: 'budget_id,user_id' });

    setSuccessMsg(`Attendance automatically recorded for "${targetEvent.event_name}"!`);
    setTimeout(() => { onSuccess(`Attendance recorded for "${targetEvent.event_name}"!`); onClose(); }, 1000);
  }, [budgets, rsvps, feePayments, profile, onSuccess, onClose]);

  useEffect(() => {
    if (!isOpen) return;
    setErrorMsg(null); setSuccessMsg(null); setGatePass(null);
    let stream: MediaStream | null = null;
    let animId: number;
    let active = true;

    navigator.mediaDevices?.getUserMedia({ video: { facingMode: 'environment' } }).then(async (s) => {
      if (!active) { s.getTracks().forEach((t) => t.stop()); return; }
      stream = s;
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
        videoRef.current.setAttribute('playsinline', 'true');
        await videoRef.current.play();
        setCameraActive(true);
      }
      const tick = () => {
        if (!active) return;
        const v = videoRef.current; const c = canvasRef.current;
        if (v && c && v.readyState === v.HAVE_ENOUGH_DATA && window.jsQR) {
          c.width = v.videoWidth; c.height = v.videoHeight;
          const ctx = c.getContext('2d');
          if (ctx) {
            ctx.drawImage(v, 0, 0, c.width, c.height);
            const img = ctx.getImageData(0, 0, c.width, c.height);
            const code = window.jsQR(img.data, img.width, img.height);
            if (code?.data) verifyAndRecordQrPayload(code.data);
          }
        }
        animId = requestAnimationFrame(tick);
      };
      animId = requestAnimationFrame(tick);
    }).catch(() => setCameraActive(false));

    return () => {
      active = false;
      if (animId) cancelAnimationFrame(animId);
      if (stream) stream.getTracks().forEach((t) => t.stop());
      setCameraActive(false);
    };
  }, [isOpen, verifyAndRecordQrPayload]);

  const handleImageFileScan = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const img = new Image();
    img.onload = () => {
      const c = canvasRef.current;
      if (!c || !window.jsQR) return;
      c.width = img.width; c.height = img.height;
      const ctx = c.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(img, 0, 0);
      const data = ctx.getImageData(0, 0, c.width, c.height);
      const code = window.jsQR(data.data, data.width, data.height);
      if (code?.data) verifyAndRecordQrPayload(code.data);
      else setErrorMsg('No valid ClubSync QR Code detected in this image.');
    };
    img.src = URL.createObjectURL(file);
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4 overflow-y-auto">
      <div className="bg-white text-slate-900 rounded-3xl max-w-md w-full overflow-hidden shadow-2xl">
        <div className="bg-slate-900 text-white px-6 py-4 flex justify-between items-center">
          <div className="flex items-center gap-2">
            <QrCode className="w-5 h-5 text-emerald-400" />
            <div><h3 className="text-sm font-bold">{isAdmin ? 'Scan Attendance / Entry Pass QR' : 'Scan Event Attendance QR'}</h3><p className="text-[11px] text-slate-400">Automatically records attendance upon scan</p></div>
          </div>
          <button type="button" onClick={onClose} className="cursor-pointer"><X className="w-5 h-5" /></button>
        </div>

        <div className="p-6 space-y-4 text-center">
          {gatePass ? (
            <div className={`p-5 rounded-3xl border-2 text-left space-y-3 ${gatePass.allowed ? 'bg-emerald-50 border-emerald-600 text-emerald-950' : 'bg-rose-50 border-rose-600 text-rose-950'}`}>
              <div className="flex items-center gap-2.5">
                {gatePass.allowed ? <ShieldCheck className="w-8 h-8 text-emerald-600 shrink-0" /> : <XCircle className="w-8 h-8 text-rose-600 shrink-0" />}
                <div>
                  <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase ${gatePass.allowed ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white'}`}>
                    {gatePass.allowed ? 'ACCESS GRANTED' : 'ENTRY DENIED'}
                  </span>
                  <h4 className="text-base font-extrabold mt-1">{gatePass.studentName}</h4>
                </div>
              </div>
              <div className="text-xs space-y-1 bg-white/80 p-3 rounded-2xl border">
                <p><strong>Matric No:</strong> <span className="font-mono">{gatePass.matricNo}</span></p>
                <p><strong>Event:</strong> {gatePass.eventName}</p>
                <p><strong>Status:</strong> <span className="font-bold">{gatePass.feeStatus}</span></p>
              </div>
              <p className="text-xs font-bold">{gatePass.reason}</p>
              <button type="button" onClick={() => setGatePass(null)} className="w-full py-2.5 rounded-xl bg-slate-950 hover:bg-slate-900 text-white text-xs font-bold cursor-pointer">Scan Next</button>
            </div>
          ) : (
            <>
              <div className="relative rounded-2xl overflow-hidden bg-slate-950 aspect-square max-h-[250px] mx-auto flex items-center justify-center border-2 border-emerald-500">
                <video ref={videoRef} className={`w-full h-full object-cover ${cameraActive ? 'block' : 'hidden'}`} muted />
                <canvas ref={canvasRef} className="hidden" />
                {!cameraActive && <div className="p-6 text-slate-300 text-xs"><Camera className="w-8 h-8 text-emerald-400 mx-auto mb-2" />Point camera at QR Code</div>}
              </div>
              <label className="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold cursor-pointer">
                <Upload className="w-4 h-4" /><span>Upload / Capture QR Image</span>
                <input type="file" accept="image/*" capture="environment" onChange={handleImageFileScan} className="hidden" />
              </label>
            </>
          )}
          {successMsg && <div className="p-3 rounded-xl bg-emerald-600 text-white text-xs font-bold"><CheckCircle2 className="w-4 h-4 inline mr-1" />{successMsg}</div>}
          {errorMsg && <div className="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-semibold"><AlertTriangle className="w-4 h-4 inline mr-1" />{errorMsg}</div>}
        </div>
      </div>
    </div>
  );
}
