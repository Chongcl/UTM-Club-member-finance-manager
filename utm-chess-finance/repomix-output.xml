<file path="src/components/AuditReviewModal.tsx">
'use client';

import React, { useState } from 'react';
import { supabase, Claim, Budget, UserProfile } from '@/lib/supabase';
import { X, CheckCircle2, XCircle, ExternalLink, ShieldCheck, Loader2, Phone, Clock } from 'lucide-react';

export interface AuditReviewModalProps {
  claim: Claim | null;
  budget?: Budget;
  profile: UserProfile;
  onClose: () => void;
  onUpdated: (message: string) => void;
}

export default function AuditReviewModal({ claim, budget, profile, onClose, onUpdated }: AuditReviewModalProps) {
  const [remarks, setRemarks] = useState(claim?.treasurer_remarks || '');
  const [processing, setProcessing] = useState(false);

  if (!claim) return null;

  const isAdmin = profile.role === 'treasurer';
  const cleanDigits = claim.phone_number.replace(/[^0-9]/g, '');
  const waLink = `https://wa.me/${cleanDigits.startsWith('0') ? '6' + cleanDigits : cleanDigits}`;

  const handleDecision = async (newStatus: 'Approved' | 'Rejected') => {
    setProcessing(true);
    try {
      const defaultMsg = newStatus === 'Approved' ? 'Approved & Reimbursed by Admin' : 'Rejected by Admin';
      const { error } = await supabase
        .from('claims')
        .update({
          status: newStatus,
          treasurer_remarks: remarks.trim() || defaultMsg,
          reviewed_by: `${profile.full_name} (${profile.matric_no})`,
          reviewed_at: new Date().toISOString(),
        })
        .eq('id', claim.id);

      if (error) throw error;
      onUpdated(`Claim "${claim.title}" marked as ${newStatus}.`);
      onClose();
    } finally {
      setProcessing(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white rounded-3xl shadow-2xl border border-emerald-200 max-w-2xl w-full overflow-hidden my-8">
        <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <ShieldCheck className="w-5 h-5 text-emerald-300" />
            <h2 className="text-base font-bold">Reimbursement Track Record &amp; Receipt Review</h2>
          </div>
          <button type="button" onClick={onClose} className="text-emerald-200 hover:text-white cursor-pointer">
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
          <div className="space-y-2">
            <div className="flex items-center justify-between text-xs">
              <span className="font-bold text-emerald-900">Receipt Proof</span>
              <a href={claim.receipt_url} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 text-emerald-700 font-semibold hover:underline">
                <span>Open Full File</span>
                <ExternalLink className="w-3.5 h-3.5" />
              </a>
            </div>
            <div className="rounded-2xl border border-emerald-200 bg-slate-50 p-2 flex items-center justify-center min-h-[220px]">
              <img src={claim.receipt_url} alt={claim.title} className="max-h-[260px] w-auto rounded-xl object-contain" />
            </div>
          </div>

          <div className="space-y-3">
            <div className="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 space-y-2 text-xs">
              <div className="flex justify-between items-center">
                <span className="text-slate-500">Reimbursement Amount</span>
                <span className="text-xl font-extrabold text-emerald-800">RM {Number(claim.amount).toFixed(2)}</span>
              </div>
              <div className="font-bold text-sm text-slate-900">{claim.title}</div>
              <p><strong>Activity:</strong> {budget?.event_name || 'Club Activity'}</p>
              <p><strong>Unit / Category:</strong> {claim.category}</p>
              <p><strong>Claimant:</strong> {claim.claimant_name} ({claim.matric_no})</p>
              <p><strong>Expense Date:</strong> {claim.expense_date}</p>
              <div className="flex items-center justify-between pt-1">
                <span className="font-mono font-bold">{claim.phone_number}</span>
                <a href={waLink} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-700 text-white font-semibold">
                  <Phone className="w-3 h-3" />
                  <span>WhatsApp</span>
                </a>
              </div>
              {claim.description && <p><strong>Note:</strong> {claim.description}</p>}
            </div>

            <div className="rounded-2xl border border-emerald-200 p-3 text-xs space-y-1 bg-white">
              <div className="font-bold text-emerald-950 flex items-center gap-1.5">
                <Clock className="w-3.5 h-3.5 text-emerald-700" />
                <span>Reimbursement Audit Trail:</span>
              </div>
              <p><strong>Status:</strong> <span className="font-bold">{claim.status}</span></p>
              {claim.reviewed_by && <p><strong>Reviewed By:</strong> {claim.reviewed_by}</p>}
              {claim.reviewed_at && <p><strong>Reviewed On:</strong> {new Date(claim.reviewed_at).toLocaleString()}</p>}
            </div>

            <div>
              <label className="block text-xs font-bold text-emerald-900 mb-1">Reimbursement Remarks / Payment Ref</label>
              <textarea
                rows={2}
                value={remarks}
                onChange={(e) => setRemarks(e.target.value)}
                disabled={!isAdmin}
                placeholder="e.g., Reimbursed via DuitNow Ref #88219..."
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 text-xs disabled:bg-slate-100"
              />
            </div>

            {isAdmin && (
              <div className="flex gap-2 pt-1">
                <button type="button" disabled={processing} onClick={() => handleDecision('Rejected')} className="flex-1 inline-flex items-center justify-center gap-1 py-2.5 rounded-xl text-xs font-bold bg-red-50 text-red-700 border border-red-200 cursor-pointer">
                  <XCircle className="w-4 h-4" />
                  <span>Reject</span>
                </button>
                <button type="button" disabled={processing} onClick={() => handleDecision('Approved')} className="flex-1 inline-flex items-center justify-center gap-1 py-2.5 rounded-xl text-xs font-bold bg-emerald-700 text-white cursor-pointer">
                  {processing ? <Loader2 className="w-4 h-4 animate-spin" /> : <CheckCircle2 className="w-4 h-4" />}
                  <span>Approve &amp; Reimburse</span>
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/BudgetModal.tsx">
'use client';

import React, { useState, useEffect, useRef } from 'react';
import { supabase, DEFAULT_DEPARTMENTS, TicketQrMode, PassApprovalRule, EventRsvp, ActivityFeePayment, isEntryPassMode } from '@/lib/supabase';
import { X, Calendar, Loader2, CheckCircle2, Car, CreditCard, QrCode, RefreshCw, ShieldCheck, ExternalLink, Sparkles, Ticket, Settings, Users } from 'lucide-react';

export interface EditableActivity {
  id?: string; event_name: string; category: string; event_date?: string; event_time?: string;
  location?: string; registration_fee?: number; driver_allowance_per_trip?: number;
  driver_recruitment_open?: boolean; qr_code_token?: string; ticket_qr_mode?: TicketQrMode;
  description: string; status?: 'Active' | 'Closed';
}

interface BudgetModalProps {
  isOpen: boolean; onClose: () => void; onSuccess: (message: string) => void;
  initialData?: EditableActivity | null; departments?: string[]; rsvps?: EventRsvp[]; feePayments?: ActivityFeePayment[];
}

export default function BudgetModal({
  isOpen, onClose, onSuccess, initialData, departments = DEFAULT_DEPARTMENTS, rsvps = [], feePayments = [],
}: BudgetModalProps) {
  const isEditing = Boolean(initialData?.id);
  const [openSection, setOpenSection] = useState<'none' | 'settings' | 'passes' | 'fees' | 'carpool'>('none');

  const [eventName, setEventName] = useState('');
  const [category, setCategory] = useState<string>(departments[0] || 'Member');
  const [eventDate, setEventDate] = useState(new Date().toISOString().split('T')[0]);
  const [eventTime, setEventTime] = useState('08:00 PM - 10:00 PM');
  const [location, setLocation] = useState('Student Activity Hall');
  const [registrationFee, setRegistrationFee] = useState('0');
  const [driverAllowance, setDriverAllowance] = useState('5.00');
  const [driverRecruitmentOpen, setDriverRecruitmentOpen] = useState(true);
  const [useEntryPass, setUseEntryPass] = useState(false);
  const [passRule, setPassRule] = useState<PassApprovalRule>('auto_after_payment');
  const [qrToken, setQrToken] = useState('');
  const [status, setStatus] = useState<'Active' | 'Closed'>('Active');
  const [description, setDescription] = useState('');
  const [saving, setSaving] = useState(false);
  const [localPassOverrides, setLocalPassOverrides] = useState<Record<string, boolean>>({});

  // Only initialize when modal opens or switches to a different activity ID (prevents auto-jump when granting passes!)
  const lastInitIdRef = useRef<string | null>(null);
  useEffect(() => {
    if (!isOpen) {
      lastInitIdRef.current = null;
      return;
    }
    const currentKey = initialData?.id || 'NEW';
    if (lastInitIdRef.current === currentKey) return;
    lastInitIdRef.current = currentKey;

    setOpenSection('none');
    setLocalPassOverrides({});
    if (initialData) {
      setEventName(initialData.event_name || '');
      setCategory(initialData.category || departments[0] || 'Member');
      setEventDate(initialData.event_date || new Date().toISOString().split('T')[0]);
      setEventTime(initialData.event_time || '08:00 PM - 10:00 PM');
      setLocation(initialData.location || 'Student Activity Hall');
      const feeVal = initialData.registration_fee ?? 0;
      setRegistrationFee(String(feeVal));
      setDriverAllowance(String(initialData.driver_allowance_per_trip ?? 5.0));
      setDriverRecruitmentOpen(initialData.driver_recruitment_open ?? true);
      const savedMode =
        (typeof window !== 'undefined' && initialData.id ? localStorage.getItem(`clubsync_qrmode_${initialData.id}`) : null) ||
        initialData.ticket_qr_mode ||
        (Number(feeVal) > 0 ? 'entry_pass' : 'scan_attendance');
      setUseEntryPass(isEntryPassMode(savedMode));

      const savedRule =
        (typeof window !== 'undefined' && initialData.id ? (localStorage.getItem(`clubsync_passrule_${initialData.id}`) as PassApprovalRule | null) : null) ||
        (savedMode === 'manual_only' ? 'manual_only' : 'auto_after_payment');
      setPassRule(savedRule);

      setQrToken(initialData.qr_code_token || (initialData.id ? initialData.id.slice(0, 6).toUpperCase() : 'EV2026'));
      setStatus(initialData.status || 'Active');
      setDescription(initialData.description || '');
    } else {
      setEventName(''); setCategory(departments[0] || 'Member');
      setEventDate(new Date().toISOString().split('T')[0]); setEventTime('08:00 PM - 10:00 PM');
      setLocation('Student Activity Hall'); setRegistrationFee('0'); setDriverAllowance('5.00');
      setDriverRecruitmentOpen(true); setUseEntryPass(false); setPassRule('auto_after_payment');
      setQrToken(Math.random().toString(36).substring(2, 8).toUpperCase());
      setStatus('Active'); setDescription('');
    }
  }, [initialData, isOpen, departments]);

  if (!isOpen) return null;

  const eventId = initialData?.id || '';
  const eventRsvps = rsvps.filter((r) => r.budget_id === eventId);
  const attendingRsvps = eventRsvps.filter((r) => r.attendance === 'Attending');
  const eventPayments = feePayments.filter((f) => f.budget_id === eventId);
  const passengers = attendingRsvps.filter((r) => r.transport_type !== 'None' && !r.is_driver);
  const unassignedPassengers = passengers.filter((p) => !p.assigned_driver_name);
  const eventDrivers = attendingRsvps.filter((r) => r.is_driver);
  const reqFeeNum = Math.max(0, parseFloat(registrationFee) || 0);
  const allowanceNum = Math.max(0, parseFloat(driverAllowance) || 0);
  const modeValue: TicketQrMode = !useEntryPass ? 'scan_attendance' : passRule === 'manual_only' ? 'manual_only' : 'entry_pass';

  const isMemberEligibleForPass = (rsvp: EventRsvp) => {
    if (rsvp.attendance !== 'Attending') return false;
    if (localPassOverrides[rsvp.id] !== undefined) return localPassOverrides[rsvp.id];
    if (rsvp.pass_approved === true) return true;
    if (passRule === 'auto_after_payment' && reqFeeNum > 0) {
      return eventPayments.some((f) => f.user_id === rsvp.user_id && f.status === 'Verified');
    }
    return false;
  };

  const venueQrPayload = `CLUBSYNC_QR::v1::${eventId}::${qrToken}`;
  const venueQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=10&data=${encodeURIComponent(venueQrPayload)}`;

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    try {
      const basePayload = {
        event_name: eventName.trim(), category, event_date: eventDate, event_time: eventTime.trim(),
        location: location.trim(), registration_fee: reqFeeNum, driver_allowance_per_trip: allowanceNum,
        driver_recruitment_open: driverRecruitmentOpen, qr_code_token: qrToken,
        description: description.trim(), status,
      };
      if (isEditing && eventId) {
        if (typeof window !== 'undefined') {
          localStorage.setItem(`clubsync_qrmode_${eventId}`, modeValue);
          localStorage.setItem(`clubsync_passrule_${eventId}`, passRule);
        }
        const { error } = await supabase.from('budgets').update({ ...basePayload, ticket_qr_mode: modeValue }).eq('id', eventId);
        if (error) await supabase.from('budgets').update(basePayload).eq('id', eventId);
        onSuccess(`Saved "${eventName.trim()}"!`);
      } else {
        const { data: created, error } = await supabase.from('budgets').insert({ ...basePayload, ticket_qr_mode: modeValue, allocated_amount: 0, spent_amount: 0 }).select('*').single();
        if (error) {
          const { data: fallback } = await supabase.from('budgets').insert({ ...basePayload, allocated_amount: 0, spent_amount: 0 }).select('*').single();
          if (fallback && typeof window !== 'undefined') {
            localStorage.setItem(`clubsync_qrmode_${fallback.id}`, modeValue);
            localStorage.setItem(`clubsync_passrule_${fallback.id}`, passRule);
          }
        } else if (created && typeof window !== 'undefined') {
          localStorage.setItem(`clubsync_qrmode_${created.id}`, modeValue);
          localStorage.setItem(`clubsync_passrule_${created.id}`, passRule);
        }
        onSuccess(`Published "${eventName.trim()}"!`);
      }
      onClose();
    } finally {
      setSaving(false);
    }
  };

  // In-place Grant / Lock Pass (Never jumps out of the current drawer!)
  const handleToggleMemberPass = async (rsvp: EventRsvp) => {
    const nextVal = !isMemberEligibleForPass(rsvp);
    setLocalPassOverrides((prev) => ({ ...prev, [rsvp.id]: nextVal }));
    await supabase.from('event_rsvps').update({ pass_approved: nextVal }).eq('id', rsvp.id);
    onSuccess(`${nextVal ? 'Granted' : 'Locked'} pass for ${rsvp.student_name}.`);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/75 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white text-slate-900 rounded-3xl shadow-2xl border border-slate-200 max-w-3xl w-full overflow-hidden my-8">
        <div className="bg-slate-900 text-white px-6 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2.5">
            <Calendar className="w-5 h-5 text-emerald-400" />
            <h2 className="text-base font-bold">{isEditing ? `Edit Activity — ${eventName}` : 'New Activity'}</h2>
          </div>
          <button type="button" onClick={onClose} className="text-slate-400 hover:text-white cursor-pointer"><X className="w-5 h-5" /></button>
        </div>

        <form onSubmit={handleSave} className="p-6 max-h-[80vh] overflow-y-auto space-y-4 text-xs">
          {/* Core Activity Info */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div className="sm:col-span-2"><label className="block font-bold mb-1">Activity Name *</label><input type="text" value={eventName} onChange={(e) => setEventName(e.target.value)} className="w-full rounded-xl border px-3 py-2 text-sm font-bold" required /></div>
            <div><label className="block font-bold mb-1">Status</label><select value={status} onChange={(e) => setStatus(e.target.value as 'Active' | 'Closed')} className="w-full rounded-xl border bg-white px-3 py-2 text-sm font-bold"><option value="Active">Upcoming</option><option value="Closed">Past</option></select></div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-4 gap-3">
            <div><label className="block font-bold mb-1">Date *</label><input type="date" value={eventDate} onChange={(e) => setEventDate(e.target.value)} className="w-full rounded-xl border px-3 py-2" required /></div>
            <div><label className="block font-bold mb-1">Time *</label><input type="text" value={eventTime} onChange={(e) => setEventTime(e.target.value)} className="w-full rounded-xl border px-3 py-2" required /></div>
            <div><label className="block font-bold mb-1">Venue *</label><input type="text" value={location} onChange={(e) => setLocation(e.target.value)} className="w-full rounded-xl border px-3 py-2" required /></div>
            <div><label className="block font-bold mb-1">Department</label><select value={category} onChange={(e) => setCategory(e.target.value)} className="w-full rounded-xl border bg-white px-3 py-2 font-semibold">{departments.map((c) => (<option key={c} value={c}>{c}</option>))}</select></div>
          </div>

          <div><label className="block font-bold mb-1">Description *</label><textarea rows={2} value={description} onChange={(e) => setDescription(e.target.value)} className="w-full rounded-xl border px-3 py-2" required /></div>

          {/* Compact Action Buttons Bar (Hides all detailed settings & lists inside buttons until clicked) */}
          <div className="pt-2 border-t border-slate-200">
            <div className="flex flex-wrap gap-2">
              <button
                type="button"
                onClick={() => setOpenSection(openSection === 'settings' ? 'none' : 'settings')}
                className={`inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl font-bold transition cursor-pointer border ${
                  openSection === 'settings' ? 'bg-slate-900 text-white border-slate-900' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border-slate-200'
                }`}
              >
                <Settings className="w-4 h-4 text-emerald-500" />
                <span>Event Settings ({useEntryPass ? 'Entry Pass' : 'Scan Attendance'})</span>
              </button>

              {isEditing && (
                <>
                  <button
                    type="button"
                    onClick={() => setOpenSection(openSection === 'passes' ? 'none' : 'passes')}
                    className={`inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl font-bold transition cursor-pointer border ${
                      openSection === 'passes' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border-slate-200'
                    }`}
                  >
                    <QrCode className="w-4 h-4" />
                    <span>QR &amp; Grant Pass ({attendingRsvps.length})</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => setOpenSection(openSection === 'fees' ? 'none' : 'fees')}
                    className={`inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl font-bold transition cursor-pointer border ${
                      openSection === 'fees' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border-slate-200'
                    }`}
                  >
                    <CreditCard className="w-4 h-4" />
                    <span>Fee Payments ({eventPayments.length})</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => setOpenSection(openSection === 'carpool' ? 'none' : 'carpool')}
                    className={`inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl font-bold transition cursor-pointer border ${
                      openSection === 'carpool' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border-slate-200'
                    }`}
                  >
                    <Users className="w-4 h-4" />
                    <span>Carpool ({passengers.length}P / {eventDrivers.length}D)</span>
                  </button>
                </>
              )}
            </div>

            {/* 1. HIDDEN SETTINGS PANEL */}
            {openSection === 'settings' && (
              <div className="mt-3 p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
                <div>
                  <label className="block font-bold text-slate-800 mb-2">Attendance Type</label>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <button
                      type="button"
                      onClick={() => setUseEntryPass(false)}
                      className={`p-3 rounded-xl border text-left transition cursor-pointer ${!useEntryPass ? 'bg-emerald-600 text-white border-emerald-700' : 'bg-white text-slate-800 border-slate-200'}`}
                    >
                      <div className="font-bold flex items-center gap-1.5"><QrCode className="w-4 h-4" /><span>Scan Attendance Only</span></div>
                      <p className={`text-[11px] mt-0.5 ${!useEntryPass ? 'text-emerald-100' : 'text-slate-500'}`}>Members scan the event QR to record attendance automatically.</p>
                    </button>

                    <button
                      type="button"
                      onClick={() => setUseEntryPass(true)}
                      className={`p-3 rounded-xl border text-left transition cursor-pointer ${useEntryPass ? 'bg-emerald-600 text-white border-emerald-700' : 'bg-white text-slate-800 border-slate-200'}`}
                    >
                      <div className="font-bold flex items-center gap-1.5"><Ticket className="w-4 h-4" /><span>Entry Pass</span></div>
                      <p className={`text-[11px] mt-0.5 ${useEntryPass ? 'text-emerald-100' : 'text-slate-500'}`}>Members receive a personal Entry Pass QR code.</p>
                    </button>
                  </div>
                </div>

                {/* Entry Pass Approval Rule (Auto after payment vs Manual grant) */}
                {useEntryPass && (
                  <div className="p-3.5 rounded-xl bg-white border border-slate-200 space-y-2">
                    <label className="block font-bold text-slate-800">How do members receive their Entry Pass QR?</label>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      <label className={`flex items-center gap-2 p-2.5 rounded-lg border cursor-pointer ${passRule === 'auto_after_payment' ? 'border-emerald-600 bg-emerald-50/60 font-bold' : 'border-slate-200'}`}>
                        <input type="radio" checked={passRule === 'auto_after_payment'} onChange={() => setPassRule('auto_after_payment')} />
                        <span>Auto-grant pass after fee payment (or Admin grant)</span>
                      </label>
                      <label className={`flex items-center gap-2 p-2.5 rounded-lg border cursor-pointer ${passRule === 'manual_only' ? 'border-emerald-600 bg-emerald-50/60 font-bold' : 'border-slate-200'}`}>
                        <input type="radio" checked={passRule === 'manual_only'} onChange={() => setPassRule('manual_only')} />
                        <span>Manual grant by Admin only</span>
                      </label>
                    </div>
                  </div>
                )}

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-200">
                  <div>
                    <label className="block font-bold text-slate-700 mb-1"><CreditCard className="w-3.5 h-3.5 inline mr-1" />Activity Fee (RM)</label>
                    <input type="number" step="0.01" min="0" value={registrationFee} onChange={(e) => setRegistrationFee(e.target.value)} className="w-full rounded-xl border bg-white px-3 py-2 font-bold" />
                  </div>
                  <div>
                    <label className="block font-bold text-slate-700 mb-1"><Car className="w-3.5 h-3.5 inline mr-1" />Carpool Driver RM / Trip</label>
                    <input type="number" step="0.01" min="0" value={driverAllowance} onChange={(e) => setDriverAllowance(e.target.value)} className="w-full rounded-xl border bg-white px-3 py-2 font-bold" />
                  </div>
                  <div className="flex items-end pb-2">
                    <label className="flex items-center gap-2 font-bold text-slate-800 cursor-pointer"><input type="checkbox" checked={driverRecruitmentOpen} onChange={(e) => setDriverRecruitmentOpen(e.target.checked)} /><span>Enable Carpool</span></label>
                  </div>
                </div>
              </div>
            )}

            {/* 2. HIDDEN QR & GRANT PASS PANEL */}
            {openSection === 'passes' && isEditing && (
              <div className="mt-3 p-4 rounded-2xl bg-slate-50 border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-4">
                <div className="md:col-span-4 bg-white border rounded-2xl p-4 flex flex-col items-center text-center space-y-2">
                  <span className="text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full bg-emerald-600 text-white">Venue Attendance QR</span>
                  <img src={venueQrUrl} alt="Venue QR" className="w-36 h-36 object-contain" />
                  <button type="button" onClick={async () => { const tok = Math.random().toString(36).substring(2, 10).toUpperCase(); setQrToken(tok); await supabase.from('budgets').update({ qr_code_token: tok }).eq('id', eventId); onSuccess('Regenerated QR!'); }} className="w-full py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold cursor-pointer"><RefreshCw className="w-3 h-3 inline mr-1" />Reset QR</button>
                </div>
                <div className="md:col-span-8 space-y-2">
                  <div className="font-bold text-slate-800">Attending Members ({attendingRsvps.length})</div>
                  <div className="border bg-white rounded-xl overflow-hidden max-h-[220px] overflow-y-auto">
                    <table className="w-full text-left border-collapse">
                      <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Member</th><th className="py-2 px-3">Fee</th><th className="py-2 px-3">Status</th><th className="py-2 px-3 text-right">Pass</th></tr></thead>
                      <tbody className="divide-y">
                        {attendingRsvps.map((r) => {
                          const paid = eventPayments.find((f) => f.user_id === r.user_id && f.status === 'Verified');
                          const hasPass = isMemberEligibleForPass(r);
                          return (
                            <tr key={r.id}>
                              <td className="py-2 px-3 font-bold">{r.student_name}</td>
                              <td className="py-2 px-3">{reqFeeNum <= 0 ? '-' : paid ? <span className="text-emerald-700 font-bold">Paid ✓</span> : 'Unpaid'}</td>
                              <td className="py-2 px-3">{r.qr_checked_in ? <span className="text-emerald-700 font-bold"><ShieldCheck className="w-3.5 h-3.5 inline mr-0.5" />Attended</span> : hasPass ? <span className="text-emerald-700 font-bold">✓ Active</span> : <span className="text-slate-400">Locked</span>}</td>
                              <td className="py-2 px-3 text-right">
                                <button type="button" onClick={() => handleToggleMemberPass(r)} className={`px-2.5 py-1 rounded-lg font-bold cursor-pointer ${hasPass ? 'bg-rose-50 text-rose-700' : 'bg-emerald-600 text-white'}`}>{hasPass ? 'Lock' : 'Grant Pass'}</button>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            )}

            {/* 3. HIDDEN FEE PAYMENTS PANEL */}
            {openSection === 'fees' && isEditing && (
              <div className="mt-3 p-4 rounded-2xl bg-slate-50 border border-slate-200">
                <div className="border bg-white rounded-xl overflow-hidden max-h-[220px] overflow-y-auto">
                  <table className="w-full text-left border-collapse">
                    <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Student</th><th className="py-2 px-3">Amount</th><th className="py-2 px-3">Status</th><th className="py-2 px-3 text-right">Action</th></tr></thead>
                    <tbody className="divide-y">
                      {eventPayments.map((p) => (
                        <tr key={p.id}>
                          <td className="py-2 px-3 font-bold">{p.student_name}</td>
                          <td className="py-2 px-3 font-bold text-emerald-700">RM {Number(p.amount_paid).toFixed(2)}</td>
                          <td className="py-2 px-3">{p.status}</td>
                          <td className="py-2 px-3 text-right space-x-1">
                            <a href={p.receipt_url} target="_blank" rel="noopener noreferrer" className="px-2 py-1 rounded bg-slate-100"><ExternalLink className="w-3 h-3 inline" /></a>
                            <button type="button" onClick={async () => { await supabase.from('activity_fee_payments').update({ status: 'Verified' }).eq('id', p.id); onSuccess('Verified!'); }} className="px-2 py-1 rounded bg-emerald-600 text-white font-bold cursor-pointer">Verify</button>
                            <button type="button" onClick={async () => { await supabase.from('activity_fee_payments').update({ status: 'Rejected' }).eq('id', p.id); onSuccess('Rejected.'); }} className="px-2 py-1 rounded bg-rose-50 text-rose-700 font-bold cursor-pointer">Reject</button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* 4. HIDDEN CARPOOL PANEL */}
            {openSection === 'carpool' && isEditing && (
              <div className="mt-3 p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2.5">
                <div className="flex justify-between items-center">
                  <span className="font-bold">Passengers: {passengers.length} • Drivers: {eventDrivers.length}</span>
                  {eventDrivers.length > 0 && unassignedPassengers.length > 0 && (
                    <button type="button" onClick={async () => {
                      const tracker = eventDrivers.map((d) => ({ name: d.student_name, max: Number(d.seats_available) || 4, used: passengers.filter((p) => p.assigned_driver_name === d.student_name).length }));
                      for (const pax of unassignedPassengers) {
                        const drv = tracker.find((t) => t.used < t.max);
                        if (!drv) break;
                        await supabase.from('event_rsvps').update({ assigned_driver_name: drv.name }).eq('id', pax.id);
                        drv.used += 1;
                      }
                      onSuccess('Auto-assigned passengers!');
                    }} className="px-3 py-1 rounded-xl bg-emerald-600 text-white font-bold cursor-pointer"><Sparkles className="w-3 h-3 inline mr-1" />Auto-Assign</button>
                  )}
                </div>
                <div className="border bg-white rounded-xl overflow-hidden max-h-[200px] overflow-y-auto">
                  <table className="w-full text-left border-collapse">
                    <thead><tr className="bg-slate-50 border-b"><th className="py-2 px-3">Passenger</th><th className="py-2 px-3">Dorm</th><th className="py-2 px-3">Trip</th><th className="py-2 px-3">Driver</th></tr></thead>
                    <tbody className="divide-y">
                      {passengers.map((p) => (
                        <tr key={p.id}>
                          <td className="py-2 px-3 font-bold">{p.student_name}</td>
                          <td className="py-2 px-3">{p.dormitory || '-'}</td>
                          <td className="py-2 px-3">{p.transport_type}</td>
                          <td className="py-2 px-3">
                            <select value={p.assigned_driver_name || ''} onChange={async (e) => { await supabase.from('event_rsvps').update({ assigned_driver_name: e.target.value }).eq('id', p.id); onSuccess('Assigned!'); }} className="rounded border px-2 py-1 font-bold">
                              <option value="">-- Unassigned --</option>
                              {eventDrivers.map((d) => (<option key={d.id} value={d.student_name}>{d.student_name}</option>))}
                            </select>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </div>

          <div className="flex justify-end gap-2 pt-3 border-t border-slate-200">
            <button type="button" onClick={onClose} className="px-4 py-2 rounded-xl font-semibold text-slate-600 cursor-pointer">Cancel</button>
            <button type="submit" disabled={saving} className="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl font-bold bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer">{saving ? <Loader2 className="w-4 h-4 animate-spin" /> : <CheckCircle2 className="w-4 h-4" />}<span>{isEditing ? 'Save Changes' : 'Publish'}</span></button>
          </div>
        </form>
      </div>
    </div>
  );
}
</file>

<file path="src/components/CinematicHub.tsx">
import React, { useState, useEffect } from 'react';
import { supabase, Announcement, Poll, PollVote, UserProfile, MAX_FILE_SIZE_BYTES } from '@/lib/supabase';
import { Sparkles, ChevronLeft, ChevronRight, ExternalLink, Pin, BarChart2, PlusCircle, Trash2, X, CheckCircle2, Megaphone, Maximize2, Edit3, Eye, EyeOff } from 'lucide-react';

interface CinematicHubProps {
  announcements: Announcement[]; polls: Poll[]; pollVotes: PollVote[]; profile: UserProfile; isAdmin: boolean; onRefresh: (msg: string) => void;
}

export default function CinematicHub({ announcements, polls, pollVotes, profile, isAdmin, onRefresh }: CinematicHubProps) {
  const carouselSlides = announcements.filter((a) => a.show_in_carousel);
  const pinnedNotices = announcements.filter((a) => a.is_pinned);
  const [currentSlide, setCurrentSlide] = useState(0);
  const [selectedPoster, setSelectedPoster] = useState<Announcement | null>(null);

  const [showNoticeModal, setShowNoticeModal] = useState(false);
  const [editingNotice, setEditingNotice] = useState<Announcement | null>(null);
  const [title, setTitle] = useState('');
  const [subtitle, setSubtitle] = useState('');
  const [content, setContent] = useState('');
  const [posterUrl, setPosterUrl] = useState('');
  const [posterFile, setPosterFile] = useState<File | null>(null);
  const [externalLink, setExternalLink] = useState('');
  const [linkLabel, setLinkLabel] = useState('More Info');
  const [isPinned, setIsPinned] = useState(true);
  const [showInCarousel, setShowInCarousel] = useState(true);

  const [showPollModal, setShowPollModal] = useState(false);
  const [pollQuestion, setPollQuestion] = useState('');
  const [pollOptionsText, setPollOptionsText] = useState('Option A\nOption B\nOption C');
  const [newPollShowNumbers, setNewPollShowNumbers] = useState(true);
  const [hiddenPollsMap, setHiddenPollsMap] = useState<Record<string, boolean>>({});

  useEffect(() => {
    if (typeof window !== 'undefined') {
      const raw = localStorage.getItem('clubsync_hidden_polls');
      if (raw) {
        try { setHiddenPollsMap(JSON.parse(raw)); } catch { /* ignore */ }
      }
    }
  }, []);

  useEffect(() => {
    if (carouselSlides.length <= 1 || selectedPoster) return;
    const timer = setInterval(() => setCurrentSlide((prev) => (prev + 1) % carouselSlides.length), 5000);
    return () => clearInterval(timer);
  }, [carouselSlides.length, selectedPoster]);

  const isPollNumbersHidden = (poll: Poll) => {
    if (poll.question.startsWith('[HIDE_NUM]')) return true;
    if (hiddenPollsMap[poll.id] !== undefined) return hiddenPollsMap[poll.id];
    if (poll.show_results === false) return true;
    return false;
  };

  const cleanPollQuestion = (q: string) => q.replace(/^\[HIDE_NUM\]\s*/, '');

  const togglePollNumbersVisibility = async (poll: Poll) => {
    const currentlyHidden = isPollNumbersHidden(poll);
    const nextHidden = !currentlyHidden;
    const updatedMap = { ...hiddenPollsMap, [poll.id]: nextHidden };
    setHiddenPollsMap(updatedMap);
    if (typeof window !== 'undefined') localStorage.setItem('clubsync_hidden_polls', JSON.stringify(updatedMap));

    const cleanQ = cleanPollQuestion(poll.question);
    const encodedQ = nextHidden ? `[HIDE_NUM] ${cleanQ}` : cleanQ;
    await supabase.from('polls').update({ question: encodedQ }).eq('id', poll.id);
    onRefresh(nextHidden ? 'Live poll numbers hidden from members.' : 'Live poll numbers visible to everyone.');
  };

  const handleSaveNotice = async (e: React.FormEvent) => {
    e.preventDefault();
    let finalPosterUrl = posterUrl.trim();
    if (posterFile && posterFile.size <= MAX_FILE_SIZE_BYTES) {
      const path = `posters/${Date.now()}.${posterFile.name.split('.').pop() || 'jpg'}`;
      const { error } = await supabase.storage.from('receipts').upload(path, posterFile);
      if (!error) finalPosterUrl = supabase.storage.from('receipts').getPublicUrl(path).data.publicUrl;
    }
    const payload = {
      title: title.trim(), subtitle: subtitle.trim(), content: content.trim(),
      poster_url: finalPosterUrl || 'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=1400&q=80',
      external_link: externalLink.trim(), link_label: linkLabel.trim() || 'More Details',
      is_pinned: isPinned, show_in_carousel: showInCarousel, created_by: profile.full_name,
    };
    if (editingNotice) await supabase.from('announcements').update(payload).eq('id', editingNotice.id);
    else await supabase.from('announcements').insert(payload);
    setShowNoticeModal(false);
    onRefresh('Saved!');
  };

  const handleCreatePoll = async (e: React.FormEvent) => {
    e.preventDefault();
    const opts = pollOptionsText.split('\n').map((s) => s.trim()).filter(Boolean);
    if (!pollQuestion.trim() || opts.length < 2) return;
    const finalQuestion = newPollShowNumbers ? pollQuestion.trim() : `[HIDE_NUM] ${pollQuestion.trim()}`;
    await supabase.from('polls').insert({ question: finalQuestion, options: opts, is_active: true, created_by: profile.full_name });
    setPollQuestion(''); setShowPollModal(false); onRefresh('Poll published!');
  };

  const activeSlide = carouselSlides.length > 0 ? carouselSlides[currentSlide % carouselSlides.length] : null;

  return (
    <div className="space-y-6">
      {activeSlide && (
        <div className="relative rounded-3xl overflow-hidden shadow-xl bg-slate-950 group border border-white/10">
          <div onClick={() => setSelectedPoster(activeSlide)} className="relative h-[280px] sm:h-[340px] w-full cursor-pointer overflow-hidden">
            <img src={activeSlide.poster_url} alt={activeSlide.title} className="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700" />
            <div className="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/45 to-transparent" />
            <div className="absolute top-4 left-4 right-4 flex justify-between items-center">
              <span className="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-bold uppercase bg-emerald-600/90 text-white backdrop-blur-md"><Sparkles className="w-3 h-3 text-amber-200" /><span>{activeSlide.subtitle || 'Featured'}</span></span>
              <div className="flex gap-2" onClick={(e) => e.stopPropagation()}>
                {isAdmin && <button type="button" onClick={() => { setEditingNotice(null); setTitle(''); setContent(''); setPosterUrl(''); setExternalLink(''); setShowNoticeModal(true); }} className="px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-900 cursor-pointer">+ Add Poster</button>}
                <button type="button" onClick={() => setSelectedPoster(activeSlide)} className="px-3 py-1.5 rounded-xl text-xs font-bold bg-white/15 text-white backdrop-blur-md cursor-pointer"><Maximize2 className="w-3.5 h-3.5 inline mr-1" />View</button>
              </div>
            </div>
            <div className="absolute bottom-5 left-6 right-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
              <div className="max-w-2xl">
                <h2 className="text-xl sm:text-2xl font-extrabold text-white">{activeSlide.title}</h2>
                <p className="text-xs sm:text-sm text-slate-200 line-clamp-2 mt-1">{activeSlide.content}</p>
              </div>
              {activeSlide.external_link && (
                <a href={activeSlide.external_link} target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()} className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shrink-0">
                  <span>{activeSlide.link_label || 'Open Link'}</span><ExternalLink className="w-3.5 h-3.5" />
                </a>
              )}
            </div>
          </div>
          {carouselSlides.length > 1 && (
            <>
              <button type="button" onClick={() => setCurrentSlide((p) => (p - 1 + carouselSlides.length) % carouselSlides.length)} className="absolute left-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white cursor-pointer"><ChevronLeft className="w-5 h-5" /></button>
              <button type="button" onClick={() => setCurrentSlide((p) => (p + 1) % carouselSlides.length)} className="absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white cursor-pointer"><ChevronRight className="w-5 h-5" /></button>
            </>
          )}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 text-slate-900">
        <div className="lg:col-span-7 bg-white/85 backdrop-blur-xl rounded-3xl border border-white/80 p-5 space-y-3 shadow-xs">
          <div className="flex justify-between items-center border-b border-slate-100 pb-2.5">
            <div className="flex items-center gap-2"><Megaphone className="w-4 h-4 text-emerald-600" /><h3 className="text-sm font-extrabold">Announcements</h3></div>
            {isAdmin && <button type="button" onClick={() => { setEditingNotice(null); setTitle(''); setContent(''); setPosterUrl(''); setExternalLink(''); setShowNoticeModal(true); }} className="px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 cursor-pointer">+ Add</button>}
          </div>
          <div className="space-y-2 max-h-[240px] overflow-y-auto">
            {pinnedNotices.map((n) => (
              <div key={n.id} onClick={() => setSelectedPoster(n)} className="p-3 rounded-2xl bg-slate-50/80 hover:bg-emerald-50/50 border border-slate-200/70 cursor-pointer flex justify-between gap-2 text-xs transition">
                <div>
                  <div className="font-bold text-slate-900 flex items-center gap-1.5"><Pin className="w-3 h-3 text-emerald-600 shrink-0" /><span>{n.title}</span></div>
                  <p className="text-slate-600 line-clamp-2 mt-0.5">{n.content}</p>
                </div>
                {isAdmin && (
                  <div className="flex gap-1 shrink-0" onClick={(e) => e.stopPropagation()}>
                    <button type="button" onClick={() => { setEditingNotice(n); setTitle(n.title); setSubtitle(n.subtitle || ''); setContent(n.content); setPosterUrl(n.poster_url || ''); setExternalLink(n.external_link || ''); setLinkLabel(n.link_label || ''); setIsPinned(n.is_pinned); setShowInCarousel(n.show_in_carousel); setShowNoticeModal(true); }} className="p-1 text-slate-500 hover:text-slate-900"><Edit3 className="w-3.5 h-3.5" /></button>
                    <button type="button" onClick={async () => { await supabase.from('announcements').delete().eq('id', n.id); onRefresh('Deleted.'); }} className="p-1 text-slate-400 hover:text-rose-600"><Trash2 className="w-3.5 h-3.5" /></button>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <div className="lg:col-span-5 bg-white/85 backdrop-blur-xl rounded-3xl border border-white/80 p-5 space-y-3 shadow-xs">
          <div className="flex justify-between items-center border-b border-slate-100 pb-2.5">
            <div className="flex items-center gap-2"><BarChart2 className="w-4 h-4 text-emerald-600" /><h3 className="text-sm font-extrabold">Polls</h3></div>
            {isAdmin && <button type="button" onClick={() => setShowPollModal(true)} className="px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 cursor-pointer">+ New Poll</button>}
          </div>
          <div className="space-y-3 max-h-[240px] overflow-y-auto">
            {polls.map((poll) => {
              const votes = pollVotes.filter((v) => v.poll_id === poll.id);
              const myVote = votes.find((v) => v.user_id === profile.id);
              const hideNumbers = isPollNumbersHidden(poll);
              const canSeeNumbers = !hideNumbers || isAdmin;

              return (
                <div key={poll.id} className="p-3.5 rounded-2xl bg-slate-50/80 border border-slate-200/70 space-y-2 text-xs">
                  <div className="flex items-start justify-between gap-2">
                    <h4 className="font-bold text-slate-900">{cleanPollQuestion(poll.question)}</h4>
                    {isAdmin && (
                      <div className="flex items-center gap-1 shrink-0">
                        <button
                          type="button"
                          onClick={() => togglePollNumbersVisibility(poll)}
                          className={`px-2 py-0.5 rounded-lg text-[10px] font-bold flex items-center gap-1 cursor-pointer border ${
                            hideNumbers ? 'bg-slate-200 text-slate-700 border-slate-300' : 'bg-emerald-50 text-emerald-800 border-emerald-200'
                          }`}
                          title="Toggle live vote numbers visibility for members"
                        >
                          {hideNumbers ? <EyeOff className="w-3 h-3" /> : <Eye className="w-3 h-3" />}
                          <span>{hideNumbers ? 'Numbers Hidden' : 'Live Numbers'}</span>
                        </button>
                        <button type="button" onClick={async () => { await supabase.from('polls').delete().eq('id', poll.id); onRefresh('Poll deleted.'); }} className="p-1 text-slate-400 hover:text-rose-600 cursor-pointer"><Trash2 className="w-3.5 h-3.5" /></button>
                      </div>
                    )}
                  </div>
                  <div className="space-y-1.5">
                    {(poll.options || []).map((opt, idx) => {
                      const count = votes.filter((v) => v.option_index === idx).length;
                      const pct = votes.length > 0 ? Math.round((count / votes.length) * 100) : 0;
                      const isMine = myVote?.option_index === idx;
                      return (
                        <button
                          type="button"
                          key={idx}
                          onClick={async () => {
                            await supabase.from('poll_votes').upsert({ poll_id: poll.id, user_id: profile.id, voter_name: profile.full_name, option_index: idx }, { onConflict: 'poll_id,user_id' });
                            onRefresh('Vote recorded!');
                          }}
                          className={`w-full text-left relative overflow-hidden rounded-xl border p-2.5 transition cursor-pointer ${isMine ? 'border-emerald-600 bg-emerald-50/60' : 'border-slate-200 bg-white hover:border-slate-300'}`}
                        >
                          {canSeeNumbers && <div className="absolute inset-y-0 left-0 bg-emerald-500/15 transition-all" style={{ width: `${pct}%` }} />}
                          <div className="relative flex justify-between items-center font-semibold">
                            <span className="flex items-center gap-1.5">{isMine && <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />}{opt}</span>
                            {canSeeNumbers && (
                              <span className="text-[11px] font-mono text-slate-500">
                                {pct}% ({count})
                              </span>
                            )}
                          </div>
                        </button>
                      );
                    })}
                  </div>
                  <div className="flex justify-between text-[10px] text-slate-400">
                    <span>{canSeeNumbers ? `${votes.length} vote(s)` : 'Live count hidden'}</span>
                    {hideNumbers && isAdmin && <span>(Visible to Admin only)</span>}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {selectedPoster && (
        <div onClick={() => setSelectedPoster(null)} className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4 overflow-y-auto">
          <div onClick={(e) => e.stopPropagation()} className="bg-white text-slate-900 rounded-3xl max-w-3xl w-full overflow-hidden grid grid-cols-1 md:grid-cols-2">
            <div className="bg-slate-950 flex items-center justify-center max-h-[450px]"><img src={selectedPoster.poster_url} alt={selectedPoster.title} className="w-full h-full object-contain" /></div>
            <div className="p-6 flex flex-col justify-between space-y-4">
              <div className="space-y-2">
                <div className="flex justify-between"><span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">{selectedPoster.subtitle || 'Spotlight'}</span><button type="button" onClick={() => setSelectedPoster(null)}><X className="w-5 h-5" /></button></div>
                <h2 className="text-lg font-extrabold">{selectedPoster.title}</h2>
                <p className="text-xs text-slate-600 whitespace-pre-line">{selectedPoster.content}</p>
              </div>
              {selectedPoster.external_link && (
                <a href={selectedPoster.external_link} target="_blank" rel="noopener noreferrer" className="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-emerald-600 text-white text-center">
                  {selectedPoster.link_label || 'Open Link'} <ExternalLink className="w-3.5 h-3.5 inline ml-1" />
                </a>
              )}
            </div>
          </div>
        </div>
      )}

      {showNoticeModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4 overflow-y-auto">
          <div className="bg-white text-slate-900 rounded-3xl max-w-lg w-full overflow-hidden my-8">
            <div className="bg-slate-900 text-white px-6 py-4 flex justify-between"><h3 className="text-sm font-bold">Publish Poster / Notice</h3><button type="button" onClick={() => setShowNoticeModal(false)}><X className="w-5 h-5" /></button></div>
            <form onSubmit={handleSaveNotice} className="p-6 space-y-3 text-xs">
              <input type="text" value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Headline *" className="w-full rounded-xl border px-3 py-2 text-sm font-bold" required />
              <input type="text" value={subtitle} onChange={(e) => setSubtitle(e.target.value)} placeholder="Badge text" className="w-full rounded-xl border px-3 py-2" />
              <textarea rows={3} value={content} onChange={(e) => setContent(e.target.value)} placeholder="Details *" className="w-full rounded-xl border px-3 py-2" required />
              <input type="file" accept="image/*" onChange={(e) => setPosterFile(e.target.files?.[0] || null)} className="w-full" />
              <input type="url" value={posterUrl} onChange={(e) => setPosterUrl(e.target.value)} placeholder="Or Paste Image URL" className="w-full rounded-xl border px-3 py-2" />
              <div className="grid grid-cols-2 gap-2">
                <input type="url" value={externalLink} onChange={(e) => setExternalLink(e.target.value)} placeholder="External Link" className="rounded-xl border px-3 py-2" />
                <input type="text" value={linkLabel} onChange={(e) => setLinkLabel(e.target.value)} placeholder="Button Label" className="rounded-xl border px-3 py-2" />
              </div>
              <div className="flex gap-4">
                <label className="flex items-center gap-1 font-bold"><input type="checkbox" checked={showInCarousel} onChange={(e) => setShowInCarousel(e.target.checked)} />Show in Banner</label>
                <label className="flex items-center gap-1 font-bold"><input type="checkbox" checked={isPinned} onChange={(e) => setIsPinned(e.target.checked)} />Pin to Notices</label>
              </div>
              <div className="flex justify-end gap-2"><button type="button" onClick={() => setShowNoticeModal(false)} className="px-4 py-2">Cancel</button><button type="submit" className="px-5 py-2 rounded-xl bg-emerald-600 text-white font-bold">Publish</button></div>
            </form>
          </div>
        </div>
      )}

      {showPollModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 p-4">
          <div className="bg-white text-slate-900 rounded-3xl max-w-md w-full overflow-hidden">
            <div className="bg-slate-900 text-white px-6 py-4 flex justify-between"><h3 className="text-sm font-bold">Create Poll</h3><button type="button" onClick={() => setShowPollModal(false)}><X className="w-5 h-5" /></button></div>
            <form onSubmit={handleCreatePoll} className="p-6 space-y-3 text-xs">
              <input type="text" value={pollQuestion} onChange={(e) => setPollQuestion(e.target.value)} placeholder="Question *" className="w-full rounded-xl border px-3 py-2 text-sm font-bold" required />
              <textarea rows={4} value={pollOptionsText} onChange={(e) => setPollOptionsText(e.target.value)} placeholder="1 option per line *" className="w-full rounded-xl border px-3 py-2" required />
              <label className="flex items-center gap-2 font-bold text-slate-800 pt-1 cursor-pointer">
                <input type="checkbox" checked={newPollShowNumbers} onChange={(e) => setNewPollShowNumbers(e.target.checked)} />
                <span>Show live vote numbers to members</span>
              </label>
              <div className="flex justify-end gap-2 pt-2"><button type="button" onClick={() => setShowPollModal(false)} className="px-4 py-2">Cancel</button><button type="submit" className="px-5 py-2 rounded-xl bg-emerald-600 text-white font-bold">Publish</button></div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
