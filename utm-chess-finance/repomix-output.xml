        </div>
      )}

      {permModalTarget && isOwner && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 p-4 overflow-y-auto">
          <div className="bg-white text-slate-900 rounded-3xl max-w-lg w-full overflow-hidden my-8">
            <div className="bg-slate-900 text-white px-6 py-4 flex justify-between items-center">
              <span className="text-sm font-bold">
                <Shield className="w-4 h-4 inline mr-1.5 text-amber-300" />
                Permissions — {permModalTarget.full_name}
              </span>
              <button type="button" onClick={() => setPermModalTarget(null)}>
                <X className="w-5 h-5" />
              </button>
            </div>
            <form
              onSubmit={async (e) => {
                e.preventDefault();
                await supabase
                  .from('users')
                  .update({ role: 'treasurer', admin_permissions: editingPerms })
                  .eq('id', permModalTarget.id);
                setPermModalTarget(null);
                fetchAllData();
                showToast('Permissions updated');
              }}
              className="p-6 space-y-2.5 text-xs"
            >
              {PERMISSION_LABELS.map((item) => (
                <label key={item.key} className="flex items-start gap-2.5 p-2.5 rounded-xl border cursor-pointer">
                  <input
                    type="checkbox"
                    checked={editingPerms[item.key]}
                    onChange={(e) => setEditingPerms((p) => ({ ...p, [item.key]: e.target.checked }))}
                    className="mt-0.5"
                  />
                  <div>
                    <div className="font-bold">{item.label}</div>
                    <div className="text-slate-500">{item.desc}</div>
                  </div>
                </label>
              ))}
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setPermModalTarget(null)} className="px-4 py-2">
                  Cancel
                </button>
                <button type="submit" className="px-5 py-2 rounded-xl bg-emerald-600 text-white font-bold">
                  Save
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      <QrScannerModal
        isOpen={isQrScannerOpen}
        onClose={() => setIsQrScannerOpen(false)}
        budgets={activeBudgets}
        rsvps={activeRsvps}
        feePayments={activeFeePayments}
        profile={profile}
        isAdmin={isAdminOrOwner}
        equipmentItems={activeEquipmentItems}
        equipmentLoans={activeEquipmentLoans}
        onSuccess={(m: string) => {
          showToast(m);
          fetchAllData();
        }}
      />
      <EventOperationsModal
        event={opsModalEvent}
        initialTab={opsModalTab}
        profile={profile}
        isAdmin={isAdminOrOwner}
        permissions={effectivePermissions}
        rsvps={activeRsvps}
        feePayments={activeFeePayments}
        claims={activeClaims}
        logs={activityLogs}
        paymentQrUrl={paymentQrUrl}
        paymentBankInfo={paymentBankInfo}
        onClose={() => setOpsModalEvent(null)}
        onOpenScanner={() => setIsQrScannerOpen(true)}
        onRefresh={(m: string) => {
          showToast(m);
          fetchAllData();
        }}
      />
      <ClaimFormModal
        isOpen={isClaimModalOpen}
        onClose={() => setIsClaimModalOpen(false)}
        budgets={activeBudgets}
        departments={departments}
        profile={profile}
        onSuccess={(m: string) => {
          showToast(m);
          fetchAllData();
        }}
      />
      <AuditReviewModal
        claim={selectedClaim}
        budget={activeBudgets.find((b) => b.id === selectedClaim?.budget_id)}
        budgets={activeBudgets}
        departments={departments}
        logs={activityLogs}
        profile={{ ...profile, role: isAdminOrOwner && effectivePermissions.can_manage_claims_fees ? (isOwner ? 'owner' : 'treasurer') : 'member' }}
        isOwner={isOwner}
        isClaimantOwner={isUserClubOwner(selectedClaim?.user_id)}
        approvalThreshold={claimThreshold}
        onClose={() => setSelectedClaim(null)}
        onUpdated={(m: string) => {
          showToast(m);
          fetchAllData();
        }}
      />
      <BudgetModal
        isOpen={isBudgetModalOpen}
        onClose={() => {
          setIsBudgetModalOpen(false);
          setEditingActivity(null);
        }}
        initialData={editingActivity}
        departments={departments}
        rsvps={activeRsvps}
        feePayments={activeFeePayments}
        profile={profile}
        logs={activityLogs}
        onSuccess={(m: string) => {
          showToast(m);
          fetchAllData();
        }}
      />
      <RecordHistoryModal
        target={historyTarget}
        logs={activityLogs}
        onClose={() => setHistoryTarget(null)}
      />
    </div>
  );
}
</file>

<file path="src/components/ActivityLogSection.tsx">
'use client';

import React, { useState } from 'react';
import { ActivityLogEntry, ActivityLogCategory, UserProfile } from '@/lib/supabase';
import {
  stripHistoryTag,
  parseHistoryMetaFromLog,
  getAllHistoryEvents,
  getCurrentlyDeletedEvents,
  restoreSoftDeletedRecord,
  tableDisplayLabel,
} from '@/lib/history';
import {
  ShieldCheck,
  Search,
  Download,
  RefreshCw,
  Clock,
  Wallet,
  Receipt,
  CreditCard,
  Package,
  Calendar,
  Users,
  Car,
  QrCode,
  Settings,
  History,
  RotateCcw,
  Trash2,
  ArrowRight,
  Loader2,
} from 'lucide-react';

interface ActivityLogSectionProps {
  logs: ActivityLogEntry[];
  profile?: UserProfile;
  onRefresh: (msg: string) => void;
}

const CATEGORIES: ('ALL' | ActivityLogCategory)[] = [
  'ALL',
  'Finance',
  'Claims',
  'Fees',
  'Equipment',
  'Activities',
  'Carpool',
  'Attendance',
  'Members',
  'Settings',
];

function categoryStyle(cat: string) {
  switch (cat) {
    case 'Finance':
      return { pill: 'bg-emerald-100 text-emerald-900 border-emerald-200', Icon: Wallet };
    case 'Claims':
      return { pill: 'bg-indigo-100 text-indigo-900 border-indigo-200', Icon: Receipt };
    case 'Fees':
      return { pill: 'bg-amber-100 text-amber-900 border-amber-200', Icon: CreditCard };
    case 'Equipment':
      return { pill: 'bg-sky-100 text-sky-900 border-sky-200', Icon: Package };
    case 'Activities':
      return { pill: 'bg-teal-100 text-teal-900 border-teal-200', Icon: Calendar };
    case 'Carpool':
      return { pill: 'bg-purple-100 text-purple-900 border-purple-200', Icon: Car };
    case 'Attendance':
      return { pill: 'bg-cyan-100 text-cyan-900 border-cyan-200', Icon: QrCode };
    case 'Members':
      return { pill: 'bg-rose-100 text-rose-900 border-rose-200', Icon: Users };
    default:
      return { pill: 'bg-slate-100 text-slate-800 border-slate-200', Icon: Settings };
  }
}

function formatLogTime(iso: string) {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleString(undefined, {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}

export default function ActivityLogSection({ logs, profile, onRefresh }: ActivityLogSectionProps) {
  const [viewMode, setViewMode] = useState<'all' | 'edits' | 'deleted'>('all');
  const [catFilter, setCatFilter] = useState<'ALL' | ActivityLogCategory>('ALL');
  const [search, setSearch] = useState('');
  const [restoringKey, setRestoringKey] = useState<string | null>(null);

  const allEditEvents = getAllHistoryEvents(logs).filter((ev) => ev.action === 'edited');
  const currentlyDeleted = getCurrentlyDeletedEvents(logs);

  const matchesSearch = (parts: (string | undefined | null)[]) => {
    if (!search.trim()) return true;
    const q = search.toLowerCase();
    return parts.some((p) => p?.toLowerCase().includes(q));
  };

  const filtered = logs.filter((l) => {
    if (catFilter !== 'ALL' && l.category !== catFilter) return false;
    const cleanDetails = stripHistoryTag(l.details || '');
    return matchesSearch([l.actor_name, l.actor_matric, l.action, cleanDetails, l.category]);
  });

  const filteredEdits = allEditEvents.filter((ev) => {
    if (catFilter !== 'ALL' && ev.category !== catFilter) return false;
    return matchesSearch([
      ev.actorName,
      ev.actorMatric,
      ev.recordTitle,
      tableDisplayLabel(ev.table),
      ev.summary,
      ...ev.changes.flatMap((c) => [c.field, c.before, c.after]),
    ]);
  });

  const filteredDeleted = currentlyDeleted.filter((ev) => {
    if (catFilter !== 'ALL' && ev.category !== catFilter) return false;
    return matchesSearch([
      ev.actorName,
      ev.actorMatric,
      ev.recordTitle,
      tableDisplayLabel(ev.table),
      ev.summary,
    ]);
  });

  const handleExportCsv = () => {
    const headers = ['Timestamp', 'Actor', 'Matric No', 'Role', 'Category', 'Action', 'Details'];
    const rows = filtered.map((l) => [
      l.created_at,
      l.actor_name,
      l.actor_matric || '-',
      l.actor_role || '-',
      l.category,
      l.action,
      stripHistoryTag(l.details || ''),
    ]);
    const csv = [
      headers.join(','),
      ...rows.map((r) => r.map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(',')),
    ].join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    a.download = `ClubSync_Security_Audit_Log_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
  };

  return (
    <div className="space-y-5 text-slate-900">
      <div className="bg-white/90 backdrop-blur-xl rounded-3xl border border-emerald-200/80 p-5 shadow-2xs flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
            <ShieldCheck className="w-5 h-5" />
          </div>
          <div>
            <h2 className="text-base font-extrabold text-slate-900">Security, Edit History &amp; Audit Log</h2>
            <p className="text-xs text-slate-500">
              Tamper-evident Before → After edit history and web-deleted archive (records stay intact in Supabase).
            </p>
          </div>
        </div>
        <div className="flex flex-wrap items-center gap-2 text-xs">
          <div className="relative">
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search name, matric, action..."
              className="pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 bg-white text-xs w-52"
            />
          </div>
          <button
            type="button"
            onClick={() => onRefresh('Refreshed audit log.')}
            className="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold cursor-pointer"
          >
            <RefreshCw className="w-3.5 h-3.5" />
            <span>Refresh</span>
          </button>
          <button
            type="button"
            onClick={handleExportCsv}
            className="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold cursor-pointer"
          >
            <Download className="w-3.5 h-3.5" />
            <span>Export CSV</span>
          </button>
        </div>
      </div>

      {/* View mode switcher */}
      <div className="flex flex-wrap gap-2">
        <button
          type="button"
          onClick={() => setViewMode('all')}
          className={`inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl text-xs font-extrabold border cursor-pointer transition ${
            viewMode === 'all'
              ? 'bg-emerald-600 text-white border-emerald-600 shadow-2xs'
              : 'bg-white/90 text-slate-700 border-emerald-200/80 hover:bg-emerald-50'
          }`}
        >
          <ShieldCheck className="w-3.5 h-3.5" />
          <span>All Logs ({logs.length})</span>
        </button>
        <button
          type="button"
          onClick={() => setViewMode('edits')}
          className={`inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl text-xs font-extrabold border cursor-pointer transition ${
            viewMode === 'edits'
              ? 'bg-amber-600 text-white border-amber-600 shadow-2xs'
              : 'bg-white/90 text-slate-700 border-emerald-200/80 hover:bg-amber-50'
          }`}
        >
          <History className="w-3.5 h-3.5" />
          <span>Edit History (Before → After) ({allEditEvents.length})</span>
        </button>
        <button
          type="button"
          onClick={() => setViewMode('deleted')}
          className={`inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl text-xs font-extrabold border cursor-pointer transition ${
            viewMode === 'deleted'
              ? 'bg-rose-600 text-white border-rose-600 shadow-2xs'
              : 'bg-white/90 text-slate-700 border-emerald-200/80 hover:bg-rose-50'
          }`}
        >
          <Trash2 className="w-3.5 h-3.5" />
          <span>Deleted Records (Kept in Supabase) ({currentlyDeleted.length})</span>
        </button>
      </div>

      <div className="flex flex-wrap gap-1.5 bg-white/85 backdrop-blur-xl p-2 rounded-2xl border border-emerald-200/80 text-xs">
        {CATEGORIES.map((c) => (
          <button
            type="button"
            key={c}
            onClick={() => setCatFilter(c)}
            className={`px-3 py-1.5 rounded-xl font-bold cursor-pointer transition ${
              catFilter === c ? 'bg-emerald-600 text-white shadow-2xs' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            {c === 'ALL' ? `All (${logs.length})` : c}
          </button>
        ))}
      </div>

      {viewMode === 'all' && (
        <div className="bg-white/95 backdrop-blur-xl rounded-3xl border border-emerald-200/80 overflow-hidden shadow-2xs">
          {filtered.length === 0 ? (
            <div className="p-10 text-center space-y-2 text-xs text-slate-400">
              <Clock className="w-8 h-8 text-slate-300 mx-auto" />
              <p className="font-bold text-slate-600">No audit entries match this filter yet.</p>
              <p>New actions (approving claims, updating savings, paying fees, borrowing equipment, assigning carpool, etc.) will appear here automatically.</p>
            </div>
          ) : (
            <div className="divide-y divide-slate-100">
              {filtered.map((entry) => {
                const { pill, Icon } = categoryStyle(entry.category);
                const meta = parseHistoryMetaFromLog(entry);
                const cleanDetails = stripHistoryTag(entry.details || '');
                return (
                  <div key={entry.id} className="p-4 hover:bg-slate-50/80 flex flex-wrap items-start justify-between gap-3 text-xs">
                    <div className="flex items-start gap-3 min-w-0 flex-1">
                      <div className={`w-8 h-8 rounded-xl border flex items-center justify-center shrink-0 mt-0.5 ${pill}`}>
                        <Icon className="w-4 h-4" />
                      </div>
                      <div className="min-w-0 space-y-1 flex-1">
                        <div className="flex flex-wrap items-center gap-1.5">
                          <span className={`px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase border ${pill}`}>
                            {entry.category}
                          </span>
                          <span className="font-extrabold text-slate-900">{entry.action}</span>
                          {meta && (
                            <span
                              className={`px-2 py-0.5 rounded-md text-[10px] font-bold uppercase ${
                                meta.action === 'deleted'
                                  ? 'bg-rose-100 text-rose-800'
                                  : meta.action === 'restored'
                                  ? 'bg-emerald-100 text-emerald-800'
                                  : 'bg-amber-100 text-amber-800'
                              }`}
                            >
                              {tableDisplayLabel(meta.table)} · {meta.action}
                            </span>
                          )}
                          <span className="text-[11px] text-slate-400">•</span>
                          <span className="font-bold text-emerald-800">
                            {entry.actor_role ? `${entry.actor_role} ` : ''}
                            {entry.actor_name}
                            {entry.actor_matric ? ` (${entry.actor_matric})` : ''}
                          </span>
                        </div>
                        <p className="text-slate-700 leading-relaxed break-words">{cleanDetails}</p>
                        {meta && meta.changes.length > 0 && (
                          <div className="mt-1.5 grid sm:grid-cols-2 gap-1.5 pt-1">
                            {meta.changes.map((chg, idx) => (
                              <div
                                key={`${entry.id}-chg-${idx}`}
                                className="flex flex-wrap items-center gap-1.5 bg-amber-50/70 border border-amber-200/80 rounded-lg px-2 py-1 text-[11px]"
                              >
                                <span className="font-extrabold text-slate-700">{chg.field}:</span>
                                <span className="px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 line-through break-all">
                                  {chg.before}
                                </span>
                                <ArrowRight className="w-3 h-3 text-slate-400 shrink-0" />
                                <span className="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold break-all">
                                  {chg.after}
                                </span>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                    <div className="text-[11px] font-mono text-slate-400 shrink-0">{formatLogTime(entry.created_at)}</div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {viewMode === 'edits' && (
        <div className="bg-white/95 backdrop-blur-xl rounded-3xl border border-amber-200/80 overflow-hidden shadow-2xs">
          {filteredEdits.length === 0 ? (
            <div className="p-10 text-center space-y-2 text-xs text-slate-400">
              <History className="w-8 h-8 text-amber-300 mx-auto" />
              <p className="font-bold text-slate-600">No tracked edits recorded yet.</p>
              <p>Whenever anyone edits a claim, fee, equipment item/loan, activity, carpool, ledger entry, or announcement, exact Before → After changes appear here.</p>
            </div>
          ) : (
            <div className="divide-y divide-slate-100">
              {filteredEdits.map((ev) => {
                const { pill } = categoryStyle(ev.category);
                return (
                  <div key={ev.id} className="p-4 hover:bg-amber-50/30 space-y-2 text-xs">
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <div className="flex flex-wrap items-center gap-1.5">
                        <span className={`px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase border ${pill}`}>
                          {tableDisplayLabel(ev.table)}
                        </span>
                        <span className="font-extrabold text-slate-900">{ev.recordTitle}</span>
                        <span className="text-[11px] text-slate-400">•</span>
                        <span className="font-bold text-emerald-800">
                          {ev.actorRole ? `${ev.actorRole} ` : ''}
                          {ev.actorName}
                          {ev.actorMatric ? ` (${ev.actorMatric})` : ''}
                        </span>
                      </div>
                      <span className="text-[11px] font-mono text-slate-400">{formatLogTime(ev.timestamp)}</span>
                    </div>
                    <p className="text-slate-600">{ev.summary}</p>
                    {ev.changes.length > 0 && (
                      <div className="grid sm:grid-cols-2 gap-1.5 pt-1">
                        {ev.changes.map((chg, idx) => (
                          <div
                            key={`${ev.id}-e-${idx}`}
                            className="flex flex-wrap items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-[11px]"
                          >
                            <span className="font-extrabold text-slate-700">{chg.field}:</span>
                            <span className="px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 line-through break-all">
                              {chg.before}
                            </span>
                            <ArrowRight className="w-3 h-3 text-slate-400 shrink-0" />
                            <span className="px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold break-all">
                              {chg.after}
                            </span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {viewMode === 'deleted' && (
        <div className="space-y-3">
          <div className="bg-rose-50 border border-rose-200 rounded-2xl p-3.5 text-xs text-rose-900 flex items-start gap-2.5">
            <Trash2 className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
            <p>
              <strong>Web-Only Soft Delete Archive:</strong> Records deleted in ClubSync are hidden from dashboard tabs, calculations, and lists while their database rows remain stored safely in Supabase (until you manually delete them in Supabase Table Editor). You can restore any item back to the web anytime.
            </p>
          </div>
          <div className="bg-white/95 backdrop-blur-xl rounded-3xl border border-rose-200/80 overflow-hidden shadow-2xs">
            {filteredDeleted.length === 0 ? (
              <div className="p-10 text-center space-y-2 text-xs text-slate-400">
                <Trash2 className="w-8 h-8 text-slate-300 mx-auto" />
                <p className="font-bold text-slate-600">No soft-deleted records right now.</p>
                <p>Items deleted from any module will show up here for traceability and optional restoration.</p>
              </div>
            ) : (
              <div className="divide-y divide-slate-100">
                {filteredDeleted.map((ev) => {
                  const rowKey = `${ev.table}:${ev.recordId}`;
                  const isRestoring = restoringKey === rowKey;
                  const canRestore = Boolean(
                    profile &&
                      (profile.role === 'owner' ||
                        profile.role === 'treasurer' ||
                        (ev.actorMatric && profile.matric_no === ev.actorMatric))
                  );
                  return (
                    <div key={rowKey} className="p-4 flex flex-wrap items-center justify-between gap-3 text-xs hover:bg-rose-50/30">
                      <div className="space-y-1 min-w-0 flex-1">
                        <div className="flex flex-wrap items-center gap-1.5">
                          <span className="px-2 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-rose-100 text-rose-900 border border-rose-200">
                            {tableDisplayLabel(ev.table)}
                          </span>
                          <span className="font-extrabold text-slate-900">{ev.recordTitle}</span>
                          <span className="text-[11px] font-mono text-slate-400">ID: {ev.recordId.slice(0, 8)}</span>
                        </div>
                        <p className="text-slate-600 break-words">
                          Hidden by{' '}
                          <span className="font-bold text-slate-800">
                            {ev.actorRole ? `${ev.actorRole} ` : ''}
                            {ev.actorName}
                            {ev.actorMatric ? ` (${ev.actorMatric})` : ''}
                          </span>{' '}
                          at {formatLogTime(ev.timestamp)}
                        </p>
                      </div>
                      {canRestore && (
                        <button
                          type="button"
                          disabled={isRestoring}
                          onClick={async () => {
                            if (!profile) return;
                            setRestoringKey(rowKey);
                            try {
                              await restoreSoftDeletedRecord({
                                actor: profile,
                                category: (ev.category as ActivityLogCategory) || 'Settings',
                                table: ev.table,
                                recordId: ev.recordId,
                                recordTitle: ev.recordTitle,
                              });
                              onRefresh(`Restored ${tableDisplayLabel(ev.table)} "${ev.recordTitle}" back to web view.`);
                            } finally {
                              setRestoringKey(null);
                            }
                          }}
                          className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold cursor-pointer disabled:opacity-60 shrink-0"
                        >
                          {isRestoring ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <RotateCcw className="w-3.5 h-3.5" />}
                          <span>Restore to Web</span>
                        </button>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/AuditReviewModal.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import {
  supabase,
  Claim,
  Budget,
  UserProfile,
  ActivityLogEntry,
  DEFAULT_DEPARTMENTS,
  MAX_FILE_SIZE_BYTES,
  downloadFileFromUrl,
  logActivity,
} from '@/lib/supabase';
import {
  computeFieldChanges,
  recordEditHistory,
  softDeleteRecord,
  getRecordHistory,
} from '@/lib/history';
import {
  X,
  CheckCircle2,
  XCircle,
  ExternalLink,
  User,
  Phone,
  Hash,
  Loader2,
  FileText,
  Landmark,
  Copy,
  UploadCloud,
  ShieldCheck,
  Clock,
  AlertTriangle,
  Download,
  ZoomIn,
  Sparkles,
  Edit3,
  Trash2,
  History,
  ArrowRight,
} from 'lucide-react';

interface AuditReviewModalProps {
  claim: Claim | null;
  budget: Budget | undefined;
  budgets?: Budget[];
  departments?: string[];
  logs?: ActivityLogEntry[];
  profile: UserProfile;
  /** True only for the club Owner (President / Advisor) acting in Owner mode. */
  isOwner?: boolean;
  /** True when the claimant who submitted this claim is the club Owner. */
  isClaimantOwner?: boolean;
  /** Claims above this RM amount need Treasurer verification + Owner approval. */
  approvalThreshold?: number;
  onClose: () => void;
  onUpdated: (message: string) => void;
}

export default function AuditReviewModal({
  claim,
  budget,
  budgets = [],
  departments = DEFAULT_DEPARTMENTS,
  logs = [],
  profile,
  isOwner = false,
  isClaimantOwner = false,
  approvalThreshold = 200,
  onClose,
  onUpdated,
}: AuditReviewModalProps) {
  const [remarks, setRemarks] = useState('');
  const [payoutFile, setPayoutFile] = useState<File | null>(null);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);
  const [fullImageOpen, setFullImageOpen] = useState(false);
  const [processing, setProcessing] = useState<'Approved' | 'Rejected' | 'ProofOnly' | 'Verified' | null>(
    null
  );

  // Edit & soft-delete state
  const [isEditingClaim, setIsEditingClaim] = useState(false);
  const [editTitle, setEditTitle] = useState('');
  const [editCategory, setEditCategory] = useState('');
  const [editAmount, setEditAmount] = useState('');
  const [editExpenseDate, setEditExpenseDate] = useState('');
  const [editMerchant, setEditMerchant] = useState('');
  const [editBudgetId, setEditBudgetId] = useState<string>('GENERAL');
  const [editPaymentInfo, setEditPaymentInfo] = useState('');
  const [editDescription, setEditDescription] = useState('');
  const [editStatus, setEditStatus] = useState<'Pending' | 'Approved' | 'Rejected'>('Pending');
  const [editReceiptFile, setEditReceiptFile] = useState<File | null>(null);
  const [savingEdit, setSavingEdit] = useState(false);
  const [confirmDeleteClaim, setConfirmDeleteClaim] = useState(false);
  const [deletingClaim, setDeletingClaim] = useState(false);

  useEffect(() => {
    if (claim) {
      setRemarks(
        claim.review_remarks ||
          (claim as unknown as { treasurer_remarks?: string }).treasurer_remarks ||
          ''
      );
      setPayoutFile(null);
      setErrorMsg(null);
      setFullImageOpen(false);
      setIsEditingClaim(false);
      setConfirmDeleteClaim(false);
      setEditTitle(claim.title || '');
      setEditCategory(claim.category || departments[0] || 'Member');
      setEditAmount(String(claim.amount ?? ''));
      setEditExpenseDate(claim.expense_date || '');
      setEditMerchant(claim.merchant_name || '');
      setEditBudgetId(claim.budget_id || 'GENERAL');
      setEditPaymentInfo(claim.payment_info || '');
      setEditDescription(claim.description || '');
      setEditStatus(claim.status || 'Pending');
      setEditReceiptFile(null);
    }
  }, [claim, departments]);

  if (!claim) return null;

  const isTreasurer = profile.role === 'treasurer' || profile.role === 'owner';
  const myLabel = `${profile.full_name} (${profile.matric_no})`;
  const verifiedBy = claim.treasurer_verified_by || '';
  const stage1Done = Boolean(verifiedBy);
  const isOwnClaim = claim.user_id === profile.id;
  const canEditOrDelete = isTreasurer || isOwnClaim;
  const claimHistory = getRecordHistory('claims', claim.id, logs);
  const isOwnerClaim = Boolean(
    isClaimantOwner || (isOwnClaim && (isOwner || profile.role === 'owner'))
  );
  // Owner claims bypass Stage 2 Owner sign-off so Treasurer approval completes them in 1 step.
  const needsTwoStage = Number(claim.amount) > approvalThreshold && !isOwnerClaim;
  const finalBy = claim.final_approved_by || '';
  const isPdf =
    claim.receipt_file_name?.toLowerCase().endsWith('.pdf') ||
    claim.receipt_url?.toLowerCase().split('?')[0].endsWith('.pdf') ||
    claim.receipt_url?.startsWith('data:application/pdf');

  // Extract reimbursement bank info from claim.payment_info or description
  const extractedBankInfo =
    claim.payment_info ||
    (claim.description?.includes('Reimburse To:')
      ? claim.description.split('Reimburse To:')[1]?.trim()
      : '');

  const localProofRaw =
    typeof window !== 'undefined'
      ? localStorage.getItem(`clubsync_claim_proof_${claim.id}`)
      : null;
  let localProof: { url: string; name: string; paid_at: string } | null = null;
  if (localProofRaw) {
    try {
      localProof = JSON.parse(localProofRaw);
    } catch {
      /* ignore */
    }
  }

  const proofUrl = claim.payout_proof_url || localProof?.url || '';
  const proofName = claim.payout_proof_name || localProof?.name || 'Reimbursement_Proof';

  const uploadProofFileIfPresent = async (): Promise<{ url: string; name: string } | null> => {
    if (!payoutFile) return null;
    if (payoutFile.size > MAX_FILE_SIZE_BYTES) {
      throw new Error('Proof file must be under 50 MB.');
    }
    const ext = payoutFile.name.split('.').pop() || 'pdf';
    const path = `reimbursements/${claim.id}-${Date.now()}.${ext}`;
    const { error } = await supabase.storage.from('receipts').upload(path, payoutFile);
    if (error) throw error;
    const publicUrl = supabase.storage.from('receipts').getPublicUrl(path).data.publicUrl;
    if (typeof window !== 'undefined') {
      localStorage.setItem(
        `clubsync_claim_proof_${claim.id}`,
        JSON.stringify({
          url: publicUrl,
          name: payoutFile.name,
          paid_at: new Date().toISOString(),
        })
      );
    }
    return { url: publicUrl, name: payoutFile.name };
  };

  const handleVerifyStage1 = async () => {
    setErrorMsg(null);
    setProcessing('Verified');
    try {
      const nowIso = new Date().toISOString();
      const { error } = await supabase
        .from('claims')
        .update({
          treasurer_verified_by: myLabel,
          treasurer_verified_at: nowIso,
          review_remarks: remarks.trim() || 'Verified by Treasurer — awaiting President/Advisor approval',
        })
        .eq('id', claim.id);
      if (error) {
        setErrorMsg(
          'Could not save the verification. The database needs the latest update — ask the owner to run the new SQL migration in Supabase.'
        );
        return;
      }
      void logActivity(
        profile,
        'Claims',
        'Claim verified (Stage 1)',
        `${myLabel} verified claim "${claim.title}" of RM ${Number(claim.amount).toFixed(2)} by ${claim.claimant_name}. Awaiting President/Advisor approval.`
      );
      void recordEditHistory({
        actor: profile,
        category: 'Claims',
        table: 'claims',
        recordId: claim.id,
        recordTitle: claim.title,
        changes: computeFieldChanges([
          { field: 'Stage 1 Verification', before: claim.treasurer_verified_by || '(pending)', after: myLabel },
        ]),
      });
      onUpdated('Stage 1 done — sent to President / Advisor for final approval.');
      onClose();
    } finally {
      setProcessing(null);
    }
  };

  const handleDecision = async (decision: 'Approved' | 'Rejected') => {
    setErrorMsg(null);
    setProcessing(decision);
    try {
      const uploadedProof = await uploadProofFileIfPresent();
      const nowIso = new Date().toISOString();

      const remarkText =
        remarks.trim() || (decision === 'Approved' ? 'Verified & Reimbursed' : 'Rejected');

      const coreUpdate: Record<string, unknown> = {
        status: decision,
        reviewed_by: myLabel,
        review_remarks: remarkText,
        reviewed_at: nowIso,
      };

      const fullUpdate: Record<string, unknown> = {
        ...coreUpdate,
        ...(decision === 'Approved' &&
        (needsTwoStage || isOwnerClaim || Number(claim.amount) > approvalThreshold)
          ? {
              treasurer_verified_by: claim.treasurer_verified_by || myLabel,
              treasurer_verified_at: claim.treasurer_verified_at || nowIso,
              final_approved_by: myLabel,
              final_approved_at: nowIso,
            }
          : {}),
        ...(uploadedProof
          ? {
              payout_proof_url: uploadedProof.url,
              payout_proof_name: uploadedProof.name,
              paid_at: nowIso,
            }
          : {}),
      };

      const updateCandidates: Record<string, unknown>[] = [
        fullUpdate,
        coreUpdate,
        {
          status: decision,
          treasurer_remarks: remarkText,
          reviewed_by: myLabel,
          reviewed_at: nowIso,
        },
        {
          status: decision,
          reviewed_by: myLabel,
          reviewed_at: nowIso,
        },
      ];

      let lastErr: unknown = null;
      let updated = false;
      for (const payload of updateCandidates) {
        const { error } = await supabase.from('claims').update(payload).eq('id', claim.id);
        if (!error) {
          updated = true;
          break;
        }
        lastErr = error;
      }
      if (!updated) throw lastErr;

      if (decision === 'Approved' && claim.status !== 'Approved' && budget) {
        const newSpent = Number(budget.spent_amount) + Number(claim.amount);
        await supabase
          .from('budgets')
          .update({ spent_amount: newSpent })
          .eq('id', budget.id);
      }
      void logActivity(
        profile,
        'Claims',
        decision === 'Approved'
          ? needsTwoStage
            ? 'Claim final-approved (Stage 2)'
            : 'Claim approved'
          : 'Claim rejected',
        `${myLabel} ${decision === 'Approved' ? 'approved' : 'rejected'} claim "${claim.title}" of RM ${Number(
          claim.amount
        ).toFixed(2)} by ${claim.claimant_name} (${claim.matric_no})` +
          (remarks.trim() ? ` — "${remarks.trim()}"` : '')
      );
      void recordEditHistory({
        actor: profile,
        category: 'Claims',
        table: 'claims',
        recordId: claim.id,
        recordTitle: claim.title,
        changes: computeFieldChanges([
          { field: 'Status', before: claim.status, after: decision },
          { field: 'Review Remarks', before: claim.review_remarks || '', after: remarkText },
        ]),
      });
      onUpdated(`Claim ${decision.toLowerCase()}!`);
      onClose();
    } catch (err: unknown) {
      const msg =
        err instanceof Error
          ? err.message
          : typeof err === 'object' && err !== null && 'message' in err
          ? String((err as { message: unknown }).message)
          : 'Something went wrong. Please try again.';
      setErrorMsg(msg);
    } finally {
      setProcessing(null);
    }
  };

  const handleUploadProofOnly = async () => {
    if (!payoutFile) return;
    setProcessing('ProofOnly');
    try {
      const uploaded = await uploadProofFileIfPresent();
      if (uploaded) {
        const nowIso = new Date().toISOString();
        await supabase
          .from('claims')
          .update({
            payout_proof_url: uploaded.url,
            payout_proof_name: uploaded.name,
            paid_at: nowIso,
          })
          .eq('id', claim.id);
        onUpdated('Proof of reimbursement uploaded!');
        onClose();
      }
    } finally {
      setProcessing(null);
    }
  };

  const handleSaveClaimEdit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!canEditOrDelete) return;
    setErrorMsg(null);
    const nextAmt = parseFloat(editAmount);
    if (!editTitle.trim() || isNaN(nextAmt) || nextAmt <= 0) {
      setErrorMsg('Please provide a valid title and RM amount.');
      return;
    }

    setSavingEdit(true);
    try {
      let nextReceiptUrl = claim.receipt_url;
      let nextReceiptName = claim.receipt_file_name;
      if (editReceiptFile) {
        if (editReceiptFile.size > MAX_FILE_SIZE_BYTES) {
          setErrorMsg('Receipt file must be under 50 MB.');
          return;
        }
        const ext = editReceiptFile.name.split('.').pop() || 'jpg';
        const path = `claims/${claim.user_id}/${Date.now()}.${ext}`;
        const { error: upErr } = await supabase.storage.from('receipts').upload(path, editReceiptFile);
        if (!upErr) {
          nextReceiptUrl = supabase.storage.from('receipts').getPublicUrl(path).data.publicUrl;
          nextReceiptName = editReceiptFile.name;
        } else {
          nextReceiptUrl = await new Promise<string>((resolve, reject) => {
            const r = new FileReader();
            r.onload = () => resolve(String(r.result || ''));
            r.onerror = () => reject(upErr);
            r.readAsDataURL(editReceiptFile);
          });
          nextReceiptName = editReceiptFile.name;
        }
      }

      const nextBudgetId = editBudgetId === 'GENERAL' ? null : editBudgetId;
      const effectiveStatus = isTreasurer ? editStatus : claim.status;

      const coreUpdate: Record<string, unknown> = {
        title: editTitle.trim(),
        category: editCategory.trim() || claim.category,
        amount: nextAmt,
        expense_date: editExpenseDate || claim.expense_date,
        merchant_name: editMerchant.trim() || claim.merchant_name,
        budget_id: nextBudgetId,
        description: editDescription.trim(),
        receipt_url: nextReceiptUrl,
        receipt_file_name: nextReceiptName,
        status: effectiveStatus,
      };
      const fullUpdate: Record<string, unknown> = {
        ...coreUpdate,
        payment_info: editPaymentInfo.trim(),
      };

      let saved = false;
      let lastErr: unknown = null;
      for (const payload of [fullUpdate, coreUpdate]) {
        const { error } = await supabase.from('claims').update(payload).eq('id', claim.id);
        if (!error) {
          saved = true;
          break;
        }
        lastErr = error;
      }
      if (!saved) throw lastErr;

      // Keep budget spent_amount synchronized if amount or status changed for Approved claims
      if (budget && claim.status === 'Approved' && effectiveStatus === 'Approved' && nextAmt !== Number(claim.amount)) {
        const diff = nextAmt - Number(claim.amount);
        await supabase
          .from('budgets')
          .update({ spent_amount: Math.max(0, Number(budget.spent_amount) + diff) })
          .eq('id', budget.id);
      } else if (budget && claim.status === 'Approved' && effectiveStatus !== 'Approved') {
        await supabase
          .from('budgets')
          .update({ spent_amount: Math.max(0, Number(budget.spent_amount) - Number(claim.amount)) })
          .eq('id', budget.id);
      } else if (budget && claim.status !== 'Approved' && effectiveStatus === 'Approved') {
        await supabase
          .from('budgets')
          .update({ spent_amount: Number(budget.spent_amount) + nextAmt })
          .eq('id', budget.id);
      }

      const oldEventName = budgets.find((b) => b.id === claim.budget_id)?.event_name || claim.custom_event_name || 'General Club Expense';
      const newEventName = budgets.find((b) => b.id === nextBudgetId)?.event_name || 'General Club Expense';

      const changes = computeFieldChanges([
        { field: 'Title', before: claim.title, after: editTitle.trim() },
        { field: 'Department', before: claim.category, after: editCategory.trim() || claim.category },
        { field: 'Amount (RM)', before: Number(claim.amount).toFixed(2), after: nextAmt.toFixed(2) },
        { field: 'Expense Date', before: claim.expense_date, after: editExpenseDate || claim.expense_date },
        { field: 'Merchant', before: claim.merchant_name, after: editMerchant.trim() || claim.merchant_name },
        { field: 'Activity / Event', before: oldEventName, after: newEventName },
        { field: 'Bank / DuitNow', before: claim.payment_info || '', after: editPaymentInfo.trim() },
        { field: 'Description', before: claim.description || '', after: editDescription.trim() },
        { field: 'Status', before: claim.status, after: effectiveStatus },
        ...(editReceiptFile ? [{ field: 'Receipt File', before: claim.receipt_file_name, after: nextReceiptName }] : []),
      ]);

      void recordEditHistory({
        actor: profile,
        category: 'Claims',
        table: 'claims',
        recordId: claim.id,
        recordTitle: editTitle.trim(),
        changes,
      });

      setIsEditingClaim(false);
      onUpdated(`Updated claim "${editTitle.trim()}"!`);
      onClose();
    } catch (err: unknown) {
      setErrorMsg(err instanceof Error ? err.message : 'Could not update claim.');
    } finally {
      setSavingEdit(false);
    }
  };

  const handleSoftDeleteClaim = async () => {
    if (!canEditOrDelete) return;
    setDeletingClaim(true);
    try {
      if (claim.status === 'Approved' && budget) {
        await supabase
          .from('budgets')
          .update({ spent_amount: Math.max(0, Number(budget.spent_amount) - Number(claim.amount)) })
          .eq('id', budget.id);
      }
      await softDeleteRecord({
        actor: profile,
        category: 'Claims',
        table: 'claims',
        recordId: claim.id,
        recordTitle: claim.title,
        extraSummary: `RM ${Number(claim.amount).toFixed(2)} by ${claim.claimant_name}`,
      });
      onUpdated(`Removed claim "${claim.title}" from web view (record kept in Supabase).`);
      onClose();
    } finally {
      setDeletingClaim(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-emerald-950/60 backdrop-blur-xs p-4 overflow-y-auto">
      <div className="bg-white rounded-3xl shadow-2xl border border-emerald-200 max-w-3xl w-full overflow-hidden my-8">
        <div className="bg-emerald-800 text-white px-6 py-4 flex items-center justify-between gap-3">
          <div className="min-w-0">
            <span className="text-[11px] uppercase tracking-wider text-amber-300 font-bold">
              Claim Details &amp; Reimbursement Proof
            </span>
            <h2 className="text-base font-bold mt-0.5 truncate">{claim.title}</h2>
          </div>
          <div className="flex items-center gap-2 shrink-0">
            {canEditOrDelete && (
              <>
                <button
                  type="button"
                  onClick={() => setIsEditingClaim((v) => !v)}
                  className={`inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-bold cursor-pointer ${
                    isEditingClaim ? 'bg-amber-400 text-slate-950' : 'bg-white/15 hover:bg-white/25 text-white'
                  }`}
                >
                  <Edit3 className="w-3.5 h-3.5" />
                  <span>{isEditingClaim ? 'Close Edit' : 'Edit'}</span>
                </button>
                <button
                  type="button"
                  onClick={() => setConfirmDeleteClaim((v) => !v)}
                  className="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-rose-600/90 hover:bg-rose-500 text-white text-xs font-bold cursor-pointer"
                  title="Delete from web (kept in Supabase)"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  <span>Delete</span>
                </button>
              </>
            )}
            <button
              type="button"
              onClick={onClose}
              className="text-emerald-200 hover:text-white cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        {confirmDeleteClaim && (
          <div className="bg-rose-50 border-b border-rose-200 px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-xs">
            <div className="text-rose-900 font-semibold">
              Remove &ldquo;{claim.title}&rdquo; from web view? (The row remains stored in Supabase unless manually deleted there.)
            </div>
            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={() => setConfirmDeleteClaim(false)}
                className="px-3 py-1 rounded-lg bg-white border border-slate-200 font-bold text-slate-700 cursor-pointer"
              >
                Cancel
              </button>
              <button
                type="button"
                disabled={deletingClaim}
                onClick={handleSoftDeleteClaim}
                className="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold cursor-pointer"
              >
                {deletingClaim ? 'Removing...' : 'Confirm Remove from Web'}
              </button>
            </div>
          </div>
        )}

        {isEditingClaim ? (
          <form onSubmit={handleSaveClaimEdit} className="p-6 space-y-3 text-xs max-h-[82vh] overflow-y-auto">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Claim Title *</label>
                <input
                  type="text"
                  value={editTitle}
                  onChange={(e) => setEditTitle(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 font-bold"
                  required
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Amount (RM) *</label>
                <input
                  type="number"
                  step="0.01"
                  value={editAmount}
                  onChange={(e) => setEditAmount(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2 font-bold"
                  required
                />
              </div>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Expense Date</label>
                <input
                  type="date"
                  value={editExpenseDate}
                  onChange={(e) => setEditExpenseDate(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2"
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Merchant</label>
                <input
                  type="text"
                  value={editMerchant}
                  onChange={(e) => setEditMerchant(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 px-3 py-2"
                />
              </div>
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Department</label>
                <select
                  value={editCategory}
                  onChange={(e) => setEditCategory(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-semibold"
                >
                  {departments.map((d) => (
                    <option key={d} value={d}>{d}</option>
                  ))}
                </select>
              </div>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className="block font-bold text-emerald-900 mb-1">Related Activity / Event</label>
                <select
                  value={editBudgetId}
                  onChange={(e) => setEditBudgetId(e.target.value)}
                  className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2"
                >
                  <option value="GENERAL">General Club Expense</option>
                  {budgets.map((b) => (
                    <option key={b.id} value={b.id}>{b.event_name}</option>
                  ))}
                </select>
              </div>
              {isTreasurer && (
                <div>
                  <label className="block font-bold text-emerald-900 mb-1">Claim Status</label>
                  <select
                    value={editStatus}
                    onChange={(e) => setEditStatus(e.target.value as 'Pending' | 'Approved' | 'Rejected')}
                    className="w-full rounded-xl border border-emerald-300 bg-white px-3 py-2 font-bold"
                  >
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                  </select>
                </div>
              )}
            </div>
            <div>
              <label className="block font-bold text-emerald-900 mb-1">Bank / DuitNow / TNG Info</label>
              <input
                type="text"
                value={editPaymentInfo}
                onChange={(e) => setEditPaymentInfo(e.target.value)}
                placeholder="Bank Name • Account No (Holder)"
                className="w-full rounded-xl border border-emerald-300 px-3 py-2 font-mono"
              />
            </div>
            <div>
              <label className="block font-bold text-emerald-900 mb-1">Description / Notes</label>
              <textarea
                rows={2}
                value={editDescription}
                onChange={(e) => setEditDescription(e.target.value)}
                className="w-full rounded-xl border border-emerald-300 px-3 py-2"
              />
            </div>
            <div>
              <label className="block font-bold text-emerald-900 mb-1">Replace Receipt File (Optional)</label>
              <input
                type="file"
