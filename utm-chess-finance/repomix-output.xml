  const myPassQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&data=${encodeURIComponent(myPassPayload)}`;
  const venueQrPayload = `CLUBSYNC_QR::v1::${event.id}::${qrToken}`;
