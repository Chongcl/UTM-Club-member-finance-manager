          currentBatch={currentBatch}
          roleMode={roleMode}
          darkMode={isDarkCanvas}
          onToggleDarkMode={toggleDarkMode}
          canCustomizeTheme={effectivePermissions.can_manage_posters_polls}
          onOpenThemeStudio={() => setShowThemeStudio(true)}
